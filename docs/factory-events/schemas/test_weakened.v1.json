{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test_weakened.v1.json",
  "title": "test_weakened",
  "description": "A commit on a merged pull request deleted or weakened a test (removed an assertion, added a skip, .only, --warn-only or || true, or commented an assertion out). Written by callum-flow-merge, one per flagged commit.",
  "x-issue": "required",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch", "pr", "head", "commit", "restored", "kinds", "files"],
  "properties": {
    "branch": { "type": "string", "minLength": 1, "description": "The merged branch.", "x-column": true },
    "pr": { "type": "integer", "minimum": 1, "description": "The merged pull request.", "x-column": true },
    "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "The merged head.", "x-column": true },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "The flagged commit (short sha)." },
    "restored": { "type": "boolean", "description": "true when a later commit on the branch put the test back." },
    "kinds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "What the commit did to the tests, one code each, for example removed-assertion." },
    "files": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "The test files it touched, repo-relative." }
  },
  "examples": [
    { "branch": "issue-72-orchestrator-view", "pr": 97, "head": "9b1e0c4f2a7d", "commit": "3ae20a1", "restored": false, "kinds": ["removed-assertion"], "files": ["tests/web/orchestrators.test.ts"] }
  ]
}
