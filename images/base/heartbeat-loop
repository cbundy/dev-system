DDL_SENT=${HEARTBEAT_DDL_SENT:-0}
STATS_ARGS=()

# mtime FILE...: the newest mtime in epoch seconds, empty when none exists.
newest_mtime() {
  local best='' m f
  for f in "$@"; do
    [ -e "$f" ] || continue
    m=$(stat -c %Y "$f" 2>/dev/null) || continue
    if [ -z "$best" ] || [ "$m" -gt "$best" ]; then best=$m; fi
  done
  printf '%s' "$best"
}

# container_start: ISO time PID 1 started (its start time plus the boot time).
container_start() {
  local stat ticks btime hz
  stat=$(cat /proc/1/stat 2>/dev/null) || return 0
  stat=${stat##*) }
  # fields after the command: state is #1, starttime is #20
  # shellcheck disable=SC2086
  set -- $stat
  ticks=${20:-}
  btime=$(sed -n 's/^btime //p' /proc/stat 2>/dev/null)
  hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
  case "$ticks$btime$hz" in '' | *[!0-9]*) return 0 ;; esac
  date -u -d "@$((btime + ticks / hz))" +%Y-%m-%dT%H:%M:%SZ
}

repo_of() { # owner/name from a git URL, empty when it has none
  printf '%s\n' "$1" | sed -nE 's#.*[:/]([^/:]+)/([^/]+)/?$#\1/\2#p' | sed -E 's#\.git$##' | tr '[:upper:]' '[:lower:]'
}

workers_repo() {
  local url=${DEV_REPO_URL:-}
  # shellcheck disable=SC2119 # the start dir is optional; none means the current one
  [ -n "$url" ] || url=$(git -C "$(workspace)" remote get-url origin 2>/dev/null)
  [ -z "$url" ] || repo_of "$url"
}

# refresh_latest: starts the background lookup when the cache is older than
# LATEST_EVERY. Never waits for it.
refresh_latest() {
  local now try
  now=$(date +%s)
  try=$(stat -c %Y "$LATEST_TRY" 2>/dev/null || echo 0)
  [ $((now - try)) -ge "$LATEST_EVERY" ] || return 0
  flock -n "$LATEST_LOCK" true 2>/dev/null || return 0
  : > "$LATEST_TRY" 2>/dev/null || return 0
  (
    exec 9> "$LATEST_LOCK"
    flock -n 9 || exit 0
    tmp=$(mktemp "$HB_DIR/.dev-heartbeat-latest.XXXXXX") || exit 0
    timeout 120 dev-version --json > "$tmp" 2>/dev/null
    if jq -e 'type == "object" and ([.components[]? | select(.latest != null)] | length > 0)' "$tmp" >/dev/null 2>&1; then
      chmod 644 "$tmp"
      mv -f "$tmp" "$LATEST"
      rm -f "$LATEST_FAIL"
    else
      rm -f "$tmp"
      [ -e "$LATEST_FAIL" ] || : > "$LATEST_FAIL"
    fi
  ) > /dev/null 2>&1 < /dev/null &
}

is_running() { # LOCKFILE: 0 when something holds the lock
  ! flock -n "$1" true 2>/dev/null
}

critical_failures() { # prints a JSON array
  local out='' now age
  is_running "$EVENT_LOCK" || out="$out events_push_not_running"
  is_running "$NM_LOCK" || out="$out nm_push_not_running"
  if ! is_running "$AV_LOCK"; then
    # a watcher of another container sharing the data dir also counts
    if ! { [ -e "$AV_DIR/pg-watch.lock" ] && is_running "$AV_DIR/pg-watch.lock"; }; then
      out="$out agentsview_push_not_running"
    fi
  fi
  if factory_db_url writer > /dev/null 2>&1; then
    is_running "$FACTORY_EVENT_LOCK" || out="$out factory_events_push_not_running"
  fi
  jq -e 'type == "object"' "$VERSIONS_FILE" >/dev/null 2>&1 || out="$out versions_snapshot_missing"
  if [ -e "$LATEST_FAIL" ]; then
    now=$(date +%s)
    age=$((now - $(stat -c %Y "$LATEST_FAIL" 2>/dev/null || echo "$now")))
    [ "$age" -le "$LATEST_FAIL_AFTER" ] || out="$out latest_lookup_failing"
  fi
  # shellcheck disable=SC2086
  jq -nc '$ARGS.positional' --args $out
}

push_json() {
  local ev_w ev_p nm av nmstate fe_w fe_p
  ev_w=$(newest_mtime "$EVENTS_DIR"/*.jsonl)
  ev_p=$(newest_mtime "$EVENTS_DIR"/.pushed/*)
  nmstate="$(nm_push_state_dir 2>/dev/null)/state"
  nm=$(sed -n 's/^last_push=//p' "$nmstate" 2>/dev/null | sed -n 1p)
  case "$nm" in '' | *[!0-9]*) nm='' ;; esac
  av=$(newest_mtime "$AV_DIR/pg-watch.log")
  fe_w=$(newest_mtime "$FACTORY_DIR"/*.jsonl)
  fe_p=$(newest_mtime "$FACTORY_DIR"/.pushed/*)
  jq -nc --arg ew "$ev_w" --arg ep "$ev_p" --arg nm "$nm" --arg av "$av" --arg fw "$fe_w" --arg fp "$fe_p" '
    def t: if . == "" then null else (tonumber | todate) end;
    {events: {last_write: ($ew | t), last_push: ($ep | t)}, nm: {last_push: ($nm | t)}, agentsview: {last_push: ($av | t)},
     factory_events: {last_write: ($fw | t), last_push: ($fp | t)}}'
}

# num FILE: the first word of FILE when it is a non-negative integer, else nothing.
num() {
  local v=''
  { read -r v _ < "$1"; } 2> /dev/null || return 0
  case "$v" in '' | *[!0-9]*) ;; *) printf '%s' "$v" ;; esac
}

# machine_stats SESSIONS_JSON: sets the stats_* variables (empty when unknown) from the cgroup and
# proc directories. Bash builtins and read only: no ps, no pgrep, and never a command line.
machine_stats() {
  local state_json=$1 q p k v d c usage='' prev_usage prev_wall wall_us
  stats_cpu_pct='' stats_cores='' stats_quota_set='' stats_mem_used='' stats_mem_limit=''
  stats_procs='' stats_claude_procs=''
  stats_interactive=$(jq -r '.claude_sessions.interactive // "" | tostring' <<< "$state_json" 2> /dev/null)
  stats_headless=$(jq -r '.claude_sessions.headless // "" | tostring' <<< "$state_json" 2> /dev/null)
  case "$stats_interactive" in *[!0-9]*) stats_interactive='' ;; esac
  case "$stats_headless" in *[!0-9]*) stats_headless='' ;; esac

  if { read -r q p < "$CGROUP_DIR/cpu.max"; } 2> /dev/null; then
    if [ "$q" = max ]; then
      stats_quota_set=false
      stats_cores=$(getconf _NPROCESSORS_ONLN 2> /dev/null)
      case "$stats_cores" in '' | *[!0-9]* | 0) stats_cores='' ;; esac
    else
      case "$q$p" in
        '' | *[!0-9]*) ;;
        *) if [ "$q" -gt 0 ] && [ "$p" -gt 0 ]; then
             stats_quota_set=true
             stats_cores=$(jq -nr --argjson q "$q" --argjson p "$p" '$q / $p')
           fi ;;
      esac
    fi
  fi

  stats_mem_used=$(num "$CGROUP_DIR/memory.current")
  stats_mem_limit=$(num "$CGROUP_DIR/memory.max")

  if { while read -r k v; do
         if [ "$k" = usage_usec ]; then usage=$v; break; fi
       done < "$CGROUP_DIR/cpu.stat"; } 2> /dev/null; then
    case "$usage" in '' | *[!0-9]*) usage='' ;; esac
  fi
  if [ -n "$usage" ]; then
    wall_us=$(($(date +%s%N) / 1000))
    prev_usage='' prev_wall=''
    { read -r prev_usage prev_wall < "$CPUFILE"; } 2> /dev/null || :
    case "$prev_usage$prev_wall" in *[!0-9]*) prev_usage='' prev_wall='' ;; esac
    if [ -n "$prev_usage" ] && [ -n "$prev_wall" ] && [ -n "$stats_cores" ] \
       && [ "$usage" -ge "$prev_usage" ] && [ "$wall_us" -gt "$prev_wall" ]; then
      stats_cpu_pct=$(jq -nr --argjson du "$((usage - prev_usage))" --argjson dw "$((wall_us - prev_wall))" \
        --argjson c "$stats_cores" '$du / ($dw * $c) * 100 * 100 | round / 100')
    fi
    printf '%s %s\n' "$usage" "$wall_us" > "$CPUFILE.tmp" 2> /dev/null && mv -f "$CPUFILE.tmp" "$CPUFILE" 2> /dev/null
  fi

  if [ -d "$PROC_DIR" ]; then
    stats_procs=0 stats_claude_procs=0
    for d in "$PROC_DIR"/[0-9]*; do
      [ -e "$d" ] || continue
      stats_procs=$((stats_procs + 1))
      c=''
      { read -r c < "$d/comm"; } 2> /dev/null || :
      [ "$c" != claude ] || stats_claude_procs=$((stats_claude_procs + 1))
    done
  fi
  # mem.max "max" is not a number, so num left it empty: NULL
  return 0
}

# any_target: 0 when at least one database URL is configured.
any_target() {
  agentsview_pg_url > /dev/null 2>&1 || factory_db_url writer > /dev/null 2>&1
}

# upsert_to LABEL URL WITH_DDL: sends the row (the psql -v arguments in ARGS) to one database,
# the DDL first when WITH_DDL is 1. Logs a failure, masked, naming LABEL. Returns psql's verdict.
upsert_to() {
  local label=$1 url=$2 with_ddl=$3 out
  if ! out=$({ [ "$with_ddl" != 1 ] || printf '%s\n' "$DDL"; printf '%s\n' "$UPSERT"; } | run_psql "$url" "${ARGS[@]}" 2>&1); then
    printf '%s\n' "$out" | mask_secrets >&2
    echo "heartbeat-loop: $label beat failed, retrying next pass" >&2
    return 1
  fi
  [ -z "$out" ] || printf '%s\n' "$out" | mask_secrets >&2
  return 0
}

# stats_to LABEL URL: sends the machine stats (the psql -v arguments in STATS_ARGS) to one database,
# after its UPSERT succeeded. A failure is logged, masked, and never fails the beat. Always returns 0.
stats_to() {
  local label=$1 url=$2 out
  [ "${#STATS_ARGS[@]}" -gt 0 ] || return 0
  if ! out=$(printf '%s\n' "$STATS" | run_psql "$url" "${STATS_ARGS[@]}" 2>&1); then
    printf '%s\n' "$out" | mask_secrets >&2
    echo "heartbeat-loop: $label stats write failed" >&2
    return 0
  fi
  [ -z "$out" ] || printf '%s\n' "$out" | mask_secrets >&2
  return 0
}

# beat: one upsert per configured target, the agentsview database first, then the factory
# database. Returns 0 when every configured target succeeded, 1 when any failed and 2 when
# neither URL is configured.
beat() {
  local av_url='' fdb_url='' av_ok=0 fdb_ok=0 snap latest_json versions state_wait state_json state in_flight chat_at sessions device
  local ok=0 failed=0
  agentsview_pg_url > /dev/null 2>&1 && av_ok=1
  factory_db_url writer > /dev/null 2>&1 && fdb_ok=1
  if [ "$av_ok" = 0 ] && [ "$fdb_ok" = 0 ]; then
    echo "heartbeat-loop: no readable PostgreSQL URL any more (AGENTSVIEW_PG_URL or $(agentsview_pg_url_file); FACTORY_DB_WRITER_URL or $(factory_db_url_file writer)) - stopping" >&2
    return 2
  fi
  [ -n "${HEARTBEAT_STOPPING:-}" ] || timeout 60 dev-version --local --snapshot > /dev/null 2>&1 || true
  snap='{}'
  if jq -e 'type == "object"' "$VERSIONS_FILE" >/dev/null 2>&1; then snap=$(cat "$VERSIONS_FILE"); fi
  [ -n "${HEARTBEAT_STOPPING:-}" ] || refresh_latest
  versions=$snap
  if latest_json=$(jq -ec 'select(type == "object")' "$LATEST" 2>/dev/null); then
    versions=$(jq -c --argjson l "$latest_json" '. + {latest: $l}' <<< "$snap")
  fi
  state_wait=20
  [ -z "${HEARTBEAT_STOPPING:-}" ] || state_wait=2
  state_json=$(timeout "$state_wait" "$SHARE/heartbeat-state" 2>/dev/null) || state_json=''
  jq -e 'type == "object"' <<< "$state_json" >/dev/null 2>&1 || state_json='{"state":"idle","in_flight":[],"chat_active_at":null,"sessions":[],"claude_sessions":null}'
  state=$(jq -r '.state // "idle"' <<< "$state_json")
  [ -z "${HEARTBEAT_STOPPING:-}" ] || state=stopped
  in_flight=$(jq -c '.in_flight // []' <<< "$state_json")
  chat_at=$(jq -r '.chat_active_at // ""' <<< "$state_json")
  sessions=$(jq -c '.sessions // []' <<< "$state_json")
  [ -z "${HEARTBEAT_STOPPING:-}" ] || sessions='[]'
  device=$(jq -r '.device // empty' <<< "$snap")
  [ -n "$device" ] || device=${DEV_MACHINE_NAME:-$(hostname)}
  g() { jq -r --arg k "$1" '.[$k] // ""' <<< "$snap"; }
  ARGS=(-v "device=$device" -v "repo=$(workers_repo)" -v "role=$(g role)" -v "ring=$(g ring)"
    -v "runtime=$(g runtime)" -v "coder_workspace=$(g coder_workspace)" -v "base_image=$(g base_image)"
    -v "dev_image=$(g dev_image)" -v "template_version=$(g template_version)"
    -v "plugin_version=$(g plugin_version)" -v "versions=$versions" -v "state=$state"
    -v "in_flight=$in_flight" -v "chat_active_at=$chat_at" -v "sessions=$sessions" -v "critical_failures=$(critical_failures)"
    -v "push=$(push_json)" -v "interval_s=$INTERVAL" -v "started_at=$(container_start)")
  STATS_ARGS=()
  if [ -z "${HEARTBEAT_STOPPING:-}" ]; then
    machine_stats "$state_json"
    STATS_ARGS=(-v "device=$device" -v "state=$state" -v "cpu_pct=$stats_cpu_pct" -v "cpu_limit_cores=$stats_cores"
      -v "cpu_quota_set=$stats_quota_set" -v "mem_used_bytes=$stats_mem_used" -v "mem_limit_bytes=$stats_mem_limit"
      -v "claude_interactive=$stats_interactive" -v "claude_headless=$stats_headless"
      -v "claude_procs=$stats_claude_procs" -v "procs=$stats_procs")
  fi

  # the targets are independent: a failure on one never skips or delays the other
  if [ "$av_ok" = 1 ]; then
    av_url=$(agentsview_pg_url)
    if upsert_to "agentsview database" "$av_url" "$([ "$DDL_SENT" = 1 ] && echo 0 || echo 1)"; then
      DDL_SENT=1
      ok=1
      stats_to "agentsview database" "$av_url"
    else
      DDL_SENT=0
      failed=1
    fi
  fi
  if [ "$fdb_ok" = 1 ]; then
    fdb_url=$(factory_db_url writer)
    # the writer role cannot run DDL; the database is migrated by factory-db-bootstrap
    if upsert_to "factory database" "$fdb_url" 0; then
      ok=1
      stats_to "factory database" "$fdb_url"
    else
      failed=1
    fi
  fi
  if [ "$ok" = 1 ]; then
    printf 'last_beat=%s\nstate=%s\n' "$(date +%s)" "$state" > "$STATEFILE.tmp" 2>/dev/null \
      && mv -f "$STATEFILE.tmp" "$STATEFILE" 2>/dev/null
  fi
  return "$failed"
}

stopped_beat() { HEARTBEAT_STOPPING=1 HEARTBEAT_DDL_SENT=$DDL_SENT timeout 5 "$SELF" --once; }

case "${1-}" in
  --once)
    beat
    rc=$?
    [ "$rc" -ne 2 ] || rc=1
    exit "$rc"
    ;;
  --final)
    pid=$(cat "$PIDFILE" 2>/dev/null)
    case "$pid" in '' | *[!0-9]*) pid='' ;; esac
    if [ -n "$pid" ] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q heartbeat-loop; then
      kill -TERM "$pid" 2>/dev/null
      i=0
      while [ "$i" -lt 80 ] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
      done
      kill -0 "$pid" 2>/dev/null || exit 0
      echo "heartbeat-loop: the loop did not exit in 8 s - writing the stopped beat here" >&2
    fi
    if any_target; then stopped_beat || true; fi
    exit 0
    ;;
  '') ;;
  *)
    echo "usage: heartbeat-loop [--once | --final]" >&2
    exit 2
    ;;
esac

printf '%s\n' "$$" > "$PIDFILE" 2>/dev/null
cleanup() { [ "$(cat "$PIDFILE" 2>/dev/null)" != "$$" ] || rm -f "$PIDFILE"; }
trap cleanup EXIT
on_stop() {
  trap '' TERM INT HUP
  [ -z "${sleeper:-}" ] || kill "$sleeper" 2>/dev/null
  if any_target; then stopped_beat || true; fi
  exit 0
}
trap on_stop TERM INT HUP
trap ':' USR1

sleeper=''
while :; do
  beat
  [ $? -ne 2 ] || exit 0
  sleep "$INTERVAL" &
  sleeper=$!
  wait "$sleeper"
  kill "$sleeper" 2>/dev/null
  sleeper=''
done
