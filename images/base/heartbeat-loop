#!/bin/bash
#
# heartbeat-loop: every DEV_HEARTBEAT_INTERVAL seconds, upserts this device's
# row in factory.workers (cbundy/dev-system#339), so the fleet can see which workers
# are alive, what they run, whether they are busy, and whether their push loops work.
#
# Two targets, each resolved again on every beat:
#   old  the agentsview PostgreSQL (agentsview.sh: the same secret and rules as
#        event-push-loop). It gets the guarded DDL plus the UPSERT.
#   new  the factory database as its writer role (factory-db.sh: FACTORY_DB_WRITER_URL or
#        factory-db-writer-url). It gets the same UPSERT and never any DDL (the writer role
#        cannot run it; factory-db-bootstrap made the tables), and has no DDL state.
# The row is built once per beat and the same psql -v values go to every target. The targets are
# independent: a failure on one is logged (masked, naming "agentsview database" or "factory
# database") and never skips or delays the other. The old target goes first.
#
# dev-init starts this in the background, under a container-local flock, when either URL is
# configured. Each URL reaches only psql (split into PG* variables in its environment, never its
# argv); all psql output is masked. A target whose URL goes away is skipped; when neither is
# left the loop stops. An unreadable secret counts as not configured.
#
# Row: identity and versions come from `dev-version --local --snapshot`
# ($DEV_VERSIONS_FILE); `versions` is that document plus the cached `latest`
# lookup (`dev-version --json`, which uses the network). The lookup runs in the
# background, at most every 15 minutes, under a lock, and a beat only reads the
# cache. busy / idle, in_flight and sessions (the live Claude sessions and
# sub-agents, with their context window when known) come from heartbeat-state
# (one call per beat).
# last_seen is the database's now(), never this container's clock. Readers use
# the view factory.workers_status (age, stale), never their own rule.
#
# critical_failures is a JSON array of check codes, [] when all is well:
#   events_push_not_running, nm_push_not_running, agentsview_push_not_running
#       (a push loop whose lock is free; the loop is configured because this
#       loop runs only with a URL)
#   factory_events_push_not_running   (the writer URL is configured and the
#       factory-event-push-loop lock is free; never present without the writer URL)
#   versions_snapshot_missing   (no readable snapshot after dev-version)
#   latest_lookup_failing       (the background lookup has failed for over an hour)
# push also carries factory_events: {last_write, last_push}, the newest mtimes of
# $CALLUM_EVENTS_DIR/factory/*.jsonl and factory/.pushed/*.
#
# Machine stats (cbundy/dev-system#543): each running beat also sends a second, separate psql call
# per target, after that target's UPSERT succeeded: an UPDATE of the stats columns of the worker's
# row (and stats_at = the database's now()) plus one INSERT into factory.worker_samples (30 days
# are kept per device by a trigger). It is separate because run_psql is one ON_ERROR_STOP
# transaction: a database not yet migrated (factory-db-bootstrap) would otherwise reject every
# beat. A stats failure is logged, masked, as "<target> stats write failed" and never changes the
# exit code or skips the other target. The stopped beat sends none. Sources, each NULL when its
# file is missing or unreadable (never a guess):
#   cpu_limit_cores, cpu_quota_set   cgroup cpu.max (quota / period); "max" gives the online CPU
#                                    count (getconf _NPROCESSORS_ONLN) and false
#   cpu_pct                          delta(cpu.stat usage_usec) / (delta wall usec * cores) * 100,
#                                    against the previous reading in $DEV_HEARTBEAT_DIR/dev-heartbeat.cpu
#                                    (NULL on the first beat and after a counter reset)
#   mem_used_bytes, mem_limit_bytes  memory.current, memory.max (NULL when "max")
#   claude_interactive, claude_headless  from heartbeat-state's claude_sessions (the session
#                                    registry; NULL when it does not say)
#   claude_procs, procs              processes whose /proc/<pid>/comm is claude, and all of them.
#                                    Never /proc/<pid>/cmdline or environ.
# HEARTBEAT_CGROUP_DIR (default /sys/fs/cgroup) and HEARTBEAT_PROC_DIR (default /proc) are test hooks.
#
# The DDL (old target only; guarded by catalog checks, so a repeat takes no exclusive lock) is
# sent with the first beat of each process and again after a failed beat of that target.
# SIGTERM, SIGINT and SIGHUP write one last beat with state 'stopped' to every configured target
# (bounded by `timeout 5`; it reuses the snapshot and the latest cache with no
# dev-version call, sends the old target's DDL only when this loop has not, and gives
# heartbeat-state 2 s, else an empty in_flight) and exit 0.
# SIGUSR1 beats at once: a test hook, the only way to exercise the in-process
# DDL resend without waiting out the 10 s minimum interval.
#
# Usage: heartbeat-loop [--once | --final]
#   --once   one beat, exit 0 only when every configured target succeeded, else 1 (tests)
#   --final  signal the running loop (pidfile) and wait up to 8 s for it to
#            exit; with no loop running but either URL configured, write the
#            'stopped' beat itself. Always exits 0.
# Environment: DEV_HEARTBEAT_INTERVAL seconds (default 60; an integer of at
#   least 10), DEV_VERSIONS_FILE, DEV_HEARTBEAT_DIR (pid, state and latest
#   cache; default /tmp), CALLUM_EVENTS_DIR, AGENTSVIEW_DATA_DIR.
set -u

SHARE="${DEV_SYSTEM_SHARE:-/usr/local/share/dev-system}"
# shellcheck source=agentsview.sh
. "$SHARE/agentsview.sh"
# shellcheck source=factory-db.sh
. "$SHARE/factory-db.sh"
# shellcheck source=workspace.sh
. "$SHARE/workspace.sh"

HB_DIR="${DEV_HEARTBEAT_DIR:-/tmp}"
PIDFILE="$HB_DIR/dev-heartbeat.pid"
STATEFILE="$HB_DIR/dev-heartbeat.state"
LATEST="$HB_DIR/dev-heartbeat-latest.json"
LATEST_LOCK="$HB_DIR/dev-heartbeat-latest.lock"
LATEST_TRY="$HB_DIR/dev-heartbeat-latest.attempt"
LATEST_FAIL="$HB_DIR/dev-heartbeat-latest.failing"
CPUFILE="$HB_DIR/dev-heartbeat.cpu"
CGROUP_DIR="${HEARTBEAT_CGROUP_DIR:-/sys/fs/cgroup}"
PROC_DIR="${HEARTBEAT_PROC_DIR:-/proc}"
LATEST_EVERY=900
LATEST_FAIL_AFTER=3600
EVENT_LOCK="${HEARTBEAT_EVENT_LOCK:-/tmp/dev-event-push.lock}"
NM_LOCK="${HEARTBEAT_NM_LOCK:-/tmp/dev-nm-push.lock}"
AV_LOCK="${HEARTBEAT_AV_LOCK:-/tmp/dev-agentsview-push.lock}"
FACTORY_EVENT_LOCK="${HEARTBEAT_FACTORY_EVENT_LOCK:-/tmp/dev-factory-event-push.lock}"
EVENTS_DIR="${CALLUM_EVENTS_DIR:-/persist/events}"
FACTORY_DIR="$EVENTS_DIR/factory"
AV_DIR="${AGENTSVIEW_DATA_DIR:-/persist/agentsview}"
VERSIONS_FILE="${DEV_VERSIONS_FILE:-/tmp/dev-versions.json}"
SELF=$(readlink -f -- "$0" 2>/dev/null || echo "$0")

INTERVAL="${DEV_HEARTBEAT_INTERVAL:-60}"
case "$INTERVAL" in
  '' | *[!0-9]*) bad=1 ;;
  *) if [ "$INTERVAL" -lt 10 ]; then bad=1; else bad=0; fi ;;
esac
if [ "$bad" = 1 ]; then
  echo "heartbeat-loop: DEV_HEARTBEAT_INTERVAL='${DEV_HEARTBEAT_INTERVAL:-}' is not an integer of at least 10 - using 60" >&2
  INTERVAL=60
fi

read -r -d '' DDL <<'SQL'
CREATE SCHEMA IF NOT EXISTS factory;
CREATE TABLE IF NOT EXISTS factory.workers (
  device text PRIMARY KEY,
  repo text,
  role text,
  ring text,
  runtime text,
  coder_workspace text,
  base_image text,
  dev_image text,
  template_version text,
  plugin_version text,
  versions jsonb,
  state text,
  in_flight jsonb NOT NULL DEFAULT '[]'::jsonb,
  chat_active_at timestamptz,
  sessions jsonb NOT NULL DEFAULT '[]'::jsonb,
  critical_failures jsonb NOT NULL DEFAULT '[]'::jsonb,
  push jsonb,
  interval_s int,
  started_at timestamptz,
  last_seen timestamptz
);
DO $cols$
DECLARE
  c record;
BEGIN
  FOR c IN SELECT * FROM (VALUES
    ('repo', 'text'), ('role', 'text'), ('ring', 'text'), ('runtime', 'text'), ('coder_workspace', 'text'),
    ('base_image', 'text'), ('dev_image', 'text'), ('template_version', 'text'), ('plugin_version', 'text'),
    ('versions', 'jsonb'), ('state', 'text'), ('in_flight', 'jsonb NOT NULL DEFAULT ''[]''::jsonb'),
    ('chat_active_at', 'timestamptz'), ('sessions', 'jsonb NOT NULL DEFAULT ''[]''::jsonb'), ('critical_failures', 'jsonb NOT NULL DEFAULT ''[]''::jsonb'),
    ('push', 'jsonb'), ('interval_s', 'int'), ('started_at', 'timestamptz'), ('last_seen', 'timestamptz'),
    ('cpu_pct', 'real'), ('cpu_limit_cores', 'numeric'), ('cpu_quota_set', 'boolean'),
    ('mem_used_bytes', 'bigint'), ('mem_limit_bytes', 'bigint'), ('claude_interactive', 'int'),
    ('claude_headless', 'int'), ('claude_procs', 'int'), ('procs', 'int'), ('stats_at', 'timestamptz'),
    ('config', 'jsonb')
  ) AS v(name, type) LOOP
    IF NOT EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid = 'factory.workers'::regclass
                   AND attname = c.name AND NOT attisdropped) THEN
      PERFORM pg_advisory_xact_lock(hashtext('factory.workers migration'));
      EXECUTE format('ALTER TABLE factory.workers ADD COLUMN IF NOT EXISTS %I %s', c.name, c.type);
    END IF;
  END LOOP;
END
$cols$;
DO $view$
BEGIN
  IF (SELECT count(*) FROM pg_attribute WHERE attrelid = to_regclass('factory.workers_status')
        AND attnum > 0 AND NOT attisdropped) IS DISTINCT FROM
     (SELECT count(*) + 2 FROM pg_attribute WHERE attrelid = 'factory.workers'::regclass
        AND attnum > 0 AND NOT attisdropped) THEN
    PERFORM pg_advisory_xact_lock(hashtext('factory.workers view'));
    DROP VIEW IF EXISTS factory.workers_status;
    CREATE VIEW factory.workers_status AS
      SELECT w.*, now() - w.last_seen AS age,
        (now() - w.last_seen) > make_interval(secs => 3 * coalesce(w.interval_s, 60)) AS stale
      FROM factory.workers w;
  END IF;
END
$view$;
DO $notify$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname = 'workers_notify'
                 AND pronamespace = 'factory'::regnamespace) THEN
    PERFORM pg_advisory_xact_lock(hashtext('factory.workers notify'));
    IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname = 'workers_notify'
                   AND pronamespace = 'factory'::regnamespace) THEN
      EXECUTE $fn$
        CREATE FUNCTION factory.workers_notify() RETURNS trigger LANGUAGE plpgsql AS $body$
        BEGIN
          PERFORM pg_notify('factory_workers', NEW.device);
          RETURN NULL;
        END
        $body$
      $fn$;
    END IF;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'workers_notify'
                 AND tgrelid = 'factory.workers'::regclass AND NOT tgisinternal) THEN
    PERFORM pg_advisory_xact_lock(hashtext('factory.workers notify'));
    IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'workers_notify'
                   AND tgrelid = 'factory.workers'::regclass AND NOT tgisinternal) THEN
      CREATE TRIGGER workers_notify AFTER INSERT OR UPDATE ON factory.workers
        FOR EACH ROW EXECUTE FUNCTION factory.workers_notify();
    END IF;
  END IF;
END
$notify$;
DO $samples$
BEGIN
  IF to_regclass('factory.worker_samples') IS NULL THEN
    PERFORM pg_advisory_xact_lock(hashtext('factory.worker_samples'));
    EXECUTE $t$
      CREATE TABLE IF NOT EXISTS factory.worker_samples (
        device text NOT NULL,
        sampled_at timestamptz NOT NULL,
        state text,
        cpu_pct real,
        cpu_limit_cores numeric,
        cpu_quota_set boolean,
        mem_used_bytes bigint,
        mem_limit_bytes bigint,
        claude_interactive int,
        claude_headless int,
        claude_procs int,
        procs int,
        PRIMARY KEY (device, sampled_at)
      )
    $t$;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname = 'worker_samples_prune'
                 AND pronamespace = 'factory'::regnamespace) THEN
    PERFORM pg_advisory_xact_lock(hashtext('factory.worker_samples prune'));
    IF NOT EXISTS (SELECT 1 FROM pg_proc WHERE proname = 'worker_samples_prune'
                   AND pronamespace = 'factory'::regnamespace) THEN
      EXECUTE $fn$
        CREATE FUNCTION factory.worker_samples_prune() RETURNS trigger LANGUAGE plpgsql
          SECURITY DEFINER SET search_path = factory, pg_temp AS $body$
        BEGIN
          DELETE FROM factory.worker_samples
            WHERE device = NEW.device AND sampled_at < NEW.sampled_at - interval '30 days';
          RETURN NULL;
        END
        $body$
      $fn$;
    END IF;
  END IF;
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'worker_samples_prune'
                 AND tgrelid = 'factory.worker_samples'::regclass AND NOT tgisinternal) THEN
    PERFORM pg_advisory_xact_lock(hashtext('factory.worker_samples prune'));
    IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'worker_samples_prune'
                   AND tgrelid = 'factory.worker_samples'::regclass AND NOT tgisinternal) THEN
      CREATE TRIGGER worker_samples_prune AFTER INSERT ON factory.worker_samples
        FOR EACH ROW EXECUTE FUNCTION factory.worker_samples_prune();
    END IF;
  END IF;
END
$samples$;
SQL

