#!/bin/bash
#
# dev-doctor: health check for the dev-system base image.
#
# One line per check, OK or FAIL, with a recovery hint on every FAIL, so
# missing auth or broken persistence shows up at start-up instead of halfway
# through an agent run (cbundy/dev-system#19).
#
# Usage: dev-doctor [--warn-only]
#   Exits 1 if any check fails. --warn-only (used by dev-init) prints the same
#   report but always exits 0. A WARN line (with its own hint) does not fail:
#   it flags something that works now but will be lost, such as tool state
#   with no volume behind it, or a workspace that is not the repo it should
#   be.
set -u

WARN_ONLY=false
case "${1:-}" in
  --warn-only) WARN_ONLY=true ;;
  "") ;;
  *)
    echo "usage: dev-doctor [--warn-only]" >&2
    exit 2
    ;;
esac

FAILURES=0

# Sets DEV_WORKSPACE from DEV_REPO_URL, as dev-init and the supervisor do.
# shellcheck source=workspace.sh
. /usr/local/share/dev-system/workspace.sh
workspace=$(workspace)

ok() {
  printf 'dev-doctor: OK   %s\n' "$1"
}

warn() {
  printf 'dev-doctor: WARN %s\n' "$1"
  printf 'dev-doctor:        fix: %s\n' "$2"
}

fail() {
  printf 'dev-doctor: FAIL %s\n' "$1"
  printf 'dev-doctor:        fix: %s\n' "$2"
  FAILURES=$((FAILURES + 1))
}

# A writable directory still loses its state with the container unless a
# volume is mounted at it or above it (one volume for all of /persist): one
# whose mount point is / lives in the container's own writable layer.
check_persist_dir() {
  local name="$1" dir="$2"
  if [ -d "$dir" ] && [ -w "$dir" ]; then
    if [ "$(stat -c %m "$dir" 2>/dev/null)" = / ]; then
      warn "$name state dir $dir is writable but not on a volume - it is lost when the container is removed" \
        "mount a volume at $dir (devcontainer: npx callum-dev update --devcontainer base-image, or the per-repo mounts in images/base/README.md, \"Extending the image\")"
    else
      ok "$name state dir $dir is writable"
    fi
  else
    fail "$name state dir $dir is missing or not writable by $(id -un) ($(id -u):$(id -g))" \
      "mount a volume at $dir owned by 1000:1000 (k8s: securityContext.fsGroup: 1000)"
  fi
}

check_persist_dir claude "${CLAUDE_CONFIG_DIR:-/persist/claude}"
check_persist_dir codex "${CODEX_HOME:-/persist/codex}"
check_persist_dir gh "${GH_CONFIG_DIR:-/persist/gh}"
check_persist_dir no-mistakes "${NM_HOME:-/persist/no-mistakes}"
check_persist_dir agentsview "${AGENTSVIEW_DATA_DIR:-/persist/agentsview}"

# The shared files mount is optional: not mounted is fine, mounted must work.
shared="${DEV_SHARED_DIR:-/shared}"
if ! mountpoint -q "$shared" 2>/dev/null; then
  ok "$shared not mounted (optional)"
elif [ -w "$shared" ]; then
  ok "$shared mounted and writable"
else
  fail "$shared mounted but not writable by $(id -un) ($(id -u):$(id -g))" \
    "squash all NFS clients to a NAS user that can write the export (Linux exports: all_squash,anonuid=1000,anongid=1000; TrueNAS: Mapall User/Group), or own it by UID 1000 (a Docker volume: chown 1000:1000)"
fi

# Logins: only the tools in DEV_LOGIN_TOOLS (default all three) must be
# logged in; a workspace that never uses codex leaves it out.
login_wanted() {
  case " ${DEV_LOGIN_TOOLS-claude,codex,gh} " in
    *[\ ,]"$1"[\ ,]*) return 0 ;;
  esac
  return 1
}

if [ -n "${DEV_LOGIN_PORT:-}" ]; then
  LOGIN_FIX="open the login page (port $DEV_LOGIN_PORT), or run: dev-login start"
else
  LOGIN_FIX="run: dev-login start"
fi

check_login() {
  local tool="$1" manual="$2"
  shift 2
  if ! command -v "$tool" >/dev/null 2>&1; then
    fail "$tool is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
  elif "$@" >/dev/null 2>&1; then
    ok "$tool is logged in"
  elif ! login_wanted "$tool"; then
    ok "$tool is not logged in (not needed: not in DEV_LOGIN_TOOLS)"
  else
    fail "$tool is not logged in" "$LOGIN_FIX (or: $manual)"
  fi
}

check_login claude "claude auth login" claude auth status
check_login codex "codex login --device-auth" codex login status
check_login gh "gh auth login, then dev-init" gh auth status

if ! command -v no-mistakes >/dev/null 2>&1; then
  fail "no-mistakes is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
else
  ok "no-mistakes is installed"
  if top=$(git -C "$workspace" rev-parse --show-toplevel 2>/dev/null); then
    if [ -f "$top/.no-mistakes.yaml" ]; then
      # Registered means a clean exit AND the repo line; anything else (not
      # initialized, unwritable NM_HOME, a broken database) is a failure.
      if status=$(cd "$top" && no-mistakes status 2>&1) \
        && ! printf '%s\n' "$status" | grep -q "repo not initialized" \
        && printf '%s\n' "$status" | grep -qE '^[[:space:]]*repo:'; then
        ok "no-mistakes: $top is registered"
      else
        fail "no-mistakes: $top is not registered or no-mistakes is broken ($(printf '%s\n' "$status" | head -n 1))" \
          "run: dev-init (or no-mistakes daemon start && no-mistakes init) in $top"
      fi
    fi
  elif [ -e "$workspace/.git" ]; then
    # git refuses repos owned by another user ("dubious ownership"), which
    # hides the workspace from every git-based tool, no-mistakes included.
    fail "git cannot read the repo at $workspace (owned by $(stat -c %U "$workspace" 2>/dev/null), not $(id -un))" \
      "chown -R 1000:1000 the checkout, or run: git config --global --add safe.directory $workspace"
  fi
fi

# The workspace repo (cbundy/dev-system#77). With DEV_REPO_URL set, its
# directory should be a clone of that URL; a .git and a trailing / do not
# count. Without it, a headless container whose workspace is no repo runs
# Claude in a bare directory (no worktrees in server mode, no repo name). A
# desktop dev container (DEV_DESKTOP, from the image metadata) opens the
# checkout it bind-mounts, so it is left out. A repo git cannot read is
# reported above already.
repo_url() {
  local url="${1%/}"
  url="${url%.git}"
  echo "${url%/}"
}

if [ -n "${DEV_REPO_URL:-}" ]; then
  repo="${DEV_WORKSPACE:-}"
  if [ -z "$repo" ]; then
    warn "DEV_REPO_URL ($DEV_REPO_URL) names no directory to clone into" "set DEV_WORKSPACE"
  elif [ -e "$repo/.git" ]; then
    if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
      origin=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
      if [ "$(repo_url "$origin")" = "$(repo_url "$DEV_REPO_URL")" ]; then
        ok "workspace $repo is a clone of $DEV_REPO_URL"
      else
        warn "workspace $repo has origin ${origin:-(none)}, not DEV_REPO_URL ($DEV_REPO_URL)" \
          "point it at the repo (git -C $repo remote set-url origin $DEV_REPO_URL), or set DEV_WORKSPACE to that repo's checkout"
      fi
    fi
  else
    warn "workspace $repo is not cloned from DEV_REPO_URL ($DEV_REPO_URL) yet" \
      "see dev-init's log for why (a private repo waits for gh's login: dev-login start), then run: dev-init --repo"
  fi
elif [ "${DEV_DESKTOP:-0}" != 1 ]; then
  if git -C "$workspace" rev-parse --git-dir >/dev/null 2>&1; then
    ok "workspace $workspace is a git repository"
  elif [ ! -e "$workspace/.git" ]; then
    warn "Claude runs in $workspace, which is not a git repository, and DEV_REPO_URL is not set" \
      "set DEV_REPO_URL to the repo's HTTPS clone URL (dev-init clones it), or DEV_WORKSPACE to a checkout"
  fi
fi

# The Claude plugins the workspace repo enables in its committed
# .claude/settings.json (cbundy/dev-system#112): dev-init installs them, so
# one that is still missing is a WARN with the way to retry - Claude runs
# without it, just without its skills. Checked only when something is
# enabled, so a repo without plugins never runs the CLI here.
if command -v claude >/dev/null 2>&1 && settings=$(repo_settings "$workspace"); then
  if ! wanted=$(enabled_plugins "$settings"); then
    warn "$settings is not valid JSON, so the Claude plugins it enables cannot be installed" \
      "correct it, then run: dev-init --repo"
  elif [ -n "$wanted" ]; then
    if ! installed=$(installed_plugins); then
      warn "cannot list Claude's installed plugins (claude plugin list --json failed), so the ones $settings enables are unchecked" \
        "run: claude plugin list"
    elif missing=$(printf '%s\n' "$wanted" | grep -vxF -f <(printf '%s\n' "$installed")); then
      warn "Claude plugins enabled in $settings are not installed: $(printf '%s\n' "$missing" | paste -sd ' ')" \
        "see dev-init's log for why, then run: dev-init --repo"
    else
      ok "Claude plugins enabled in $settings are installed"
    fi
  fi
fi

if command -v treehouse >/dev/null 2>&1; then
  ok "treehouse is on PATH"
else
  fail "treehouse is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
fi

# agentsview session push: on when a PostgreSQL URL is configured, the
# secret file or AGENTSVIEW_PG_URL (agentsview.sh). Off is a WARN with the way
# to turn it on: every container is meant to push. Only with a URL are the
# database and the push watcher checked, and anything agentsview prints is
# masked, since an error can quote the URL.
# shellcheck source=agentsview.sh
. /usr/local/share/dev-system/agentsview.sh
av_file=$(agentsview_pg_url_file)
av_rc=0
av_url=$(agentsview_pg_url) || av_rc=$?
if ! command -v agentsview >/dev/null 2>&1; then
  fail "agentsview is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
elif [ "$av_rc" -eq 1 ]; then
  warn "agentsview session push is off: no $av_file and no AGENTSVIEW_PG_URL, so this container's sessions do not reach the central agentsview" \
    "put the PostgreSQL URL in $av_file once per Docker host or cluster (images/base/README.md, \"Central session history\"), then restart the container or run: dev-init"
elif [ "$av_rc" -ne 0 ]; then
  fail "agentsview session push is off: $av_file is empty or not readable by $(id -un) ($(id -u):$(id -g))" \
    "make it a non-empty file readable by UID 1000 (chown 1000:1000, chmod 0600; Kubernetes: defaultMode 0440 with fsGroup 1000), then run: dev-init"
else
  if [ -n "${AGENTSVIEW_PG_URL:-}" ]; then av_from=AGENTSVIEW_PG_URL; else av_from=$av_file; fi
  if status=$(AGENTSVIEW_PG_URL="$av_url" timeout 30 agentsview pg status 2>&1); then
    ok "agentsview: central PostgreSQL is reachable (URL from $av_from; $(printf '%s\n' "$status" | grep -m 1 '^Last push:' | tr -s ' ' | mask_secrets))"
  else
    fail "agentsview cannot reach the central PostgreSQL (URL from $av_from: $(printf '%s\n' "$status" | grep -v '^[[:space:]]*$' | tail -n 1 | mask_secrets))" \
      "check the URL (a non-local host needs sslmode=require) and that the database is up"
  fi
  # Held by the push loop in this container, or by the watcher of any
  # container sharing the data dir volume - either way this machine pushes.
  watch_lock="${AGENTSVIEW_DATA_DIR:-/persist/agentsview}/pg-watch.lock"
  if ! flock -n /tmp/dev-agentsview-push.lock true 2>/dev/null \
    || { [ -e "$watch_lock" ] && ! flock -n "$watch_lock" true 2>/dev/null; }; then
    ok "agentsview session push is running"
  else
    fail "agentsview session push is not running" "run: dev-init (log: /tmp/dev-agentsview-push.log)"
  fi
fi
unset av_url

if [ "$FAILURES" -gt 0 ]; then
  printf 'dev-doctor: %d check(s) failed\n' "$FAILURES"
  [ "$WARN_ONLY" = true ] && exit 0
  exit 1
fi
exit 0
