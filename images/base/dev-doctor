#!/bin/bash
#
# dev-doctor: health check for the dev-system base image.
#
# One line per check, OK or FAIL, with a recovery hint on every FAIL, so
# missing auth or broken persistence shows up at start-up instead of halfway
# through an agent run (cbundy/dev-system#19). An INFO line reports state
# that is neither (telemetry export, gh scopes it cannot read) and never fails.
#
# Usage: dev-doctor [--warn-only]
#   Exits 1 if any check fails. --warn-only (used by dev-init) prints the same
#   report but always exits 0. A WARN line (with its own hint) does not fail:
#   it flags something that works now but will be lost, such as tool state
#   with no volume behind it, or a workspace that is not the repo it should
#   be.
set -u

WARN_ONLY=false
case "${1:-}" in
  --warn-only) WARN_ONLY=true ;;
  "") ;;
  *)
    echo "usage: dev-doctor [--warn-only]" >&2
    exit 2
    ;;
esac

FAILURES=0

# Sets DEV_WORKSPACE from DEV_REPO_URL, as dev-init and the supervisor do.
# shellcheck source=workspace.sh
. /usr/local/share/dev-system/workspace.sh
# shellcheck source=plugins.sh
. /usr/local/share/dev-system/plugins.sh
# shellcheck source=persist.sh
. /usr/local/share/dev-system/persist.sh
# shellcheck disable=SC2119 # the argument is optional; none means the default
workspace=$(workspace)

ok() {
  printf 'dev-doctor: OK   %s\n' "$1"
}

warn() {
  printf 'dev-doctor: WARN %s\n' "$1"
  printf 'dev-doctor:        fix: %s\n' "$2"
}

info() {
  printf 'dev-doctor: INFO %s\n' "$1"
}

fail() {
  printf 'dev-doctor: FAIL %s\n' "$1"
  printf 'dev-doctor:        fix: %s\n' "$2"
  FAILURES=$((FAILURES + 1))
}

# A writable directory still loses its state with the container unless a
# volume is mounted at it or above it (one volume for all of /persist): one
# whose mount point is / lives in the container's own writable layer.
# dev-restart-self is exempt: the desktop templates give it no volume.
check_persist_dir() {
  local dir="$1" name
  name=$(basename "$dir")
  if [ -d "$dir" ] && [ -w "$dir" ]; then
    if [ "$(stat -c %m "$dir" 2>/dev/null)" = / ] && persist_dirs --volume | grep -qxF -- "$dir"; then
      warn "$name state dir $dir is writable but not on a volume - it is lost when the container is removed" \
        "mount a volume at $dir (devcontainer: npx callum-dev update --devcontainer base-image, or the per-repo mounts in images/base/README.md, \"Extending the image\")"
    else
      ok "$name state dir $dir is writable"
    fi
  else
    fail "$name state dir $dir is missing or not writable by $(id -un) ($(id -u):$(id -g))" \
      "$(persist_fix_cmd "$dir") (or mount a volume at $dir owned by 1000:1000; k8s: securityContext.fsGroup: 1000); dev-init does this on the next start"
  fi
}

while IFS= read -r _persist_dir; do
  check_persist_dir "$_persist_dir"
done < <(persist_dirs)

# The shared files mount is optional: not mounted is fine, mounted must work.
shared="${DEV_SHARED_DIR:-/shared}"
if ! mountpoint -q "$shared" 2>/dev/null; then
  ok "$shared not mounted (optional)"
elif [ -w "$shared" ]; then
  ok "$shared mounted and writable"
else
  fail "$shared mounted but not writable by $(id -un) ($(id -u):$(id -g))" \
    "squash all NFS clients to a NAS user that can write the export (Linux exports: all_squash,anonuid=1000,anongid=1000; TrueNAS: Mapall User/Group), or own it by UID 1000 (a Docker volume: chown 1000:1000)"
fi

# Logins: only the tools in DEV_LOGIN_TOOLS (default all three) must be
# logged in; a workspace that never uses codex leaves it out.
login_wanted() {
  case " ${DEV_LOGIN_TOOLS-claude,codex,gh} " in
    *[\ ,]"$1"[\ ,]*) return 0 ;;
  esac
  return 1
}

if [ -n "${DEV_LOGIN_PORT:-}" ]; then
  LOGIN_FIX="open the login page (port $DEV_LOGIN_PORT), or run: dev-login start"
else
  LOGIN_FIX="run: dev-login start"
fi

check_login() {
  local tool="$1" manual="$2"
  shift 2
  if ! command -v "$tool" >/dev/null 2>&1; then
    fail "$tool is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
  elif "$@" >/dev/null 2>&1; then
    ok "$tool is logged in"
  elif ! login_wanted "$tool"; then
    ok "$tool is not logged in (not needed: not in DEV_LOGIN_TOOLS)"
  else
    fail "$tool is not logged in" "$LOGIN_FIX (or: $manual)"
  fi
}

# shellcheck source=claude-auth.sh
. /usr/local/share/dev-system/claude-auth.sh
if claude_api_key_mode; then
  claude_api_key_doctor
else
  info "Claude auth mode: $(claude auth status --json 2>/dev/null | jq -r 'if .loggedIn == true then .authMethod else "none" end' 2>/dev/null | grep . || echo none)"
  check_login claude "claude auth login" claude auth status
fi
check_login codex "codex login --device-auth" codex login status
check_login gh "gh auth login, then dev-init" gh auth status

# gh's token needs the workflow scope to push a change under
# .github/workflows/ (cbundy/dev-system#181). A WARN, since everything else
# works without it; scopes that cannot be read (offline, a fine-grained
# token) are only information.
# shellcheck source=gh.sh
. /usr/local/share/dev-system/gh.sh
if command -v gh >/dev/null 2>&1 && ! gh_token_mode; then
  case "$(gh_workflow_scope)" in
    yes) ok "gh's token has the workflow scope" ;;
    no)
      if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]; then
        scope_fix="give the GH_TOKEN / GITHUB_TOKEN token the workflow scope (on Coder: add workflow to the GitHub external auth's scopes)"
      elif login_wanted gh; then
        scope_fix="$LOGIN_FIX (or: gh auth refresh -h github.com -s workflow)"
      else
        scope_fix="run: gh auth refresh -h github.com -s workflow"
      fi
      warn "gh's token lacks the workflow scope, so pushing a change under .github/workflows/ is refused" "$scope_fix"
      ;;
    unknown)
      if gh auth status >/dev/null 2>&1; then
        info "gh's token scopes could not be read (offline, or a token without OAuth scopes), so the workflow scope is unchecked"
      fi
      ;;
  esac
fi

if ! command -v no-mistakes >/dev/null 2>&1; then
  fail "no-mistakes is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
else
  ok "no-mistakes is installed"
  # The managed block's agents, models and review roles (dev-init writes it),
  # read from the global config the daemon uses.
  nm_cfg="${NO_MISTAKES_HOME:-${NM_HOME:-/persist/no-mistakes}}/config.yaml"
  if [ -r "$nm_cfg" ] && grep -q '^# BEGIN dev-system managed' "$nm_cfg"; then
    nm_block=$(sed -n '/^# BEGIN dev-system managed/,/^# END dev-system managed$/p' "$nm_cfg")
    nm_agents=$(printf '%s\n' "$nm_block" | sed -n 's/^agent: \[\(.*\)\]$/\1/p' | sed 's/, /,/g')
    # The first value of KEY under the top-level key "$1", optionally under its
    # sub-key "$2" (a harness or a role).
    nm_val() {
      printf '%s\n' "$nm_block" | awk -v top="$1" -v sub1="$2" -v key="$3" '
        /^[^ #]/ { in_top = ($0 == top ":"); in_sub = 0; next }
        in_top && /^  [^ ]/ { in_sub = ($0 == "  " sub1 ":"); next }
        in_top && in_sub && $1 == key ":" { print $2; exit }'
    }
    nm_codex=$(nm_val agent_config codex model)
    nm_claude=$(nm_val agent_config claude model)
    nm_claude_eff=$(nm_val agent_config claude effort)
    nm_rev_agent=$(nm_val review_agents reviewer agent)
    nm_rev_model=$(nm_val review_agents reviewer model)
    nm_rev_eff=$(nm_val review_agents reviewer effort)
    nm_summary="agents ${nm_agents:-not set}; "
    if [ -n "$nm_codex" ]; then
      nm_summary="${nm_summary}codex ${nm_codex}${nm_claude:+, claude $nm_claude}${nm_claude_eff:+ ($nm_claude_eff)}; "
    else
      nm_summary="${nm_summary}no model pin; "
    fi
    if [ -n "$nm_rev_agent" ]; then
      nm_summary="${nm_summary}review ${nm_rev_agent}${nm_rev_model:+ $nm_rev_model}${nm_rev_eff:+ ($nm_rev_eff)}, no fallback"
    else
      nm_summary="${nm_summary}no review roles"
    fi
    info "no-mistakes managed block: $nm_summary"
    # A review agent that is not installed fails every gate at review: it has no fallback.
    if [ -n "$nm_rev_agent" ] && ! command -v "$nm_rev_agent" >/dev/null 2>&1; then
      warn "the review agent '$nm_rev_agent' is not on PATH, so every no-mistakes gate will fail at review (the review roles have no fallback)" \
        "install $nm_rev_agent, or set DEV_REVIEW_AGENT to an installed agent (empty drops the review roles)"
    fi
  fi
  if top=$(git -C "$workspace" rev-parse --show-toplevel 2>/dev/null); then
    if [ -f "$top/.no-mistakes.yaml" ]; then
      # Registered means a clean exit AND the repo line; anything else (not
      # initialized, unwritable NM_HOME, a broken database) is a failure.
      if status=$(cd "$top" && no-mistakes status 2>&1) \
        && ! printf '%s\n' "$status" | grep -q "repo not initialized" \
        && printf '%s\n' "$status" | grep -qE '^[[:space:]]*repo:'; then
        ok "no-mistakes: $top is registered"
      else
        fail "no-mistakes: $top is not registered or no-mistakes is broken ($(printf '%s\n' "$status" | head -n 1))" \
          "run: dev-init (or no-mistakes daemon start && no-mistakes init) in $top"
      fi
    fi
  elif [ -e "$workspace/.git" ]; then
    # git refuses repos owned by another user ("dubious ownership"), which
    # hides the workspace from every git-based tool, no-mistakes included.
    fail "git cannot read the repo at $workspace (owned by $(stat -c %U "$workspace" 2>/dev/null), not $(id -un))" \
      "chown -R 1000:1000 the checkout, or run: git config --global --add safe.directory $workspace"
  fi
fi

# The workspace repo (cbundy/dev-system#77). With DEV_REPO_URL set, its
# directory should be a clone of that URL; a .git and a trailing / do not
# count. Without it, a headless container whose workspace is no repo runs
# Claude in a bare directory (no worktrees in server mode, no repo name). A
# desktop dev container (DEV_DESKTOP, from the image metadata) opens the
# checkout it bind-mounts, so it is left out. A repo git cannot read is
# reported above already.
repo_url() {
  local url="${1%/}"
  url="${url%.git}"
  echo "${url%/}"
}

if [ -n "${DEV_REPO_URL:-}" ]; then
  repo="${DEV_WORKSPACE:-}"
  if [ -z "$repo" ]; then
    warn "DEV_REPO_URL ($DEV_REPO_URL) names no directory to clone into" "set DEV_WORKSPACE"
  elif [ -e "$repo/.git" ]; then
    if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
      origin=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
      if [ "$(repo_url "$origin")" = "$(repo_url "$DEV_REPO_URL")" ]; then
        ok "workspace $repo is a clone of $DEV_REPO_URL"
      else
        warn "workspace $repo has origin ${origin:-(none)}, not DEV_REPO_URL ($DEV_REPO_URL)" \
          "point it at the repo (git -C $repo remote set-url origin $DEV_REPO_URL), or set DEV_WORKSPACE to that repo's checkout"
      fi
    fi
  else
    warn "workspace $repo is not cloned from DEV_REPO_URL ($DEV_REPO_URL) yet" \
      "see dev-init's log for why (a private repo waits for gh's login: dev-login start), then run: dev-init --repo"
  fi
elif [ "${DEV_DESKTOP:-0}" != 1 ]; then
  if git -C "$workspace" rev-parse --git-dir >/dev/null 2>&1; then
    ok "workspace $workspace is a git repository"
  elif [ ! -e "$workspace/.git" ]; then
    warn "Claude runs in $workspace, which is not a git repository, and DEV_REPO_URL is not set" \
      "set DEV_REPO_URL to the repo's HTTPS clone URL (dev-init clones it), or DEV_WORKSPACE to a checkout"
  fi
fi

# Stale Claude Code bridge worktrees (dev-prune-worktrees, cbundy/dev-system#93):
# silent when the workspace has none.
if command -v dev-prune-worktrees >/dev/null 2>&1 && [ -d "$workspace/.claude/worktrees" ] \
  && ls -d "$workspace"/.claude/worktrees/bridge-* >/dev/null 2>&1; then
  stale=$(dev-prune-worktrees --count --workspace "$workspace" 2>/dev/null || echo 0)
  if [ "${stale:-0}" -gt 0 ]; then
    warn "$stale stale bridge worktree(s) in $workspace/.claude/worktrees (orphaned, clean, pushed, idle 72h+)" \
      "run: dev-prune-worktrees --delete (dev-remote-control does this at every server-mode start)"
  else
    ok "no stale bridge worktrees in $workspace/.claude/worktrees"
  fi
fi

# The Claude plugins dev-init installs (plugins.sh): the ones the workspace
# repo enables in its committed .claude/settings.json (cbundy/dev-system#112)
# and the image's default plugins (DEV_DEFAULT_PLUGINS, #148).
# One that is still missing is a WARN with the way to retry (a FAIL with
# DEV_DEFAULT_PLUGIN_REFS_WIN=1, where the template owns the plugins; there a
# wanted marketplace installed at another ref than wanted is a FAIL too, a WARN
# otherwise) -
# Claude runs without it, just without its skills. The CLI runs only when
# something is wanted, so with no repo plugins and DEV_DEFAULT_PLUGINS empty
# nothing is checked.
if command -v claude >/dev/null 2>&1; then
  settings="" wanted="" installed=""
  if settings=$(repo_settings "$workspace"); then
    if ! wanted=$(enabled_plugins "$settings"); then
      warn "$settings is not valid JSON, so the Claude plugins it enables cannot be installed" \
        "correct it, then run: dev-init --repo"
      wanted=""
    fi
  else
    settings=""
  fi
  while IFS= read -r bad; do
    [ -z "$bad" ] || warn "DEV_DEFAULT_PLUGINS entry \"$bad\" is not <plugin>@<marketplace>=<marketplace source>, so it is not installed" \
      "correct DEV_DEFAULT_PLUGINS in the image or the runtime's environment"
  done < <(invalid_default_plugins)
  defaults=$(wanted_default_plugins "$settings")
  wanted=$(not_installed "$wanted" "$(printf '%s\n' "$defaults" | cut -d' ' -f1)") || wanted=""
  if [ -n "$wanted$defaults" ] && ! installed=$(installed_plugins); then
    warn "cannot list Claude's installed plugins (claude plugin list --json failed), so the default and repo plugins are unchecked" \
      "run: claude plugin list"
  else
    if [ -n "$wanted" ]; then
      if absent=$(not_installed "$wanted" "$installed"); then
        warn "Claude plugins enabled in $settings are not installed: $(printf '%s\n' "$absent" | paste -sd ' ')" \
          "see dev-init's log for why, then run: dev-init --repo"
      else
        ok "Claude plugins enabled in $settings are installed"
      fi
    fi
    level=warn
    [ "${DEV_DEFAULT_PLUGIN_REFS_WIN:-}" != 1 ] || level=fail
    if [ -n "$defaults" ]; then
      if absent=$(not_installed "$defaults" "$installed"); then
        $level "default Claude plugins (DEV_DEFAULT_PLUGINS) are not installed: $(printf '%s\n' "$absent" | cut -d' ' -f1 | paste -sd ' ')" \
          "run: dev-init --plugins (or by hand: $(default_plugin_fix "$absent")), then start a new Claude session"
      else
        ok "default Claude plugins are installed: $(printf '%s\n' "$defaults" | cut -d' ' -f1 | paste -sd ' ')"
      fi
    fi
    # The marketplaces of every default, also one the repo took over: the
    # template owns their ref too (DEV_DEFAULT_PLUGIN_REFS_WIN=1).
    if [ -n "$wanted$defaults" ] && mlist=$(CLAUDE_PLUGIN_LIMIT=30 claude_plugin_cli marketplace list --json 2>/dev/null) && [ -n "$mlist" ]; then
      while read -r mkt src; do
        [ -n "$src" ] || continue
        want_ref=""
        [[ "$src" != *#* ]] || want_ref="${src#*#}"
        # An entry at another location is the repo's own business: skipped.
        have=$(printf '%s\n' "$mlist" | jq -r --arg m "$mkt" --arg l "${src%%#*}" '.[] | select(.name == $m and (.repo // .url) == $l) | .ref // ""' 2>/dev/null | head -n1)
        printf '%s\n' "$mlist" | jq -e --arg m "$mkt" --arg l "${src%%#*}" 'any(.[]; .name == $m and (.repo // .url) == $l)' >/dev/null 2>&1 || continue
        [ "$have" != "$want_ref" ] || continue
        $level "Claude plugin marketplace $mkt is installed at ${have:-no ref}, but ${want_ref:-no ref} is wanted" \
          "run: dev-init --plugins, then start a new Claude session"
      done < <(wanted_marketplaces "$settings" "" "$(default_plugins)")
    fi
  fi
fi

if command -v treehouse >/dev/null 2>&1; then
  ok "treehouse is on PATH"
else
  fail "treehouse is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
fi

if command -v uv >/dev/null 2>&1; then
  ok "uv is on PATH"
else
  fail "uv is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
fi

# agentsview session push: on when a PostgreSQL URL is configured, the
# secret file or AGENTSVIEW_PG_URL (agentsview.sh). Off is a WARN with the way
# to turn it on: every container is meant to push. Only with a URL are the
# database and the push watcher checked, and anything agentsview prints is
# masked, since an error can quote the URL.
# shellcheck source=agentsview.sh
. /usr/local/share/dev-system/agentsview.sh
av_file=$(agentsview_pg_url_file)
av_rc=0
av_url=$(agentsview_pg_url) || av_rc=$?
if ! command -v agentsview >/dev/null 2>&1; then
  fail "agentsview is not on PATH" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
elif [ "$av_rc" -eq 1 ]; then
  warn "agentsview session push is off: no $av_file and no AGENTSVIEW_PG_URL, so this container's sessions do not reach the central agentsview" \
    "put the PostgreSQL URL in $av_file once per Docker host or cluster (images/base/README.md, \"Central session history\"), then restart the container or run: dev-init"
elif [ "$av_rc" -ne 0 ]; then
  fail "agentsview session push is off: $av_file is empty or not readable by $(id -un) ($(id -u):$(id -g))" \
    "make it a non-empty file readable by UID 1000 (chown 1000:1000, chmod 0600; Kubernetes: defaultMode 0440 with fsGroup 1000), then run: dev-init"
else
  if [ -n "${AGENTSVIEW_PG_URL:-}" ]; then av_from=AGENTSVIEW_PG_URL; else av_from=$av_file; fi
  if status=$(AGENTSVIEW_PG_URL="$av_url" timeout 30 agentsview pg status 2>&1); then
    ok "agentsview: central PostgreSQL is reachable (URL from $av_from; $(printf '%s\n' "$status" | grep -m 1 '^Last push:' | tr -s ' ' | mask_secrets))"
  else
    fail "agentsview cannot reach the central PostgreSQL (URL from $av_from: $(printf '%s\n' "$status" | grep -v '^[[:space:]]*$' | tail -n 1 | mask_secrets))" \
      "check the URL (a non-local host needs sslmode=require) and that the database is up"
  fi
  # Held by the push loop in this container, or by the watcher of any
  # container sharing the data dir volume - either way this machine pushes.
  watch_lock="${AGENTSVIEW_DATA_DIR:-/persist/agentsview}/pg-watch.lock"
  if ! flock -n /tmp/dev-agentsview-push.lock true 2>/dev/null \
    || { [ -e "$watch_lock" ] && ! flock -n "$watch_lock" true 2>/dev/null; }; then
    ok "agentsview session push is running"
  else
    fail "agentsview session push is not running" "run: dev-init (log: /tmp/dev-agentsview-push.log)"
  fi
fi
unset av_url

# Factory database (cbundy/dev-system#647): per role, the secret and the database behind it.
# The check logic is factory_db_check in factory-db.sh; this only maps its result onto the
# report. Not configured is a WARN while nothing uses the database.
# shellcheck source=factory-db.sh
. /usr/local/share/dev-system/factory-db.sh
for fdb_role in writer reader; do
  fdb_rc=0
  fdb_out=$(factory_db_check "$fdb_role") || fdb_rc=$?
  fdb_msg=$(printf '%s\n' "$fdb_out" | sed -n '1s/^[A-Z]* *//p')
  fdb_fix=$(printf '%s\n' "$fdb_out" | sed -n '2s/^fix: //p')
  case "$fdb_rc" in
    0) ok "$fdb_msg" ;;
    1) warn "$fdb_msg" "$fdb_fix" ;;
    *) fail "$fdb_msg" "$fdb_fix" ;;
  esac
done
unset fdb_role fdb_rc fdb_out fdb_msg fdb_fix

# Evidence storage (cbundy/dev-system#914): the workspace repo's container and SAS pair, checked
# by callum-flow-evidence-upload --check in the checkout. Not configured is a WARN; a setup that
# is wrong (an account SAS, a wrong scope, a missing file) is a FAIL with the tool's message.
if [ -f "$workspace/.callum-dev/evidence-off" ]; then
  info "evidence collection is off for this repo (.callum-dev/evidence-off)"
elif command -v callum-flow-evidence-upload >/dev/null 2>&1 \
  && git -C "$workspace" remote get-url origin >/dev/null 2>&1; then
  evs_rc=0
  evs_out=$(cd "$workspace" && callum-flow-evidence-upload --check 2>&1) || evs_rc=$?
  evs_msg=$(printf '%s\n' "$evs_out" | sed -n '1s/^callum-flow-evidence-upload: //p')
  case "$evs_rc" in
    0) ok "evidence storage: ${evs_msg#OK }" ;;
    78) warn "evidence storage is not configured for this repo" \
      "see docs/evidence-storage.md (${evs_msg})" ;;
    *) fail "evidence storage: $evs_msg" "see docs/evidence-storage.md" ;;
  esac
  unset evs_rc evs_out evs_msg
  # UI capture policy (same rules and wording as `callum-dev check`): a repo that runs the
  # factory loop and needs UI evidence sets uiCapture in .claude/factory-loop.json.
  uic_file="$workspace/.claude/factory-loop.json"
  if [ -f "$uic_file" ]; then
    uic_claude=$(tr '\n' ' ' <"$workspace/CLAUDE.md" 2>/dev/null |
      sed -n 's/.*e2e visual verification tooling (\([^)]*\)).*/\1/p' |
      sed 's/^ *//; s/ *$//' | tr '[:upper:]' '[:lower:]')
    if [ "$uic_claude" = "n/a - no ui" ]; then
      info "UI capture: not required (CLAUDE.md says n/a - no UI)"
    else
      uic_fix="set \"uiCapture\" in .claude/factory-loop.json to the repo's capture command, or to \"none\" when the repo has no capture tooling; or, to turn evidence collection off completely, create .callum-dev/evidence-off"
      if ! jq -e . "$uic_file" >/dev/null 2>&1; then
        fail "UI capture: .claude/factory-loop.json is not valid JSON" "$uic_fix"
      else
        uic_type=$(jq -r '.uiCapture | type' "$uic_file")
        uic_val=$(jq -r '.uiCapture | strings' "$uic_file")
        uic_trim=$(printf '%s' "$uic_val" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        if [ "$uic_type" = "null" ]; then
          fail "UI capture: \"uiCapture\" is not set in .claude/factory-loop.json" "$uic_fix"
        elif [ "$uic_type" != "string" ] || [ -z "$uic_trim" ]; then
          fail "UI capture: \"uiCapture\" in .claude/factory-loop.json is not a non-empty string" "$uic_fix"
        else
          uic_npm=$(printf '%s' "$uic_trim" | sed -n 's/^npm run \([^[:space:]]\{1,\}\).*/\1/p')
          if [ -n "$uic_npm" ] &&
            ! jq -e --arg n "$uic_npm" '.scripts[$n] | strings' "$workspace/package.json" >/dev/null 2>&1; then
            fail "UI capture: \"uiCapture\" runs npm script \"$uic_npm\", which package.json does not define" "$uic_fix"
          else
            ok "UI capture: $uic_trim"
          fi
        fi
      fi
    fi
  fi
  unset uic_file uic_claude uic_fix uic_type uic_val uic_trim uic_npm
else
  info "evidence storage: no workspace checkout with an origin remote, not checked"
fi

# The old factory event log (cbundy/dev-system#218): when it was last written and last
# pushed, and how many lines still wait. Information only, and history: callum-flow-event
# writes no new lines to it (cbundy/dev-system#1143) and dev-init no longer starts its push
# loop, so a count that waits does not mean anything is wrong. The one failure here is a
# configured database with no psql to push the new log with.
ev_dir="${CALLUM_EVENTS_DIR:-/persist/events}"
ev_lines=0
ev_pushed=0
ev_waiting=0
ev_last_written=0
ev_last_pushed=0
for ev_f in "$ev_dir"/*.jsonl; do
  [ -f "$ev_f" ] || continue
  ev_n=$(wc -l < "$ev_f" | tr -d ' ')
  ev_p=$(cat "$ev_dir/.pushed/$(basename "$ev_f")" 2>/dev/null || echo 0)
  case "$ev_p" in '' | *[!0-9]*) ev_p=0 ;; esac
  ev_lines=$((ev_lines + ev_n))
  ev_pushed=$((ev_pushed + ev_p))
  if [ "$ev_p" -gt "$ev_n" ]; then
    warn "event log $ev_f has $ev_n lines but $ev_p were pushed - the file was replaced under the push loop" \
      "nothing to do: event-push-loop pushes it again from the start (rows with an event_id dedup)"
  else
    ev_waiting=$((ev_waiting + ev_n - ev_p))
  fi
  ev_m=$(stat -c %Y "$ev_f" 2>/dev/null || echo 0)
  [ "$ev_m" -le "$ev_last_written" ] || ev_last_written=$ev_m
  ev_m=$(stat -c %Y "$ev_dir/.pushed/$(basename "$ev_f")" 2>/dev/null || echo 0)
  [ "$ev_m" -le "$ev_last_pushed" ] || ev_last_pushed=$ev_m
done
ev_when() { if [ "$1" -gt 0 ]; then date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; else echo never; fi; }
info "old factory event log (gets no new lines): $ev_lines recorded (last written $(ev_when "$ev_last_written")), $ev_pushed pushed (last pushed $(ev_when "$ev_last_pushed")), $ev_waiting waiting"
if [ "$av_rc" -eq 0 ]; then
  if ! command -v psql >/dev/null 2>&1; then
    fail "psql is not on PATH, so factory events cannot be pushed" "the image is broken - pull a fresh ghcr.io/cbundy/dev-system/base"
  fi
fi

# Factory event log, new format (cbundy/dev-system#740): the same counts over
# factory/*.jsonl, with the lines the database refused (factory/.refused/) set aside.
nl_dir="$ev_dir/factory"
nl_lines=0
nl_pushed=0
nl_waiting=0
nl_refused=0
nl_last_written=0
nl_last_pushed=0
for nl_f in "$nl_dir"/*.jsonl; do
  [ -f "$nl_f" ] || continue
  nl_b=$(basename "$nl_f")
  nl_n=$(wc -l < "$nl_f" | tr -d ' ')
  nl_p=$(cat "$nl_dir/.pushed/$nl_b" 2>/dev/null || echo 0)
  case "$nl_p" in '' | *[!0-9]*) nl_p=0 ;; esac
  nl_lines=$((nl_lines + nl_n))
  nl_pushed=$((nl_pushed + nl_p))
  if [ "$nl_p" -gt "$nl_n" ]; then
    warn "event log $nl_f has $nl_n lines but $nl_p were pushed - the file was replaced under the push loop" \
      "nothing to do: factory-event-push-loop pushes it again from the start (rows with an event_id dedup)"
  else
    nl_waiting=$((nl_waiting + nl_n - nl_p))
  fi
  if [ -s "$nl_dir/.refused/$nl_b" ]; then
    nl_r=$(wc -l < "$nl_dir/.refused/$nl_b" | tr -d ' ')
    nl_refused=$((nl_refused + nl_r))
    warn "$nl_r line(s) of $nl_f were refused by the database and set aside in $nl_dir/.refused/$nl_b" \
      "read $nl_dir/.refused/$nl_b (line, error, text); the lines stay set aside"
  fi
  nl_m=$(stat -c %Y "$nl_f" 2>/dev/null || echo 0)
  [ "$nl_m" -le "$nl_last_written" ] || nl_last_written=$nl_m
  nl_m=$(stat -c %Y "$nl_dir/.pushed/$nl_b" 2>/dev/null || echo 0)
  [ "$nl_m" -le "$nl_last_pushed" ] || nl_last_pushed=$nl_m
done
info "factory events (new log): $nl_lines recorded (last written $(ev_when "$nl_last_written")), $nl_pushed pushed (last pushed $(ev_when "$nl_last_pushed")), $nl_waiting waiting, $nl_refused set aside"
if factory_db_url writer >/dev/null 2>&1 && flock -n /tmp/dev-factory-event-push.lock true 2>/dev/null; then
  fail "factory event push (new log) is not running" "run: dev-init (log: /tmp/dev-factory-event-push.log)"
fi

# Worker heartbeat (cbundy/dev-system#339): when the last beat was written and
# the state it reported. A configured URL (either database) whose loop is not running is a failure.
hb_state=/tmp/dev-heartbeat.state
hb_last=$(sed -n 's/^last_beat=//p' "$hb_state" 2>/dev/null | sed -n 1p)
hb_st=$(sed -n 's/^state=//p' "$hb_state" 2>/dev/null | sed -n 1p)
case "$hb_last" in '' | *[!0-9]*) hb_when=never ;; *) hb_when=$(date -u -d "@$hb_last" +%Y-%m-%dT%H:%M:%SZ) ;; esac
info "worker heartbeat: last beat $hb_when, state ${hb_st:-unknown}"
if { [ "$av_rc" -eq 0 ] || factory_db_url writer >/dev/null 2>&1; } && flock -n /tmp/dev-heartbeat.lock true 2>/dev/null; then
  fail "heartbeat is not running" "run: dev-init (log: /tmp/dev-heartbeat.log)"
fi

# no-mistakes pipeline data push (cbundy/dev-system#273): rows pushed so far and
# whether state.sqlite has activity the push has not seen. A configured push
# whose loop is not running is a failure.
nm_state="$(nm_push_state_dir)/state"
nm_db="${NO_MISTAKES_HOME:-${NM_HOME:-/persist/no-mistakes}}/state.sqlite"
nm_total=$(sed -n 's/^total_rows=//p' "$nm_state" 2>/dev/null | sed -n 1p)
nm_last=$(sed -n 's/^last_push=//p' "$nm_state" 2>/dev/null | sed -n 1p)
nm_mark=$(sed -n 's/^mark=//p' "$nm_state" 2>/dev/null | sed -n 1p)
nm_wait=no
if [ -f "$nm_db" ]; then
  nm_wait=$("${DEV_SYSTEM_SHARE:-/usr/local/share/dev-system}/nm-export" "$nm_db" ${nm_mark:+--mark "$nm_mark"} --waiting 2>/dev/null) || nm_wait=no
fi
info "no-mistakes push: ${nm_total:-0} rows pushed (last pushed $(ev_when "${nm_last:-0}")), waiting: $nm_wait"
if [ "$av_rc" -eq 0 ]; then
  if flock -n /tmp/dev-nm-push.lock true 2>/dev/null; then
    fail "no-mistakes push is not running" "run: dev-init (log: /tmp/dev-nm-push.log)"
  fi
fi
unset nm_state nm_db nm_total nm_last nm_mark nm_wait
unset ev_dir ev_lines ev_pushed ev_last_written ev_last_pushed ev_f ev_m

# The trusted GitHub authors (cbundy/dev-system#307): callum-flow-issue-read fails
# closed without them, and once the factory reads through it, so does every agent.
# The image bakes no list - the Coder template and the desktop devcontainer
# templates provision CALLUM_FLOW_TRUSTED_AUTHORS - so a missing or malformed value
# is a FAIL here, before anything enforces it.
# shellcheck source=trusted-authors.sh
. /usr/local/share/dev-system/trusted-authors.sh
if ta_msg=$(trusted_authors_check); then
  if gh_token_mode; then
    # Token mode (cbundy/dev-system#728): the token account joins the variable's entries.
    ta_list=$(trusted_authors_effective)
    ok "trusted authors (token mode): $ta_list ($(printf '%s\n' "$ta_list" | tr ',' '\n' | wc -l | tr -d ' ') trusted author(s))"
    unset ta_list
  else
    ok "CALLUM_FLOW_TRUSTED_AUTHORS is set ($(printf '%s\n' "$CALLUM_FLOW_TRUSTED_AUTHORS" | tr ',' '\n' | wc -l | tr -d ' ') trusted author(s))"
  fi
else
  fail "$ta_msg" \
    "Coder: set trusted_authors = \"<login>:<numeric id>\" (e.g. cbundy:13131067) in coder/dev-system/terraform.tfvars and push both templates, then restart the workspace; desktop: export CALLUM_FLOW_TRUSTED_AUTHORS=<login>:<numeric id> on the host (the synced devcontainer.json forwards it) and rebuild the container; look an id up with: gh api users/<login> --jq .id"
fi
unset ta_msg
if gh_token_mode; then
  gh_token_doctor
  gh_token_access_doctor "${DEV_REPO_URL:-$(git -C "$workspace" remote get-url origin 2>/dev/null || true)}"
fi

# Memory (cbundy/dev-system#1124): the container's cgroup usage and pressure, one line. INFO when calm,
# WARN (never FAIL) when the cgroup hit its memory limit since the heartbeat's last reading, killed
# anything for memory, or tasks stall on memory (PSI full avg10 at or above MEM_PSI_FULL_WARN).
# Nothing is printed without a cgroup v2 memory.events or memory.pressure. The heartbeat's state file
# is only read here, never updated.
# shellcheck source=mem-pressure.sh
. /usr/local/share/dev-system/mem-pressure.sh
mem_cg="${HEARTBEAT_CGROUP_DIR:-/sys/fs/cgroup}"
if [ -r "$mem_cg/memory.events" ] || [ -r "$mem_cg/memory.pressure" ]; then
  mem_pressure_read "$mem_cg"
  mem_cur='' mem_max=''
  { read -r mem_cur < "$mem_cg/memory.current"; } 2> /dev/null || :
  { read -r mem_max < "$mem_cg/memory.max"; } 2> /dev/null || :
  case "$mem_cur" in '' | *[!0-9]*) mem_used_txt='memory used unknown' ;; *) mem_used_txt="$((mem_cur / 1048576)) MiB" ;; esac
  case "$mem_max" in
    max) mem_lim_txt='no limit' ;;
    '' | *[!0-9]*) mem_lim_txt='limit unknown' ;;
    *) mem_lim_txt="$((mem_max / 1048576)) MiB" ;;
  esac
  mem_rate=''
  if [ -n "$mp_max_events" ]; then
    mem_rate=$(mem_pressure_rate "${DEV_HEARTBEAT_DIR:-/tmp}/dev-heartbeat.mem" "$mp_max_events" "$(($(date +%s%N) / 1000))")
  fi
  if [ -n "$mem_rate" ]; then mem_rate_txt="$mem_rate/min since the last heartbeat reading"; else mem_rate_txt="rate unknown"; fi
  mem_line="memory: $mem_used_txt / $mem_lim_txt, max events ${mp_max_events:-unknown} ($mem_rate_txt), OOM kills ${mp_oom_kills:-unknown}, PSI avg10 some ${mp_psi_some_avg10:-unknown} / full ${mp_psi_full_avg10:-unknown}"
  mem_hot=false
  case "$mem_rate" in '' | 0.00) ;; *) mem_hot=true ;; esac
  case "${mp_oom_kills:-0}" in 0) ;; *) mem_hot=true ;; esac
  if [ -n "$mp_psi_full_avg10" ] && [ "${mp_psi_full_avg10%%.*}" -ge "$MEM_PSI_FULL_WARN" ]; then mem_hot=true; fi
  if $mem_hot; then
    warn "$mem_line" \
      "the container is short of memory: lower the loop's maxInFlightIssues (factory-loop settings) or raise the workspace memory"
  else
    info "$mem_line"
  fi
  unset mem_cg mem_cur mem_max mem_used_txt mem_lim_txt mem_rate mem_rate_txt mem_line mem_hot
fi

# Telemetry export (cbundy/dev-system#68) is opt-in, so this line is only
# information, never a failure: off without OTEL_EXPORTER_OTLP_ENDPOINT, else
# the endpoint, the protocol Claude uses (telemetry.sh) and whether a TCP
# connection to it opens within 2s (curl counts the connection, whatever the
# protocol then says).
info "$(
  # shellcheck source=telemetry.sh
  . /usr/local/share/dev-system/telemetry.sh
  ep="${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
  if [ -z "$ep" ]; then
    echo "telemetry export is off (OTEL_EXPORTER_OTLP_ENDPOINT is not set)"
  else
    if [ "$(curl -s -o /dev/null --connect-timeout 2 -m 2 -w '%{num_connects}' "$ep" 2>/dev/null)" -gt 0 ] 2>/dev/null; then
      reach=reachable
    else
      reach="NOT reachable (no connection within 2s)"
    fi
    echo "telemetry export is on: $(printf '%s' "$ep" | mask_secrets) ($OTEL_EXPORTER_OTLP_PROTOCOL), $reach"
  fi
)"

# Whether the image, plugin and tools are current (dev-version, cbundy/dev-system#271):
# information only, never a failure (a stale image is a WARN, which does not count as one).
# dev-version time-boxes its own lookups; the hard
# timeout here covers a hang in the command itself.
if command -v dev-version >/dev/null 2>&1; then
  dv_out=$(timeout -k 1 5 dev-version 2>/dev/null </dev/null)
  if [ -z "$dv_out" ]; then
    info "versions: unknown (dev-version timed out)"
  else
    dv_img=$(printf '%s\n' "$dv_out" | grep -E '^dev-version: STALE (base-image|image:)')
    dv_stale=$(printf '%s\n' "$dv_out" | grep -c '^dev-version: STALE ')
    dv_unknown=$(printf '%s\n' "$dv_out" | grep -c '^dev-version: UNKNOWN ')
    if [ -n "$dv_img" ]; then
      # An old image is the cause of "command not found" for tools added since; say so.
      while IFS= read -r dv_line; do
        warn "image is out of date: ${dv_line#dev-version: }" "rebuild the container (dev-restart-self, or Rebuild Container in a desktop dev container); do not install missing tools by hand"
      done <<< "$dv_img"
      dv_stale=$((dv_stale - $(printf '%s\n' "$dv_img" | wc -l)))
    fi
    if [ "$dv_stale" -gt 0 ]; then
      info "versions: $dv_stale stale (run dev-version)"
    elif [ "$dv_unknown" -gt 0 ]; then
      info "versions: all known current, $dv_unknown unknown (run dev-version)"
    elif [ -z "$dv_img" ]; then
      info "versions: all current"
    fi
  fi
  unset dv_out dv_img dv_line dv_stale dv_unknown
fi

if [ "$FAILURES" -gt 0 ]; then
  printf 'dev-doctor: %d check(s) failed\n' "$FAILURES"
  [ "$WARN_ONLY" = true ] && exit 0
  exit 1
fi
exit 0
