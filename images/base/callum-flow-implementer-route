#!/bin/sh
#
# callum-flow-implementer-route: decide which model the implementer sub-agent
# runs on for an issue, Sonnet (its frontmatter model) or Opus, so the factory
# can compare the two on real numbers (cbundy/dev-system#506). The split must be
# stable and exact, so it is computed, never asked of a model.
#
# Usage: callum-flow-implementer-route <issue>
#        callum-flow-implementer-route -h | --help
#
# Prints exactly one line, the model alias the factory loop passes as the
# model of its builder. Order of decision:
#   1. a `model:<alias>` label -> that alias (reason=label; with several, the
#      first in sorted order, with a warning). The owner's pick, so the
#      comparison leaves it out.
#   2. CALLUM_FLOW_IMPLEMENTER_OPUS_PCT unset, empty or 0 -> sonnet (reason=default)
#   3. bucket = POSIX `cksum` CRC of "implementer:<owner/repo>#<issue>" (repo
#      lower-cased) mod 100; opus when bucket < pct, else sonnet (reason=hash).
#      cksum is machine independent, so a resumed loop, a re-delegation
#      or a second device decides alike. The `implementer:` salt keeps the
#      buckets independent of the designer split, so the two splits
#      never pick the same issues.
# If the repo or the labels cannot be read it prints sonnet with a warning on
# stderr (reason=fallback): delegation never blocks on routing.
#
# Only the implementer is routed: fixers, the designer, the adjudicator and the
# pipeline keep their own models, so a difference between the groups comes from
# the implementer. docs/metrics.md "8. Implementer model comparison" compares them.
#
# Every decision is logged once with
#   callum-flow-event --type implementer_routed --issue N --data '{"model":..,"reason":..,"bucket":..,"opus_pct":..}'
# A logging failure never changes the output or the exit code.
#
# Exit codes: 0 routed (including the fallback) or -h | --help (usage on stdout,
# nothing logged, whatever the environment), 2 usage error (bad issue, or
# CALLUM_FLOW_IMPLEMENTER_OPUS_PCT not a number from 0 to 100); nothing is logged.
#
# Environment: CALLUM_FLOW_IMPLEMENTER_OPUS_PCT (default 0), CALLUM_FLOW_REPO
# (owner/name, default from gh); for tests CALLUM_FLOW_GH_BIN,
# CALLUM_FLOW_EVENT_BIN, CALLUM_FLOW_ISSUE_READ_BIN (callum-flow-issue-read).
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
EVENT=${CALLUM_FLOW_EVENT_BIN:-callum-flow-event}
READ=${CALLUM_FLOW_ISSUE_READ_BIN:-callum-flow-issue-read}
PCT=${CALLUM_FLOW_IMPLEMENTER_OPUS_PCT:-0}
# The control is the implementer agent's frontmatter model (a test keeps them equal).
CONTROL=sonnet
TREATMENT=opus

usage() {
  [ -z "${1-}" ] || echo "callum-flow-implementer-route: $1" >&2
  echo "usage: callum-flow-implementer-route <issue>" >&2
  exit 2
}
help() {
  echo "usage: callum-flow-implementer-route <issue>"
  exit 0
}
err() { echo "callum-flow-implementer-route: $*" >&2; }

[ $# -ne 1 ] || case "$1" in -h | --help) help ;; esac

case "$PCT" in
  '' | *[!0-9]*) usage "CALLUM_FLOW_IMPLEMENTER_OPUS_PCT must be a number from 0 to 100" ;;
esac
PCT=$(printf '%s' "$PCT" | sed 's/^0*//')
PCT=${PCT:-0}
[ "$PCT" -le 100 ] || usage "CALLUM_FLOW_IMPLEMENTER_OPUS_PCT must be a number from 0 to 100"
[ $# -eq 1 ] || usage
n=$1
case "$n" in '' | *[!0-9]*) usage "issue must be a number, got '$n'" ;; esac

# The one place the issue's labels are read (one label per line), through the
# trusted-author reader (cbundy/dev-system#310): an untrusted issue, or any reader
# failure, makes this fail, and the route falls back to the control.
read_labels() {
  _rj=$(CALLUM_FLOW_REPO="$repo" "$READ" --json "$1") || return 1
  printf '%s' "$_rj" | jq -r '.issue.labels | if type == "array" then . else error("shape") end | map(.name) | .[]'
}

log() {
  _d=$(jq -nc --arg m "$1" --arg r "$2" --arg b "$3" --argjson p "$PCT" \
    '{model: $m, reason: $r, bucket: (if $b == "-" then null else ($b | tonumber) end), opus_pct: $p}') || { err "warning: could not log the implementer_routed event"; return 0; }
  "$EVENT" --type implementer_routed --issue "$n" --data "$_d" >/dev/null 2>&1 ||
    err "warning: could not log the implementer_routed event"
}
decide() { echo "$1"; log "$1" "$2" "$3"; exit 0; }

repo=${CALLUM_FLOW_REPO-}
[ -n "$repo" ] || repo=$("$GH" repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || repo=
if [ -z "$repo" ]; then
  err "warning: cannot determine the repo (set CALLUM_FLOW_REPO); routing to $CONTROL"
  decide "$CONTROL" fallback -
fi
repo=$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')

if ! labels=$(read_labels "$n" 2>/dev/null); then
  err "warning: cannot read the labels of #$n; routing to $CONTROL"
  decide "$CONTROL" fallback -
fi
# A label alias is passed to the Agent call as is, so only a plain alias or model id counts.
picks=$(printf '%s\n' "$labels" | sed -n 's/^model://p' | grep -E '^[A-Za-z0-9._-]+$' | LC_ALL=C sort -u)
if [ -n "$picks" ]; then
  pick=$(printf '%s\n' "$picks" | sed -n 1p)
  [ "$pick" = "$picks" ] || err "warning: #$n has several model: labels; using model:$pick"
  decide "$pick" label -
fi

[ "$PCT" -gt 0 ] || decide "$CONTROL" default -

bucket=$(printf 'implementer:%s#%s' "$repo" "$n" | cksum | { read -r crc _; echo $((crc % 100)); })
if [ "$bucket" -lt "$PCT" ]; then decide "$TREATMENT" hash "$bucket"; fi
decide "$CONTROL" hash "$bucket"
