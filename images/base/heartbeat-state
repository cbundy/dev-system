#!/usr/bin/env node
'use strict';
// heartbeat-state: prints {state, in_flight, chat_active_at, sessions, claude_sessions, config,
// github_errors_1h} as JSON
// for heartbeat-loop (cbundy/dev-system#339). One call per beat.
//
// Usage: heartbeat-state [--repo <owner/name>] [--source old|new|shadow]
// config is the parsed $CLAUDE_CONFIG_DIR/factory-loop/<owner>__<name>/settings.json (the factory
// loop's settings snapshot; default config dir ~/.claude), the file heartbeat-loop writes to
// factory.workers.config. When that exact folder is missing, a folder under factory-loop/ whose
// name matches case-insensitively is used (heartbeat-loop lowercases the repo). config is null
// with no --repo, a missing file, or a file that is unreadable, not valid JSON, not a JSON object
// or over 256 KiB; every case but "missing" warns once on stderr and never fails the call. It is
// not part of the answer the source shadow compares.
// github_errors_1h is the number of entries of `errors` within the hour before now in the same
// folder's github.json (the factory loop's GitHub API error list, cbundy/dev-system#1305). It is null
// with no --repo, a missing, unreadable, invalid or over 256 KiB file, a `v` other than 1, or an
// `at` older than 15 minutes (no loop is running on this device, so it cannot say).
//
// busy when any of these holds, otherwise idle:
//   - an issue on THIS device whose latest lifecycle event is not merged,
//     abandoned, claim_lost (the owner's rule), owner_wait, or closed, ready,
//     reclaimed (closed, queued, or reclaimed from a stale claim: no one here
//     is working on it). After merged, abandoned, closed or claim_lost only a
//     new-life decision (ready, reclaimed, claimed, briefed, design_routed,
//     implementer_routed, delegated) counts as a later event, as in
//     fabriek-factory-state; after any of the idle states the replayed run facts failed,
//     head_mismatch, conflict and ci_stalled never count. Noise
//     states never count for or against busy (fabriek-issue-read logs
//     untrusted_stripped on any read; renewed is the claim heartbeat; loop is
//     the factory loop's bookkeeping, DECISIONS D-09, logged for an issue in
//     any stage, a queued one included).
//   - a typed prompt (classifyWake kind 'owner', not a sidechain) in a Claude
//     transcript within the last 5 minutes
//
// sessions lists the Claude sessions live on this device now, one
// {session_id, parent_session_id, context_window} each:
//   - a top-level session is one Claude Code registers in
//     $CLAUDE_CONFIG_DIR/sessions/<pid>.json whose process is still running
//     (the pid's start time matches the file's procStart, so a reused pid after
//     a restart does not count); parent_session_id is null
//   - a sub-agent is a subagents/agent-<id>.jsonl transcript of a live
//     top-level session whose last message is not a finished turn (stop_reason
//     end_turn); its session_id is agent-<id>, as agentsview names it, and its
//     parent_session_id the top-level session
//   - context_window is the window size the session's status line last wrote
//     to $DEV_CONTEXT_WINDOW_DIR/<session_id> (factory-loop-workspace, in every
//     loop workspace, or the factory-hud mod), else null; always null for sub-agents
// claude_sessions is {interactive, headless}: the count of those top-level sessions by the entrypoint
// the registry file names (headless when it starts with sdk-, as `claude -p` writes sdk-cli; any
// other is interactive). Sub-agents are not counted. This is read from the registry, never from a
// process's command line or environment.
// Any read error degrades to the remaining sources and goes to stderr; this
// never fails the beat.
//
// Source switch (cbundy/dev-system#900, docs/factory-events/replay.md): which log decides the
// in-flight issues. FABRIEK_HEARTBEAT_STATE_SOURCE or --source, old|new|shadow, default new (old is the way back).
//   old     the old lines in $CALLUM_EVENTS_DIR/*.jsonl, as above.
//   new     this device's new events in $CALLUM_EVENTS_DIR/factory/*.jsonl (regular files only, so
//           .shadow/ and .pushed/ are skipped), by the same rule written for the new types: an issue is
//           in flight unless its latest lifecycle event (ready, claimed, requeued, claim_lost, closed,
//           abandoned, merged, implementer_routed, finding_handled) is merged, abandoned, claim_lost,
//           closed, ready or requeued; after merged, abandoned, closed or claim_lost only a later ready,
//           requeued, claimed or implementer_routed counts. A transition into building, fixing or merge-queue
//           (from another state) also counts, as the old delegated, fix_requested or merge_ready line the loop
//           writes there, with the transition's branch; it is never done, and only one into building
//           starts a new life after a terminal state. Every other transition and type is noise.
//   shadow  prints old's answer, runs new too and records how it differs in
//           factory/.shadow/heartbeat-state.jsonl (an agreeing run at most once per quiet period).
// An invalid value warns once on stderr and reads old. The new read has its own deadline: when it
// passes, shadow records new_error and new reads nothing from the events, and the beat goes on.
//
// Environment: FABRIEK_HEARTBEAT_STATE_SOURCE, FABRIEK_HEARTBEAT_STATE_NEW_TIMEOUT_MS (500),
//   FABRIEK_HEARTBEAT_STATE_SHADOW_QUIET_SECONDS (600), HEARTBEAT_TEST_NEW_DELAY_MS (tests),
//   CALLUM_EVENTS_DIR, CLAUDE_CONFIG_DIR,
//   DEV_MACHINE_NAME, DEV_CONTEXT_WINDOW_DIR (default /tmp/dev-context-window),
//   HEARTBEAT_EVALUATE (path of fabriek-evaluate), HEARTBEAT_NOW_MS (tests).

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
// The FABRIEK_<X> settings, falling back to the old CALLUM_FLOW_<X> names (fabriek-env.js, beside this tool or in the share dir).
const { applyFabriekEnv } = require([path.join(__dirname, 'fabriek-env.js'), path.join(process.env.DEV_SYSTEM_SHARE || '/usr/local/share/dev-system', 'fabriek-env.js')].find((p) => fs.existsSync(p)));
applyFabriekEnv();
const { resolveSource, runShadow } = require(path.join(__dirname, 'factory-source.js'));
const { SYNTHESIZED, currentShapes, isCurrent, skippedList, countSkip } = require(path.join(__dirname, 'evaluate-new-events.js'));

// transition, reviewed, intervention, prompt_denied and prompt_waiting are the v2 loop's bookkeeping: a claim and its release
// (claimed, merged, abandoned, closed, reclaimed) already say whether an issue is in flight, and an
// intervention derived a pass after a release must not reopen it.
const NOISE = new Set(['usage', 'untrusted_stripped', 'watcher_error', 'test_weakened', 'superseded', 'renewed', 'loop',
  'transition', 'reviewed', 'intervention', 'prompt_denied', 'prompt_waiting']);
const isNoise = (s) => NOISE.has(s) || /^(upgrade|drain)/.test(s);
const DONE = new Set(['merged', 'abandoned', 'claim_lost', 'owner_wait', 'closed', 'ready', 'reclaimed']);
const TERMINAL = new Set(['merged', 'abandoned', 'closed', 'claim_lost']);
const NEW_LIFE = new Set(['ready', 'reclaimed', 'claimed', 'briefed', 'design_routed', 'implementer_routed', 'delegated']);
const REPLAYED = new Set(['failed', 'head_mismatch', 'conflict', 'ci_stalled']);
// The same rule for the new types (docs/factory-events/schemas). Every schema but the envelope is in
// exactly one of the two sets, so a new type forces a choice (tests/heartbeat-state.test.js).
const EV_LIFECYCLE = new Set(['ready', 'claimed', 'requeued', 'claim_lost', 'closed', 'abandoned', 'merged', 'implementer_routed', 'finding_handled']);
const EV_NOISE = new Set(['claim_renewed', 'transition', 'reviewed', 'intervention', 'loop_entry', 'loop_passes', 'usage',
  'untrusted_stripped', 'test_weakened', 'shadow_read', 'gate_run', 'wind_down', 'released', 'milestone_state', 'main_state', 'comment_posted', 'settings_changed',
  'prompt_denied', 'prompt_waiting', 'designer_routed', 'queue_snapshot', 'intake_stamp']);
const EV_DONE = new Set(['merged', 'abandoned', 'claim_lost', 'closed', 'ready', 'requeued']);
const EV_TERMINAL = new Set(['merged', 'abandoned', 'closed', 'claim_lost']);
const EV_LIFE = new Set(['ready', 'requeued', 'claimed', 'implementer_routed']);
const CHAT_WINDOW_MS = 5 * 60 * 1000;
const TAIL_BYTES = 512 * 1024;

const now = Number(process.env.HEARTBEAT_NOW_MS) || Date.now();
const warn = (msg) => process.stderr.write(`heartbeat-state: ${msg}\n`);

function device() {
  return process.env.DEV_MACHINE_NAME || os.hostname() || 'unknown';
}

const lowerRepo = (repo) => (repo ? String(repo).toLowerCase() : null);
const issueKey = (repo, issue) => `${repo}#${issue}`;

// deriveOld(events, dev): the in-flight issues over parsed old lines. Pure.
function deriveOld(events, dev) {
  const byIssue = new Map(); // "repo#issue" -> [{ts, ev}]
  for (const ev of events) {
    if (!ev || typeof ev !== 'object' || ev.device !== dev || typeof ev.state !== 'string') continue;
    if (isNoise(ev.state) || !Number.isInteger(ev.issue)) continue;
    const key = issueKey(lowerRepo(ev.repo), ev.issue);
    if (!byIssue.has(key)) byIssue.set(key, []);
    byIssue.get(key).push({ ts: Date.parse(ev.ts) || 0, ev });
  }
  const issues = [];
  for (const evs of byIssue.values()) {
    let cur = null;
    for (const { ev } of evs.sort((a, b) => a.ts - b.ts)) {
      if (cur && TERMINAL.has(cur.state) && !NEW_LIFE.has(ev.state)) continue;
      if (cur && DONE.has(cur.state) && REPLAYED.has(ev.state)) continue;
      cur = ev;
    }
    if (!DONE.has(cur.state)) issues.push(cur);
  }
  return { issues };
}

// deriveNew(events, dev): the same for parsed new events, in the local log's shape (payload under data)
// or an event_log row's (payload flat). Each issue is {repo, issue, branch, state: <the new type>}. Pure.
function deriveNew(events, dev) {
  const byIssue = new Map();
  for (const ev of events) {
    if (!ev || typeof ev !== 'object' || ev.device !== dev || !Number.isInteger(ev.issue)) continue;
    const payload = ev.data && typeof ev.data === 'object' ? ev.data : ev;
    let state = ev.type;
    if (ev.type === 'transition') {
      // A transition into building, fixing or merge-queue is the old delegated, fix_requested or
      // merge_ready line (the SYNTHESIZED rule of evaluate-new-events.js); any other never counts.
      if (!Object.hasOwn(SYNTHESIZED, payload.to_state) || payload.from_state === payload.to_state) continue;
      state = SYNTHESIZED[payload.to_state];
    } else if (!EV_LIFECYCLE.has(ev.type)) continue;
    const key = issueKey(lowerRepo(ev.repo), ev.issue);
    if (!byIssue.has(key)) byIssue.set(key, []);
    byIssue.get(key).push({ ts: Date.parse(ev.ts) || 0, ev: { repo: lowerRepo(ev.repo), issue: ev.issue, branch: payload.branch || null, state } });
  }
  const issues = [];
  for (const evs of byIssue.values()) {
    let cur = null;
    for (const { ev } of evs.sort((a, b) => a.ts - b.ts)) { // stable: equal times keep file or row order
      if (cur && EV_TERMINAL.has(cur.state) && !EV_LIFE.has(ev.state) && ev.state !== 'delegated') continue;
      cur = ev;
    }
    if (!EV_DONE.has(cur.state)) issues.push(cur);
  }
  return { issues };
}

function readOldEvents(dir) {
  const events = [];
  let names = [];
  try { names = fs.readdirSync(dir).filter((n) => n.endsWith('.jsonl')).sort(); } catch { return events; }
  for (const n of names) {
    let text;
    try { text = fs.readFileSync(path.join(dir, n), 'utf8'); } catch (e) { warn(`${n}: ${e.message}`); continue; }
    for (const line of text.split('\n')) {
      if (!line.trim()) continue;
      try { events.push(JSON.parse(line)); } catch { /* skip a torn line */ }
    }
  }
  return events;
}

const CHUNK_BYTES = 64 * 1024;
const sleepMs = (ms) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

// readNewEvents(dir, dev, timeoutMs): the parsed new events of <dir>/factory/*.jsonl (regular files
// only) that are this device's. Read in chunks, with the deadline checked between chunks and lines; it
// throws "new read timed out after <N> ms" when it passes. A missing folder reads as no events.
function readNewEvents(dir, dev, timeoutMs, current = null, skipped = null) {
  const deadline = Date.now() + timeoutMs;
  const delay = Number(process.env.HEARTBEAT_TEST_NEW_DELAY_MS) || 0;
  const check = () => {
    if (delay) sleepMs(delay);
    if (Date.now() > deadline) throw new Error(`new read timed out after ${timeoutMs} ms`);
  };
  const root = path.join(dir, 'factory');
  let entries;
  try { entries = fs.readdirSync(root, { withFileTypes: true }); } catch (e) {
    if (e.code === 'ENOENT') return [];
    throw e;
  }
  const names = entries.filter((d) => d.isFile() && d.name.endsWith('.jsonl')).map((d) => d.name).sort();
  const events = [];
  const take = (buf) => {
    check();
    const line = buf.toString('utf8');
    if (!line.trim()) return;
    let ev;
    try { ev = JSON.parse(line); } catch { return; }
    if (!ev || ev.device !== dev) return;
    // an event of a type or version the shapes file does not list as current (a newer writer) is
    // counted and left out here, never in deriveNew
    if (current && typeof ev.type === 'string' && !isCurrent(current, ev)) { countSkip(skipped, ev); return; }
    events.push(ev);
  };
  for (const n of names) {
    const fd = fs.openSync(path.join(root, n), 'r');
    try {
      const chunk = Buffer.alloc(CHUNK_BYTES);
      let rest = Buffer.alloc(0);
      for (;;) {
        check();
        const got = fs.readSync(fd, chunk, 0, CHUNK_BYTES, null);
        if (got === 0) break;
        rest = Buffer.concat([rest, chunk.subarray(0, got)]);
        let nl;
        while ((nl = rest.indexOf(10)) !== -1) { take(rest.subarray(0, nl)); rest = rest.subarray(nl + 1); }
      }
      take(rest);
    } finally { fs.closeSync(fd); }
  }
  return events;
}

function loadClassifyWake() {
  const candidates = [process.env.HEARTBEAT_EVALUATE, path.join(__dirname, 'fabriek-evaluate'), '/usr/local/bin/fabriek-evaluate',
    path.join(__dirname, 'callum-flow-evaluate'), '/usr/local/bin/callum-flow-evaluate'].filter(Boolean);
  for (const c of candidates) {
    try { return require(c).classifyWake; } catch { /* next */ }
  }
  warn('fabriek-evaluate not found, chat activity unavailable');
  return null;
}

function chatActiveAt(claudeDir) {
  const classifyWake = loadClassifyWake();
  if (!classifyWake) return null;
  let newest = 0;
  const root = path.join(claudeDir, 'projects');
  let projects = [];
  try { projects = fs.readdirSync(root); } catch { return null; }
  for (const p of projects) {
    let files = [];
    try { files = fs.readdirSync(path.join(root, p)).filter((n) => n.endsWith('.jsonl')); } catch { continue; }
    for (const f of files) {
      const file = path.join(root, p, f);
      try {
        const st = fs.statSync(file);
        if (now - st.mtimeMs > CHAT_WINDOW_MS) continue;
        const start = Math.max(0, st.size - TAIL_BYTES);
        const fd = fs.openSync(file, 'r');
        const buf = Buffer.alloc(st.size - start);
        try { fs.readSync(fd, buf, 0, buf.length, start); } finally { fs.closeSync(fd); }
        const lines = buf.toString('utf8').split('\n');
        if (start > 0) lines.shift(); // a partial first line
        for (const line of lines) {
          if (!line.trim()) continue;
          let o;
          try { o = JSON.parse(line); } catch { continue; }
          if (!o || o.isSidechain) continue;
          const w = classifyWake(o);
          if (!w || w.kind !== 'owner') continue;
          const t = Date.parse(o.timestamp);
          if (t > newest) newest = t;
        }
      } catch (e) { warn(`${f}: ${e.message}`); }
    }
  }
  return newest ? new Date(newest).toISOString() : null;
}

// procStart: a process's start time in clock ticks (field 22 of /proc/<pid>/stat),
// as Claude Code records it in sessions/<pid>.json; null when the pid is gone.
function procStart(pid) {
  try {
    const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8');
    return stat.slice(stat.lastIndexOf(')') + 2).split(' ')[19] || null;
  } catch { return null; }
}

// lastMessage: the last user or assistant line of a transcript, read from its tail.
function lastMessage(file) {
  const st = fs.statSync(file);
  const start = Math.max(0, st.size - TAIL_BYTES);
  const fd = fs.openSync(file, 'r');
  const buf = Buffer.alloc(st.size - start);
  try { fs.readSync(fd, buf, 0, buf.length, start); } finally { fs.closeSync(fd); }
  const lines = buf.toString('utf8').split('\n');
  if (start > 0) lines.shift();
  for (let i = lines.length - 1; i >= 0; i--) {
    let o;
    try { o = JSON.parse(lines[i]); } catch { continue; }
    if (o && (o.type === 'user' || o.type === 'assistant')) return o;
  }
  return null;
}

function contextWindow(dir, id) {
  try {
    const n = Number(fs.readFileSync(path.join(dir, id), 'utf8').trim());
    return Number.isInteger(n) && n > 0 ? n : null;
  } catch { return null; }
}

function liveSessions(claudeDir, windowDir, counts) {
  const sessions = [];
  let names = [];
  try { names = fs.readdirSync(path.join(claudeDir, 'sessions')).filter((n) => /^[0-9]+\.json$/.test(n)); } catch { return sessions; }
  let projects = [];
  try { projects = fs.readdirSync(path.join(claudeDir, 'projects')); } catch { /* no transcripts yet */ }
  for (const n of names) {
    let s;
    try { s = JSON.parse(fs.readFileSync(path.join(claudeDir, 'sessions', n), 'utf8')); } catch (e) { warn(`${n}: ${e.message}`); continue; }
    if (!s || typeof s.sessionId !== 'string' || !/^[\w-]+$/.test(s.sessionId)) continue;
    const started = procStart(s.pid);
    if (started === null || (s.procStart !== undefined && String(s.procStart) !== started)) continue;
    if (typeof s.entrypoint === 'string' && s.entrypoint.startsWith('sdk-')) counts.headless++; else counts.interactive++;
    sessions.push({ session_id: s.sessionId, parent_session_id: null, context_window: contextWindow(windowDir, s.sessionId) });
    for (const p of projects) {
      const dir = path.join(claudeDir, 'projects', p, s.sessionId, 'subagents');
      let agents = [];
      try { agents = fs.readdirSync(dir).filter((f) => /^agent-[\w-]+\.jsonl$/.test(f)); } catch { continue; }
      for (const f of agents) {
        try {
          const last = lastMessage(path.join(dir, f));
          if (last && last.message && last.message.stop_reason === 'end_turn') continue;
          const id = f.slice(0, -'.jsonl'.length);
          sessions.push({ session_id: id, parent_session_id: s.sessionId, context_window: contextWindow(windowDir, id) });
        } catch (e) { warn(`${f}: ${e.message}`); }
      }
    }
  }
  return sessions;
}

// inFlightOf(derived): the in-flight entries of one event source. Pure.
function inFlightOf({ issues }) {
  return issues.map((ev) => ({ repo: lowerRepo(ev.repo), issue: ev.issue, run_id: ev.run_id || null, branch: ev.branch || null, state: ev.state }));
}

const answerOf = (inFlight, chatBusy) => ({ state: inFlight.length > 0 || chatBusy ? 'busy' : 'idle', in_flight: inFlight });

// normalize(answer): what the shadow compare looks at. The per-entry state differs by construction (old
// state names against new types), so it is dropped; the entries are sorted so their order does not count.
function normalize(answer) {
  const key = (e) => [e.repo, e.issue, e.run_id].map((v) => (v === null || v === undefined ? '' : String(v))).join('\u0000');
  const inFlight = answer.in_flight.map((e) => ({ repo: e.repo, issue: e.issue, run_id: e.run_id, branch: e.branch }));
  inFlight.sort((a, b) => (key(a) < key(b) ? -1 : key(a) > key(b) ? 1 : 0));
  return { state: answer.state, in_flight: inFlight };
}

// The replay reader's answers: events only, no chat.
const answerOld = (events, dev) => answerOf(inFlightOf(deriveOld(events, dev)), false);
const answerNew = (events, dev) => answerOf(inFlightOf(deriveNew(events, dev)), false);

function intEnv(name, fallback) {
  const n = Number(process.env[name]);
  return Number.isFinite(n) && n >= 0 && process.env[name] !== '' && process.env[name] !== undefined ? n : fallback;
}

const CONFIG_MAX_BYTES = 256 * 1024;

// repoOf: the value of --repo / --repo=X in argv, else null.
function repoOf(argv) {
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--repo') return argv[i + 1] || null;
    if (argv[i].startsWith('--repo=')) return argv[i].slice('--repo='.length) || null;
  }
  return null;
}

// loopDirOf: the repo's folder of the loop under configDir, or null (see the header).
function loopDirOf(configDir, repo) {
  if (!repo || !/^[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+$/.test(repo)) return null;
  const base = `${configDir.replace(/\/+$/, '')}/factory-loop`;
  const want = repo.replace('/', '__');
  let dir = path.join(base, want);
  if (!fs.existsSync(dir)) {
    let names = [];
    try { names = fs.readdirSync(base); } catch { return null; }
    const hit = names.filter((n) => n.toLowerCase() === want.toLowerCase()).sort()[0];
    if (!hit) return null;
    dir = path.join(base, hit);
  }
  return dir;
}

// readConfig: the repo's settings snapshot (see the header), or null.
function readConfig(configDir, repo) {
  const dir = loopDirOf(configDir, repo);
  if (!dir) return null;
  const file = path.join(dir, 'settings.json');
  try {
    const st = fs.statSync(file);
    if (st.size > CONFIG_MAX_BYTES) { warn(`config: ${file} is over ${CONFIG_MAX_BYTES} bytes`); return null; }
    const v = JSON.parse(fs.readFileSync(file, 'utf8'));
    if (v === null || typeof v !== 'object' || Array.isArray(v)) { warn(`config: ${file} is not a JSON object`); return null; }
    return v;
  } catch (e) {
    if (e.code !== 'ENOENT') warn(`config: ${e.message}`);
    return null;
  }
}

const GITHUB_WINDOW_MS = 3600 * 1000;
const GITHUB_FRESH_MS = 15 * 60 * 1000;

// readGithubErrors: the loop's GitHub API errors within the last hour (see the header), or null.
function readGithubErrors(configDir, repo, nowMs) {
  const dir = loopDirOf(configDir, repo);
  if (!dir) return null;
  const file = path.join(dir, 'github.json');
  try {
    if (fs.statSync(file).size > CONFIG_MAX_BYTES) { warn(`github: ${file} is over ${CONFIG_MAX_BYTES} bytes`); return null; }
    const v = JSON.parse(fs.readFileSync(file, 'utf8'));
    if (v === null || typeof v !== 'object' || Array.isArray(v) || v.v !== 1 || !Array.isArray(v.errors)) return null;
    const at = Date.parse(v.at);
    if (!Number.isFinite(at) || nowMs - at > GITHUB_FRESH_MS) return null;
    return v.errors.filter((e) => {
      const t = typeof e === 'string' ? Date.parse(e) : NaN;
      return Number.isFinite(t) && t <= nowMs && nowMs - t < GITHUB_WINDOW_MS;
    }).length;
  } catch (e) {
    if (e.code !== 'ENOENT') warn(`github: ${e.message}`);
    return null;
  }
}

async function main() {
  const dev = device();
  const dir = process.env.CALLUM_EVENTS_DIR || '/persist/events';
  let source = 'old';
  let repo = repoOf(process.argv.slice(2));
  try {
    const r = resolveSource('heartbeat-state', process.argv.slice(2), process.env, 'new');
    source = r.source;
    repo = repoOf(r.argv);
  } catch (e) { warn(`${e.message}: reading old`); }
  const empty = { issues: [] };
  const derivedOld = () => {
    try { return deriveOld(readOldEvents(dir), dev); } catch (e) { warn(`events: ${e.message}`); return empty; }
  };
  const timeoutMs = intEnv('FABRIEK_HEARTBEAT_STATE_NEW_TIMEOUT_MS', 500);
  let skipped = [];
  const derivedNew = () => {
    let current = null;
    try { current = currentShapes(); } catch (e) { warn(`shapes: ${e.message}: reading every version`); }
    const counts = new Map();
    const derived = deriveNew(readNewEvents(dir, dev, timeoutMs, current, counts), dev);
    skipped = skippedList(counts);
    return derived;
  };
  let chat = null;
  try { chat = chatActiveAt(process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude')); } catch (e) { warn(`chat: ${e.message}`); }
  const chatBusy = chat !== null && now - Date.parse(chat) <= CHAT_WINDOW_MS;
  let answer;
  if (source === 'old') answer = answerOf(inFlightOf(derivedOld()), chatBusy);
  else if (source === 'new') {
    let derived = empty;
    try { derived = derivedNew(); } catch (e) { warn(`events: ${e.message}`); }
    answer = answerOf(inFlightOf(derived), chatBusy);
  } else {
    answer = await runShadow({
      tool: 'heartbeat-state',
      old: () => answerOf(inFlightOf(derivedOld()), chatBusy),
      new: () => answerOf(inFlightOf(derivedNew()), chatBusy),
      normalize,
      eventsDir: dir,
      quietMs: intEnv('FABRIEK_HEARTBEAT_STATE_SHADOW_QUIET_SECONDS', 600) * 1000,
    });
  }
  const { state, in_flight: inFlight } = answer;
  let sessions = [];
  const counts = { interactive: 0, headless: 0 };
  try {
    sessions = liveSessions(process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude'),
      process.env.DEV_CONTEXT_WINDOW_DIR || '/tmp/dev-context-window', counts);
  } catch (e) { warn(`sessions: ${e.message}`); }
  let config = null;
  try { config = readConfig(process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude'), repo); } catch (e) { warn(`config: ${e.message}`); }
  let githubErrors = null;
  try { githubErrors = readGithubErrors(process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude'), repo, now); } catch (e) { warn(`github: ${e.message}`); }
  process.stdout.write(`${JSON.stringify({ state, in_flight: inFlight, chat_active_at: chat, sessions, claude_sessions: counts, config, github_errors_1h: githubErrors, skipped_events: source === 'old' ? [] : skipped })}\n`);
}

const fallback = (e) => {
  warn(e.message);
  process.stdout.write(`${JSON.stringify({ state: 'idle', in_flight: [], chat_active_at: null, sessions: [], claude_sessions: { interactive: 0, headless: 0 }, config: null, github_errors_1h: null, skipped_events: [] })}\n`);
};

if (require.main === module) {
  try { main().catch(fallback); } catch (e) { fallback(e); }
}

module.exports = { deriveOld, deriveNew, normalize, answerOld, answerNew, EV_LIFECYCLE, EV_NOISE, EV_DONE, EV_TERMINAL, EV_LIFE };
