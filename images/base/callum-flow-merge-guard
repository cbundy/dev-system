#!/bin/sh
#
# callum-flow-merge-guard: check that a PR is safe to merge (cbundy/dev-system#219).
# Checking is read-only; callum-flow-merge is the separate command that merges.
# The mode reference is in images/base/README.md.
#
# Usage: callum-flow-merge-guard <pr> --patch ID [--expect closing|refs]
#          [--base BRANCH] [--issue N] [--emit-verified]
#   --patch ID is the factory loop's mode, the only one (docs/factory-loop/v2/SPEC.md 9.4): it checks
#   only facts the loop owns. A patch guard checks that the PR head's patch id
#   (callum-flow-patch-id <head> <default branch>, override CALLUM_FLOW_PATCH_ID_BIN) is ID, the
#   one the loop's reviewer approved. Every FAIL line ends with ` class=<class>`, one of behind,
#   conflict, checks, patch, linkage, read and policy, so the loop acts on the class and never
#   parses the reason's words: read is a fact the guard could not read, verify, derive or
#   compute, its reason ending with what the read printed on stderr; policy is what only the owner can change (an untrusted author, another base, a
#   draft, a branch without an issue).
#   --tested-tree SHA is the merge train's check (docs/factory-loop/v2/SPEC.md 9.4): the
#   tree CI already passed. It adds the tree guard, which passes only when git merge-tree of origin/<pr
#   base> and the PR head gives exactly that tree, and a BEHIND merge state is then no FAIL (the tree guard
#   stands in for it). A conflict or another tree is class=behind, a failed fetch or read class=read.
#   Without --expect, the linkage expectation comes from the issue's Rollout
#   (callum-flow-rollout): merge means closing, run-it and keep-open mean refs
#   (cbundy/dev-system#239). Pass --expect only to assert it; a value that
#   contradicts the Rollout fails the rollout guard.
#
# Checking guards (every guard is evaluated and reported, none short-circuits, except that a
# PR by an untrusted author is read no further: rollout and linkage are skipped):
#   author   the PR was opened by a trusted author (callum-flow-issue-read,
#          cbundy/dev-system#310); an untrusted or unverifiable author fails
#   rollout  the issue's Rollout was derived (or agrees with --expect); a
#          conflict or a failure to derive fails closed, never to closing
#   linkage  check-pr-linkage.sh reports MATCH; on SKIP (no issue in the branch
#          name) --issue N is required and the PR must link #N as --expect says
#   checks   at least one CI check, all pass or skipping; and the head's latest workflow
#          run per workflow and event is completed with success, skipped or neutral (a run
#          with no job yet is in no check list)
#   patch    the PR head's patch id against the default branch is ID
#   tree     (--tested-tree only) merging the PR head onto origin/<pr base> gives the tested tree
#   base     the PR targets the default branch, or --base BRANCH
#   mergeable  GitHub would merge it now: open, not a draft, not conflicting,
#          not behind its base, branch rules met (cbundy/dev-system#246)
#   test-weakening  advisory, never fails the guard (cbundy/dev-system#314):
#          callum-flow-test-weakening scans origin/<pr base>..<pr head> for
#          commits that delete or weaken tests; each one it cannot see restored
#          prints a WARN line (below). A detector error is also a WARN.
#
# Checking output: one line per failed guard,
#   GUARD <name> FAIL <reason> class=<class>
# Advisory lines can appear with exit 0 and never change the exit code:
#   GUARD test-weakening WARN <sha7> files=<f> kinds=<k> - <what to do>
#   GUARD test-weakening WARN detector error: <reason>
# --emit-verified adds, on success only, the detector's WEAKENED lines verbatim
# (restored ones included, for the test_weakened event) and then one line for
# callum-flow-merge:
#   VERIFIED pr=N branch=B head=SHA run= issue=N close_issue=N gated_patch= rebased_from=
# run, gated_patch and rebased_from are always empty (kept so the line's shape is unchanged).
# close_issue is the issue to close manually for a closing PR on a non-default
# base; it is empty otherwise.
#
# Exit codes: 0 all guards pass, 1 a guard fails, 2 usage error.
#
# Environment (for tests): CALLUM_FLOW_GH_BIN (gh),
# CALLUM_FLOW_LINKAGE_BIN (check-pr-linkage.sh),
# CALLUM_FLOW_ROLLOUT_BIN (callum-flow-rollout), CALLUM_FLOW_ISSUE_READ_BIN
# (callum-flow-issue-read), CALLUM_FLOW_WEAKENING_BIN
# (callum-flow-test-weakening), CALLUM_FLOW_PATCH_ID_BIN (callum-flow-patch-id).
# Tuning: GitHub computes mergeability lazily and reports UNKNOWN meanwhile, so
# the mergeable guard re-reads (read-only) CALLUM_FLOW_MERGEABLE_TRIES
# times (default 5) CALLUM_FLOW_MERGEABLE_SLEEP seconds apart (default 2).
# shellcheck disable=SC2015  # A && B || fail is the idiom here
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
LINKAGE=${CALLUM_FLOW_LINKAGE_BIN:-/usr/local/share/callum-tools/check-pr-linkage.sh}
ROLLOUT=${CALLUM_FLOW_ROLLOUT_BIN:-callum-flow-rollout}
READ=${CALLUM_FLOW_ISSUE_READ_BIN:-callum-flow-issue-read}
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
WEAKENING=${CALLUM_FLOW_WEAKENING_BIN:-$here/callum-flow-test-weakening}
PATCH_ID=${CALLUM_FLOW_PATCH_ID_BIN:-$here/callum-flow-patch-id}

usage() {
  [ -z "${1-}" ] || echo "callum-flow-merge-guard: $1" >&2
  echo "usage: callum-flow-merge-guard <pr> --patch ID [--expect closing|refs] [--base BRANCH] [--issue N] [--emit-verified] [--tested-tree SHA]" >&2
  exit 2
}

pr='' expect='' base='' issue='' emit='' patch='' tested_tree=''
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage ;;
    --emit-verified) emit=1 ;;
    --expect | --base | --issue | --patch | --tested-tree)
      [ $# -ge 2 ] || usage "$1 needs a value"
      case "$1" in
        --expect) expect=$2 ;;
        --base) base=$2 ;;
        --issue) issue=$2 ;;
        --patch) patch=$2 ;;
        --tested-tree) tested_tree=$2 ;;
      esac
      shift
      ;;
    -*) usage "unknown option '$1'" ;;
    *) [ -z "$pr" ] || usage "unexpected argument '$1'"; pr=$1 ;;
  esac
  shift
done
[ -n "$pr" ] || usage "missing <pr>"
case "$pr" in *[!0-9]*) usage "<pr> must be a number" ;; esac
case "$expect" in "" | closing | refs) ;; *) usage "--expect must be closing or refs" ;; esac
case "$issue" in *[!0-9]*) usage "--issue must be a number" ;; esac
command -v jq > /dev/null 2>&1 || usage "jq not found"
[ -n "$patch" ] || usage "--patch ID is required"
printf '%s\n' "$patch" | grep -Eqx '[0-9a-f]{40}|[0-9a-f]{64}' || usage "--patch must be a patch id (40 or 64 hex characters)"
[ -z "$tested_tree" ] || printf '%s\n' "$tested_tree" | grep -Eqx '[0-9a-f]{40}' || usage "--tested-tree must be a tree sha (40 lowercase hex characters)"

failed=0
# fail <guard> <reason> <class>: one FAIL line ending with the class the loop acts on
# (behind, conflict, checks, patch, linkage, read or policy)
fail() {
  failed=1
  printf 'GUARD %s FAIL %s class=%s\n' "$1" "$2" "${3:-read}"
}

# one_line: collapse stdin to a single trimmed line
one_line() { tr '\n' ' ' | sed 's/[[:space:]]*$//'; }
clean() { awk '{gsub(/\033\[[0-9;]*m/, ""); print}'; }

# A read of GitHub's keeps its stderr in $errf, and said names it in the read's FAIL reason, so a
# reason says why it could not read (a 5xx or a timeout reads as GitHub's, v2 SPEC 5.1).
errf=$(mktemp) || errf=/dev/null
trap '[ "$errf" = /dev/null ] || rm -f "$errf"' EXIT
# said: ": <what the last read printed on stderr>", on one line and capped; nothing if it printed none
said() { _s=$(clean < "$errf" | one_line | cut -c1-300); [ -z "$_s" ] || printf ': %s' "$_s"; }

branch='' pr_head='' pr_base='' pj=''
if pj=$($GH pr view "$pr" --json headRefName,headRefOid,baseRefName,state,isDraft,mergeable,mergeStateStatus 2> "$errf"); then
  branch=$(printf '%s' "$pj" | jq -r '.headRefName // empty')
  pr_head=$(printf '%s' "$pj" | jq -r '.headRefOid // empty')
  pr_base=$(printf '%s' "$pj" | jq -r '.baseRefName // empty')
fi
pj_said=$(said)

mtries=${CALLUM_FLOW_MERGEABLE_TRIES:-5}
msleep=${CALLUM_FLOW_MERGEABLE_SLEEP:-2}
case "$mtries" in '' | *[!0-9]*) mtries=5 ;; esac
case "$msleep" in '' | *[!0-9.]*) msleep=2 ;; esac
[ "$mtries" -ge 1 ] || mtries=1

default_branch=$($GH repo view --json defaultBranchRef -q .defaultBranchRef.name 2> "$errf") || default_branch=''
default_said=$(said)

# --- author ------------------------------------------------------------------
# Only a PR opened by a trusted author is read any further (the reader exits 3
# for an untrusted author and 1 when it cannot tell; both fail closed).
author_ok=1
"$READ" --json --pr "$pr" > /dev/null 2> "$errf"
a_rc=$?
if [ "$a_rc" -eq 3 ]; then
  author_ok=0
  fail author "PR #$pr was not opened by a trusted author" policy
elif [ "$a_rc" -ne 0 ]; then
  author_ok=0
  fail author "cannot verify the author of PR #$pr (reader exit $a_rc)$(said)" read
fi

# --- rollout -----------------------------------------------------------------
# The linkage expectation follows the issue's Rollout, not the caller's memory:
# #236 closed #219 (a Run it issue) because the default was closing.
explicit=$expect
r_issue=$issue
[ -n "$r_issue" ] || r_issue=$(printf '%s' "$branch" | sed -n 's/.*issue-\([0-9][0-9]*\)\(-.*\)\{0,1\}$/\1/p')
rollout_ok=1
if [ "$author_ok" -eq 0 ]; then
  rollout_ok=0
elif [ -z "$r_issue" ]; then
  if [ -z "$explicit" ]; then
    fail rollout "no issue in the branch name, pass --issue N (or --expect to assert linkage)" policy
    rollout_ok=0
  fi
else
  r_out=$("$ROLLOUT" "$r_issue" 2> "$errf")
  r_rc=$?
  r_line=$(printf '%s\n' "$r_out" | sed -n 1p)
  derived=''
  if [ "$r_rc" -eq 0 ]; then
    case "$r_line" in
      "ROLLOUT merge "*) derived=closing ;;
      "ROLLOUT run-it "* | "ROLLOUT keep-open "*) derived=refs ;;
    esac
  fi
  if [ -z "$derived" ]; then
    fail rollout "cannot derive the Rollout of #$r_issue: ${r_line:-exit $r_rc, no output}$(said)" read
    rollout_ok=0
  elif [ -z "$explicit" ]; then
    expect=$derived
  elif [ "$explicit" != "$derived" ]; then
    fail rollout "--expect $explicit contradicts #$r_issue: $r_line (needs $derived)" policy
  fi
fi

# --- linkage -----------------------------------------------------------------
if [ "$rollout_ok" -eq 1 ]; then
lk_out=$("$LINKAGE" "$pr" --expect "$expect" 2> "$errf")
lk_rc=$?
lk_line=$(printf '%s\n' "$lk_out" | sed -n 1p)
case "$lk_line" in
  MATCH*) [ "$lk_rc" -eq 0 ] || fail linkage "exit $lk_rc: $lk_line$(said)" read ;;
  SKIP*)
    if [ "$lk_rc" -ne 0 ]; then
      fail linkage "${lk_line:-no output}" linkage
    elif [ -z "$issue" ]; then
      fail linkage "$lk_line (branch names no issue, pass --issue N)" linkage
    else
      lj=$($GH pr view "$pr" --json body,closingIssuesReferences 2> "$errf") || lj=''
      api=$(printf '%s' "$lj" | jq -r '[.closingIssuesReferences[]?.number] | sort | join(",")' 2> /dev/null) || api=x
      body_t=$(printf '%s' "$lj" | jq -r '.body // ""' 2> /dev/null |
        grep -oiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]*:?[[:space:]]*([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+' |
        sed -E 's/^[A-Za-z]+[[:space:]]*:?[[:space:]]*//' | sort -u | tr '\n' ',' | sed 's/,$//')
      has_ref=$(printf '%s' "$lj" | jq -r '.body // ""' 2> /dev/null | grep -ciE "\\b(Refs|Part of)[[:space:]]+#$issue\\b")
      if [ -z "$lj" ] || [ "$api" = x ]; then
        fail linkage "cannot read PR #$pr body$(said)" read
      elif [ "$expect" = closing ]; then
        if [ "$body_t" != "#$issue" ] || { [ "$pr_base" = "$default_branch" ] && [ "$api" != "$issue" ]; }; then
          fail linkage "$lk_line (PR must close exactly #$issue: api=[$api] body=[$body_t])" linkage
        fi
      elif [ -n "$api" ] || [ -n "$body_t" ] || [ "${has_ref:-0}" -eq 0 ]; then
        fail linkage "$lk_line (PR must reference #$issue with Refs or Part of and close nothing: api=[$api] body=[$body_t])" linkage
      fi
    fi
    ;;
  *)
    # no report at all is a fact not read; a report is a linkage that does not match
    lk_class=linkage
    [ -n "$lk_line" ] || lk_class='read'
    fail linkage "${lk_line:-exit $lk_rc, no output$(said)}" "$lk_class"
    ;;
esac
fi
if [ -z "$issue" ]; then
  issue=$(printf '%s' "${lk_line-}" | sed -n 's/.* issue=#\([0-9][0-9]*\).*/\1/p')
fi

# --- checks ------------------------------------------------------------------
if cj=$($GH pr checks "$pr" --json name,bucket 2> "$errf") || [ -n "${cj-}" ]; then
  if ! printf '%s' "$cj" | jq -e 'type == "array"' > /dev/null 2>&1; then
    fail checks "cannot parse checks$(said)" read
  elif [ "$(printf '%s' "$cj" | jq 'length')" = 0 ]; then
    fail checks "no checks reported" checks
  else
    bad=$(printf '%s' "$cj" | jq -r '[.[] | select(.bucket != "pass" and .bucket != "skipping") | "\(.name)=\(.bucket)"] | join(", ")')
    [ -z "$bad" ] || fail checks "$bad" checks
  fi
else
  fail checks "cannot read checks$(said)" read
fi
# a workflow run whose jobs have no check yet (queued on a concurrency group) is in no `gh pr checks`
# view, so the head's workflow runs are read too: the latest run per workflow and event must be done
if [ -z "$pr_head" ]; then
  fail checks "cannot read workflow runs: no PR head" read
elif rj=$($GH api "repos/{owner}/{repo}/actions/runs?head_sha=$pr_head&per_page=100" 2> "$errf"); then
  if ! printf '%s' "$rj" | jq -e '(.workflow_runs | type == "array") and (.total_count | type == "number") and (.total_count <= (.workflow_runs | length))' > /dev/null 2>&1; then
    fail checks "cannot read workflow runs whole$(said)" read
  else
    bad=$(printf '%s' "$rj" | jq -r '[.workflow_runs | group_by([.workflow_id, .event])[] | max_by(.id)
      | (if .status != "completed" then "pending"
         elif (.conclusion == "success" or .conclusion == "skipped" or .conclusion == "neutral") then "pass"
         elif .conclusion == "cancelled" then "cancel"
         else "fail" end) as $k
      | select($k != "pass") | "workflow \(.name // .path)=\($k)"] | join(", ")')
    [ -z "$bad" ] || fail checks "$bad" checks
  fi
else
  fail checks "cannot read workflow runs$(said)" read
fi

# --- test-weakening ----------------------------------------------------------
# Advisory only (cbundy/dev-system#314): never sets failed, and a detector
# problem is itself only a WARN, so a detector bug cannot block a merge.
weakened=''
# (skipped when the author or base guard already failed: nothing is merging)
if [ "$author_ok" -eq 1 ] && [ -n "$pr_base" ] && [ -n "$pr_head" ] &&
  { [ "$pr_base" = "$default_branch" ] || [ "$pr_base" = "$base" ]; }; then
  w_rc=0 w_out=''
  if git fetch --quiet origin "+refs/heads/$pr_base:refs/remotes/origin/$pr_base" 2> /dev/null; then
    w_out=$("$WEAKENING" --base "origin/$pr_base" --head "$pr_head" 2>&1) || w_rc=$?
  else
    w_rc=1 w_out="cannot fetch origin/$pr_base"
  fi
  if [ "$w_rc" -ne 0 ]; then
    printf 'GUARD test-weakening WARN detector error: %s\n' "$(printf '%s' "$w_out" | one_line)"
  else
    weakened=$(printf '%s\n' "$w_out" | grep '^WEAKENED ')
    printf '%s\n' "$weakened" | grep '^WEAKENED commit=.* restored=no ' | while IFS= read -r w_line; do
      w_commit=$(printf '%s' "$w_line" | sed 's/^WEAKENED commit=\([^ ]*\) .*/\1/')
      w_files=$(printf '%s' "$w_line" | sed 's/.* files=\(.*\) kinds=.*/\1/')
      w_kinds=$(printf '%s' "$w_line" | sed 's/.* kinds=//')
      printf 'GUARD test-weakening WARN %.7s files=%s kinds=%s - have the adjudicator judge it against the brief; restore via fixer unless the removal is justified\n' "$w_commit" "$w_files" "$w_kinds"
    done
  fi
fi

# --- patch -------------------------------------------------------------------
# The PR head's patch id against the default branch is the one the loop approved (v2 SPEC 8.4),
# so a clean merge of the base keeps the approval and any other change to the PR's lines fails.
if [ -z "$pr_head" ]; then
  fail patch "cannot read the PR head, so its patch id was not computed$pj_said" read
elif [ -z "$default_branch" ]; then
  fail patch "cannot read the default branch, so the patch id of $pr_head was not computed$default_said" read
elif ! p_out=$("$PATCH_ID" "$pr_head" "$default_branch" 2>&1); then
  fail patch "patch id of $pr_head not computed: $(printf '%s' "$p_out" | one_line)" read
elif [ "$p_out" != "$patch" ]; then
  fail patch "head $pr_head has patch $p_out, not the approved $patch" patch
fi

# --- tree (--tested-tree only) -------------------------------------------------------------
# The merge of the PR head onto the base as it is now must give exactly the tree CI passed, so a
# base that moved without changing that result (or a train that already carries it) still merges.
if [ -n "$tested_tree" ]; then
  if [ -z "$pr_head" ] || [ -z "$pr_base" ]; then
    fail tree "cannot read the PR head or base, so the merge tree was not computed$pj_said" read
  elif ! git fetch --quiet origin "+refs/heads/$pr_base:refs/remotes/origin/$pr_base" 2> "$errf"; then
    fail tree "cannot fetch origin/$pr_base$(said)" read
  elif ! git fetch --quiet origin "$pr_head" 2> "$errf" && ! git cat-file -e "$pr_head^{commit}" 2> /dev/null; then
    fail tree "cannot fetch the PR head $pr_head$(said)" read
  else
    t_rc=0
    t_out=$(git merge-tree --write-tree "origin/$pr_base" "$pr_head" 2> "$errf") || t_rc=$?
    t_tree=$(printf '%s\n' "$t_out" | sed -n 1p)
    if [ "$t_rc" -eq 1 ]; then
      fail tree "merging $pr_head onto origin/$pr_base conflicts, so no tree can match the tested $tested_tree" behind
    elif [ "$t_rc" -ne 0 ] || ! printf '%s\n' "$t_tree" | grep -Eqx '[0-9a-f]{40}'; then
      fail tree "cannot compute the merge tree of $pr_head onto origin/$pr_base (exit $t_rc)$(said)" read
    elif [ "$t_tree" != "$tested_tree" ]; then
      fail tree "merging $pr_head onto origin/$pr_base gives tree $t_tree, not the tested $tested_tree" behind
    fi
  fi
fi

# --- base --------------------------------------------------------------------
if [ -z "$pr_base" ]; then
  fail base "cannot read the PR base$pj_said" read
else
  default=$default_branch
  if [ "$pr_base" != "$default" ] && [ "$pr_base" != "$base" ]; then
    fail base "PR targets $pr_base, default branch is ${default:-unknown}${base:+, --base is $base}; if the PR intentionally targets an epic/integration branch, confirm that with the brief and rerun with --base $pr_base" policy
  fi
fi

# --- mergeable ---------------------------------------------------------------
# mergeStateStatus, not mergeable: a BEHIND PR still reports MERGEABLE, yet
# strict branch protection refuses it (cbundy/dev-system#246).
mbase=${pr_base:-its base}
mj=$pj
mj_said=$pj_said
mtry=1
while :; do
  mstate='' mmerge='' mmss='' mreason='' mclass=read mverdict=unknown
  if [ -z "$mj" ]; then
    mverdict=fail mreason="cannot read merge state$mj_said"
  else
    mstate=$(printf '%s' "$mj" | jq -r '.state // empty' 2> /dev/null)
    mmerge=$(printf '%s' "$mj" | jq -r '.mergeable // empty' 2> /dev/null)
    mmss=$(printf '%s' "$mj" | jq -r '.mergeStateStatus // empty' 2> /dev/null)
    mdraft=$(printf '%s' "$mj" | jq -r '.isDraft // empty' 2> /dev/null)
    if [ -z "$mstate" ]; then
      :
    elif [ "$mstate" != OPEN ]; then
      mverdict=fail mreason="PR is $mstate"
    elif [ "$mdraft" = true ] || [ "$mmss" = DRAFT ]; then
      mverdict=fail mreason="PR is a draft" mclass=policy
    elif [ "$mmss" = DIRTY ] || [ "$mmerge" = CONFLICTING ]; then
      mverdict=fail mreason="conflicts with $mbase" mclass=conflict
    else
      case "$mmss" in
        BEHIND) if [ -n "$tested_tree" ]; then mverdict=pass; else mverdict=fail mreason="behind $mbase" mclass=behind; fi ;;
        BLOCKED) mverdict=fail mreason="branch rules not met (required checks or reviews); read which rule is unmet, never use --admin" ;;
        CLEAN | UNSTABLE | HAS_HOOKS) mverdict=pass ;;
      esac
    fi
  fi
  [ "$mverdict" = unknown ] || break
  if [ "$mtry" -ge "$mtries" ]; then
    mverdict=fail mreason="GitHub has not computed mergeability, retry"
    break
  fi
  mtry=$((mtry + 1))
  sleep "$msleep"
  mj=$($GH pr view "$pr" --json state,isDraft,mergeable,mergeStateStatus 2> "$errf") || mj=''
  mj_said=$(said)
done
[ "$mverdict" != fail ] || fail mergeable "$mreason" "$mclass"

[ "$failed" -eq 0 ] || exit 1
if [ -n "$emit" ]; then
  close_issue=''
  if [ "$pr_base" != "$default_branch" ] && [ "$expect" = closing ]; then
    close_issue=$issue
  fi
  [ -z "$weakened" ] || printf '%s\n' "$weakened"
  printf 'VERIFIED pr=%s branch=%s head=%s run= issue=%s close_issue=%s gated_patch= rebased_from=\n' "$pr" "$branch" "$pr_head" "$issue" "$close_issue"
fi
exit 0
