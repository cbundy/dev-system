#!/bin/sh
#
# callum-flow-merge-guard: check that a PR is safe to merge (cbundy/dev-system#219).
# Checking is read-only; callum-flow-merge is the separate command that merges.
# --update-behind is the guard's one writing mode: only the orchestrator runs it,
# implementers and fixers never do. The mode reference is in images/base/README.md.
#
# Usage: callum-flow-merge-guard <pr> [--expect closing|refs] [--run ID]
#          [--base BRANCH] [--issue N] [--emit-verified]
#        callum-flow-merge-guard <pr> --update-behind [--run ID] [--base BRANCH]
#   --update-behind is the one mode that writes (cbundy/dev-system#476): for a PR that is
#   only BEHIND its base it rebases the branch in a throwaway worktree, proves the patch
#   is unchanged against the gated run's head, and pushes with a lease on the old head.
#   It never starts, aborts or reruns a no-mistakes run. See the 'update-behind' section.
#   Without --expect, the linkage expectation comes from the issue's Rollout
#   (callum-flow-rollout): merge means closing, run-it and keep-open mean refs
#   (cbundy/dev-system#239). Pass --expect only to assert it; a value that
#   contradicts the Rollout fails the rollout guard.
#
# Checking guards (--update-behind exits separately; every guard is evaluated and
# reported, none short-circuits, except that a
# PR by an untrusted author is read no further: rollout and linkage are skipped):
#   author   the PR was opened by a trusted author (callum-flow-issue-read,
#          cbundy/dev-system#310); an untrusted or unverifiable author fails
#   rollout  the issue's Rollout was derived (or agrees with --expect); a
#          conflict or a failure to derive fails closed, never to closing
#   head     the run's head_sha equals a fresh origin/<branch>, the PR head,
#          and HEAD in every worktree checked out on the PR branch. A rebase-only
#          difference also passes (cbundy/dev-system#476): the run finished cleanly
#          and git patch-id --verbatim over its commits equals the PR's, in order, and
#          each worktree on the branch holds no commit the run lacks (a lagging or
#          pre-rebase copy passes, cbundy/dev-system#627). The guard then prints
#            GUARD head PASS gated_patch=<id> rebased_from=<run head>
#   linkage  check-pr-linkage.sh reports MATCH; on SKIP (no issue in the branch
#          name) --issue N is required and the PR must link #N as --expect says
#   checks   at least one CI check, all pass or skipping
#   gates    the run has no step parked at a gate and is not failed or aborted
#   base     the PR targets the default branch, or --base BRANCH
#   mergeable  GitHub would merge it now: open, not a draft, not conflicting,
#          not behind its base, branch rules met (cbundy/dev-system#246)
#   test-weakening  advisory, never fails the guard (cbundy/dev-system#314):
#          callum-flow-test-weakening scans origin/<pr base>..<pr head> for
#          commits that delete or weaken tests; each one it cannot see restored
#          prints a WARN line (below). A detector error is also a WARN.
#
# Checking output: a head PASS line on a patch proof, plus one line per failed guard,
#   GUARD <name> FAIL <reason>
# Advisory lines can appear with exit 0 and never change the exit code:
#   GUARD test-weakening WARN <sha7> step=<s> files=<f> kinds=<k> - <what to do>
#   GUARD test-weakening WARN detector error: <reason>
# The orchestrator sends every WARN to the adjudicator before merging.
# --emit-verified adds, on success only, the detector's WEAKENED lines verbatim
# (restored ones included, for the test_weakened event) and then one line for
# callum-flow-merge:
#   VERIFIED pr=N branch=B head=SHA run=ID issue=N close_issue=N gated_patch=ID rebased_from=SHA
# gated_patch and rebased_from are empty unless the head passed on the patch proof.
# close_issue is the issue to close manually for a closing PR on a non-default
# base; it is empty otherwise.
#
# Exit codes: 0 all guards pass or update succeeds, 1 a guard fails or update fails
# or skips, 2 usage error.
#
# Recovery guidance for head, base and mergeable failures is in their FAIL lines.
#
# Environment (for tests): CALLUM_FLOW_GH_BIN (gh), CALLUM_FLOW_NM_BIN
# (no-mistakes), CALLUM_FLOW_LINKAGE_BIN (check-pr-linkage.sh),
# CALLUM_FLOW_WATCH_BIN (pipeline-watch.sh, whose --resolve finds the run),
# CALLUM_FLOW_ROLLOUT_BIN (callum-flow-rollout), CALLUM_FLOW_ISSUE_READ_BIN
# (callum-flow-issue-read), CALLUM_FLOW_WEAKENING_BIN
# (callum-flow-test-weakening).
# Tuning: GitHub computes mergeability lazily and reports UNKNOWN meanwhile, so
# the mergeable guard and --update-behind re-read (read-only) CALLUM_FLOW_MERGEABLE_TRIES
# times (default 5) CALLUM_FLOW_MERGEABLE_SLEEP seconds apart (default 2).
# shellcheck disable=SC2015  # A && B || fail is the idiom here
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
NM=${CALLUM_FLOW_NM_BIN:-no-mistakes}
LINKAGE=${CALLUM_FLOW_LINKAGE_BIN:-/usr/local/share/callum-tools/check-pr-linkage.sh}
WATCH=${CALLUM_FLOW_WATCH_BIN:-/usr/local/share/callum-tools/pipeline-watch.sh}
ROLLOUT=${CALLUM_FLOW_ROLLOUT_BIN:-callum-flow-rollout}
READ=${CALLUM_FLOW_ISSUE_READ_BIN:-callum-flow-issue-read}
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
WEAKENING=${CALLUM_FLOW_WEAKENING_BIN:-$here/callum-flow-test-weakening}

usage() {
  [ -z "${1-}" ] || echo "callum-flow-merge-guard: $1" >&2
  echo "usage: callum-flow-merge-guard <pr> [--expect closing|refs] [--run ID] [--base BRANCH] [--issue N] [--emit-verified] | <pr> --update-behind [--run ID] [--base BRANCH]" >&2
  exit 2
}

pr='' expect='' run='' base='' issue='' emit='' update_behind=
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage ;;
    --emit-verified) emit=1 ;;
    --update-behind) update_behind=1 ;;
    --expect | --run | --base | --issue)
      [ $# -ge 2 ] || usage "$1 needs a value"
      case "$1" in
        --expect) expect=$2 ;;
        --run) run=$2 ;;
        --base) base=$2 ;;
        --issue) issue=$2 ;;
      esac
      shift
      ;;
    -*) usage "unknown option '$1'" ;;
    *) [ -z "$pr" ] || usage "unexpected argument '$1'"; pr=$1 ;;
  esac
  shift
done
[ -n "$pr" ] || usage "missing <pr>"
case "$pr" in *[!0-9]*) usage "<pr> must be a number" ;; esac
case "$expect" in "" | closing | refs) ;; *) usage "--expect must be closing or refs" ;; esac
case "$issue" in *[!0-9]*) usage "--issue must be a number" ;; esac
command -v jq > /dev/null 2>&1 || usage "jq not found"
[ -z "$update_behind" ] || { [ -z "$emit" ] && [ -z "$expect" ] && [ -z "$issue" ]; } || usage "--update-behind takes only --run and --base"

failed=0
fail() {
  failed=1
  printf 'GUARD %s FAIL %s\n' "$1" "$2"
}

# one_line: collapse stdin to a single trimmed line
one_line() { tr '\n' ' ' | sed 's/[[:space:]]*$//'; }
clean() { awk '{gsub(/\033\[[0-9;]*m/, ""); print}'; }
field() { printf '%s\n' "$1" | sed -n "s/^[[:space:]]*$2:[[:space:]]*//p" | sed -n 1p | tr -d '"'; }

# run_clean: the run reached ci and every step before it finished (completed or
# skipped), and the run itself is not failed, aborted or cancelled (#476). Reads
# the 'step,status' rows of `axi status`.
run_clean() {
  case "$(field "$1" status)" in '' | *failed* | *aborted* | *cancel*) return 1 ;; esac
  printf '%s\n' "$1" | awk '
    /^[[:space:]]+[a-z][a-z_-]*,[a-z_]+/ {
      sub(/^[[:space:]]+/, ""); split($0, f, ",")
      if (f[1] == "ci") { seen = 1; exit }
      if (f[2] != "completed" && f[2] != "skipped") bad = 1
    }
    END { exit (seen && !bad) ? 0 : 1 }'
}

# patch_ids <base> <head>: the verbatim patch id of every commit in base..head, oldest
# first. Fails on a merge commit or an empty range (nothing to prove).
patch_ids() {
  [ -z "$(git rev-list --merges "$1..$2" 2> /dev/null)" ] || return 1
  _ids=$(git log -p --reverse "$1..$2" 2> /dev/null | git patch-id --verbatim | cut -d' ' -f1)
  [ -n "$_ids" ] || return 1
  printf '%s\n' "$_ids"
}

# patch_proof <run head> <new head> <base>: sets proof_id when git patch-id --verbatim over
# <run head>'s commits (from its merge-base with origin/<base>) equals the same over
# <new head>'s, in order. Sets proof_why and fails closed otherwise (#476).
proof_id='' proof_why=''
patch_proof() {
  proof_id='' proof_why=''
  git fetch --quiet origin "+refs/heads/$3:refs/remotes/origin/$3" 2> /dev/null || { proof_why="cannot fetch origin/$3"; return 1; }
  git cat-file -e "$1^{commit}" 2> /dev/null || git fetch --quiet origin "$1" 2> /dev/null || true
  git cat-file -e "$1^{commit}" 2> /dev/null || { proof_why="run head $1 is not available locally"; return 1; }
  _ob=$(git merge-base "$1" "origin/$3" 2> /dev/null) && _nb=$(git merge-base "$2" "origin/$3" 2> /dev/null) || { proof_why="no merge-base with origin/$3"; return 1; }
  _oi=$(patch_ids "$_ob" "$1") && _ni=$(patch_ids "$_nb" "$2") || { proof_why="cannot compute patch ids (merge commit or no commits)"; return 1; }
  [ "$_oi" = "$_ni" ] || { proof_why="patch changed by the rebase"; return 1; }
  proof_id=$(printf '%s\n' "$_oi" | git hash-object --stdin) || return 1
}

# worktree_gated <worktree head> <run head> <origin head> <base>: after a patch proof (#627),
# the worktree holds no commit the gated run lacks. Each commit it has that the run head,
# origin/<branch> and origin/<base> lack must be a non-merge commit that is a copy of its own
# run commit: one the worktree does not already contain, with the same zero-context patch id
# (zero context, so main changing lines near a gated hunk before a rebase does not count), and
# no run commit stands for two worktree commits. A slot that lags (the loop's update-behind
# leaves every slot behind the new head) or sits on a copy of the branch from before a rebase
# passes; a commit made outside the pipeline, an empty one or a second copy of a gated change
# included, does not. Call only after patch_proof.
u0_id() { git show -p -U0 --no-color --no-ext-diff --no-textconv --format= "$1" 2> /dev/null | git patch-id --verbatim | cut -d' ' -f1; }
worktree_gated() {
  case "$1" in '' | unknown) return 1 ;; esac
  _only=$(git rev-list "$1" --not "$2" "$3" "origin/$4" 2> /dev/null) || return 1
  [ -n "$_only" ] || return 0
  _rb=$(git merge-base "$2" "origin/$4" 2> /dev/null) && _run=$(git rev-list --no-merges "$_rb..$2" 2> /dev/null) || return 1
  _free=''
  for _r in $_run; do
    git merge-base --is-ancestor "$_r" "$1" 2> /dev/null && continue
    _id=$(u0_id "$_r")
    [ -z "$_id" ] || _free="$_free $_id "
  done
  for _c in $_only; do
    [ -z "$(git rev-list --no-walk --merges "$_c" 2> /dev/null)" ] || return 1
    _id=$(u0_id "$_c")
    case "$_id" in '' | *[!0-9a-f]*) return 1 ;; esac
    case "$_free" in *" $_id "*) _free="${_free%%" $_id "*} ${_free#*" $_id "}" ;; *) return 1 ;; esac
  done
}

branch='' pr_head='' pr_base='' pj=''
if pj=$($GH pr view "$pr" --json headRefName,headRefOid,baseRefName,state,isDraft,mergeable,mergeStateStatus 2> /dev/null); then
  branch=$(printf '%s' "$pj" | jq -r '.headRefName // empty')
  pr_head=$(printf '%s' "$pj" | jq -r '.headRefOid // empty')
  pr_base=$(printf '%s' "$pj" | jq -r '.baseRefName // empty')
fi

# --- run lookup (head and gates) ---------------------------------------------
status_out=''
if [ -n "$branch" ]; then
  if [ -z "$run" ]; then
    # the watcher owns the branch -> run lookup (cbundy/dev-system#243)
    if run=$("$WATCH" --resolve "$branch" 2> /dev/null) && [ -n "$run" ]; then
      status_out=$($NM axi status --run "$run" 2> /dev/null | clean) || status_out=''
    else
      run=''
    fi
  else
    status_out=$($NM axi status --run "$run" 2> /dev/null | clean) || status_out=''
  fi
fi

# Recovery instructions belong in the head and mergeable FAIL lines below.
HEAD_FIX="fix: if only a worktree lags the branch (the run already equals origin), run 'git merge --ff-only origin/<branch>' there; while a gate is parked and a correction is needed, prefer backgrounded 'no-mistakes axi respond --action fix' with instructions so the pipeline stays the sole writer on the run's own head; use an external fixer only when the pipeline cannot write the correction from instructions or the run is done; only for a commit made outside the pipeline, rebase onto origin/<branch> keeping the pipeline's commits, 'no-mistakes axi abort', start a fresh backgrounded 'axi run --intent ...' and prove its head equals the new commit ('rerun' re-gates the OLD head and 'axi run' on a live run only attaches to it)"
REBASE_FIX="in a fresh slot on the branch run 'git rebase origin/<base>' keeping the pipeline's commits, then 'callum-flow-regate --issue <N>', 'no-mistakes axi abort', a fresh backgrounded 'axi run --intent ...', and prove the new run's head equals the rebased HEAD (the no-mistakes CI monitor does not rebase a PR that is only behind)"
BEHIND_FIX="run 'callum-flow-merge-guard <pr> --update-behind' first (a clean rebase with an unchanged patch needs no new run); only if it fails, re-gate: $REBASE_FIX"

mtries=${CALLUM_FLOW_MERGEABLE_TRIES:-5}
msleep=${CALLUM_FLOW_MERGEABLE_SLEEP:-2}
case "$mtries" in '' | *[!0-9]*) mtries=5 ;; esac
case "$msleep" in '' | *[!0-9.]*) msleep=2 ;; esac
[ "$mtries" -ge 1 ] || mtries=1

# --- update-behind -----------------------------------------------------------
# The one writing mode (cbundy/dev-system#476). A PR that is only BEHIND its base
# keeps its gated work, so rebase it and prove that instead of paying a full re-gate.
# Fails closed (exit 1, nothing pushed) to a full re-gate (UPDATE-BEHIND FAIL) on: a
# conflicting PR, an unfinished or unclean run, a missing run head, a rebase conflict,
# a patch mismatch, or a lost lease. A PR that cannot be read, targets another base,
# is not behind, or whose merge state GitHub has not computed (re-read like the
# mergeable guard) pushes nothing either but needs no re-gate (UPDATE-BEHIND SKIP).
# Never touches the no-mistakes run.
if [ -n "$update_behind" ]; then
  ub_fail() { printf 'UPDATE-BEHIND FAIL %s; fall back to a full re-gate: %s\n' "$1" "$REBASE_FIX"; exit 1; }
  ub_skip() { printf 'UPDATE-BEHIND SKIP %s\n' "$1"; exit 1; }
  [ -n "$branch" ] || ub_skip "cannot read PR #$pr, retry"
  default_branch=$($GH repo view --json defaultBranchRef -q .defaultBranchRef.name 2> /dev/null) || default_branch=''
  [ "$pr_base" = "$default_branch" ] || [ "$pr_base" = "$base" ] || ub_skip "PR targets $pr_base, not the default branch${base:+ or --base $base}; pass --base $pr_base if that is intended"
  ub_j=$pj
  ub_try=1
  while :; do
    ub_state=$(printf '%s' "$ub_j" | jq -r '.state // empty' 2> /dev/null)
    ub_mss=$(printf '%s' "$ub_j" | jq -r '.mergeStateStatus // empty' 2> /dev/null)
    ub_merge=$(printf '%s' "$ub_j" | jq -r '.mergeable // empty' 2> /dev/null)
    case "$ub_state:$ub_mss:$ub_merge" in
      :*) ;;
      OPEN:*:CONFLICTING | OPEN:DIRTY:*) ub_fail "PR conflicts with $pr_base" ;;
      OPEN:BEHIND:*) break ;;
      OPEN::* | OPEN:UNKNOWN:*) ;;
      *) ub_skip "PR is not behind its base (state=$ub_state mergeStateStatus=$ub_mss mergeable=$ub_merge), nothing to rebase; re-run the guard" ;;
    esac
    [ "$ub_try" -lt "$mtries" ] || ub_skip "GitHub has not computed mergeability, retry"
    ub_try=$((ub_try + 1))
    sleep "$msleep"
    ub_j=$($GH pr view "$pr" --json state,isDraft,mergeable,mergeStateStatus 2> /dev/null) || ub_j=''
  done
  [ -n "$status_out" ] || ub_fail "no pipeline run found for $branch"
  run_clean "$status_out" || ub_fail "run $run did not finish cleanly"
  ub_run_sha=$(field "$status_out" head_sha)
  [ -n "$ub_run_sha" ] || ub_fail "run $run reports no head_sha"
  git fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2> /dev/null || ub_fail "cannot fetch origin/$branch"
  [ "$(git rev-parse --verify --quiet "refs/remotes/origin/$branch^{commit}")" = "$pr_head" ] || ub_fail "origin/$branch is not the PR head $pr_head"
  git fetch --quiet origin "+refs/heads/$pr_base:refs/remotes/origin/$pr_base" 2> /dev/null || ub_fail "cannot fetch origin/$pr_base"
  git cat-file -e "$ub_run_sha^{commit}" 2> /dev/null || git fetch --quiet origin "$ub_run_sha" 2> /dev/null || true
  git cat-file -e "$ub_run_sha^{commit}" 2> /dev/null || ub_fail "run head $ub_run_sha is not available locally"
  ub_dir=$(mktemp -d) || ub_fail "cannot make a scratch directory"
  git worktree add --quiet --detach "$ub_dir/wt" "$pr_head" > /dev/null 2>&1 || { rm -rf "$ub_dir"; ub_fail "cannot create a scratch worktree"; }
  ub_done() { git worktree remove --force "$ub_dir/wt" > /dev/null 2>&1; rm -rf "$ub_dir"; git worktree prune > /dev/null 2>&1; }
  if ! git -C "$ub_dir/wt" rebase --quiet "origin/$pr_base" > /dev/null 2>&1; then
    git -C "$ub_dir/wt" rebase --abort > /dev/null 2>&1
    ub_done
    ub_fail "the rebase onto origin/$pr_base needs manual resolution"
  fi
  ub_new=$(git -C "$ub_dir/wt" rev-parse HEAD)
  # the worktree shares this repo's object store, so the proof runs from here
  if ! patch_proof "$ub_run_sha" "$ub_new" "$pr_base"; then
    ub_why=$proof_why
    ub_done
    ub_fail "$ub_why"
  fi
  if ! git -C "$ub_dir/wt" push --quiet "--force-with-lease=refs/heads/$branch:$pr_head" origin "HEAD:refs/heads/$branch" > /dev/null 2>&1; then
    ub_done
    ub_fail "the push lost its lease on $pr_head (the branch moved)"
  fi
  ub_done
  printf 'UPDATED pr=%s branch=%s from=%s to=%s run=%s gated_patch=%s rebased_from=%s\n' "$pr" "$branch" "$pr_head" "$ub_new" "$run" "$proof_id" "$ub_run_sha"
  exit 0
fi

# --- head --------------------------------------------------------------------
if [ -z "$branch" ]; then
  fail head "cannot read PR #$pr"
elif [ -z "$status_out" ]; then
  fail head "no pipeline run found for $branch"
else
  run_sha=$(field "$status_out" head_sha)
  origin_sha=unknown
  if git fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2> /dev/null; then
    origin_sha=$(git rev-parse --verify --quiet "refs/remotes/origin/$branch^{commit}" 2> /dev/null) || origin_sha=unknown
  fi
  worktree_heads=$(git worktree list --porcelain 2> /dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && substr($0, 8) == b { print p }
  ' | while IFS= read -r path; do
    git -C "$path" rev-parse --verify --quiet 'HEAD^{commit}' 2> /dev/null || printf '%s\n' unknown
  done)
  # A rebase-only difference (#476): origin is the PR head, the run finished cleanly
  # and the patch is the same, so the gated work is what would merge.
  gated_patch='' rebased_from='' head_proof=''
  if [ -n "$run_sha" ] && [ -n "$pr_base" ] && [ "$run_sha" != "$pr_head" ] && [ "$origin_sha" = "$pr_head" ] &&
    run_clean "$status_out" && patch_proof "$run_sha" "$pr_head" "$pr_base"; then
    gated_patch=$proof_id rebased_from=$run_sha
  elif [ -n "$proof_why" ]; then
    head_proof="; proof: $proof_why"
  fi
  head_mismatch=
  worktree_detail=
  for worktree_sha in $worktree_heads; do
    worktree_detail="$worktree_detail worktree=$worktree_sha"
    [ "$run_sha" = "$worktree_sha" ] || { [ -n "$gated_patch" ] && worktree_gated "$worktree_sha" "$run_sha" "$origin_sha" "$pr_base"; } || head_mismatch=1
  done
  if [ -n "$gated_patch" ] && [ -z "$head_mismatch" ]; then
    printf 'GUARD head PASS gated_patch=%s rebased_from=%s\n' "$gated_patch" "$rebased_from"
  elif [ -z "$run_sha" ] || [ "$run_sha" != "$origin_sha" ] || [ "$run_sha" != "$pr_head" ] || [ -n "$head_mismatch" ]; then
    fail head "run=${run_sha:-unknown} origin=$origin_sha pr=${pr_head:-unknown}$worktree_detail (run $run)$head_proof; $HEAD_FIX"
  fi
fi
gated_patch=${gated_patch-} rebased_from=${rebased_from-}

default_branch=$($GH repo view --json defaultBranchRef -q .defaultBranchRef.name 2> /dev/null) || default_branch=''

# --- author ------------------------------------------------------------------
# Only a PR opened by a trusted author is read any further (the reader exits 3
# for an untrusted author and 1 when it cannot tell; both fail closed).
author_ok=1
"$READ" --json --pr "$pr" > /dev/null 2>&1
a_rc=$?
if [ "$a_rc" -eq 3 ]; then
  author_ok=0
  fail author "PR #$pr was not opened by a trusted author"
elif [ "$a_rc" -ne 0 ]; then
  author_ok=0
  fail author "cannot verify the author of PR #$pr (reader exit $a_rc)"
fi

# --- rollout -----------------------------------------------------------------
# The linkage expectation follows the issue's Rollout, not the caller's memory:
# #236 closed #219 (a Run it issue) because the default was closing.
explicit=$expect
r_issue=$issue
[ -n "$r_issue" ] || r_issue=$(printf '%s' "$branch" | sed -n 's/.*issue-\([0-9][0-9]*\)\(-.*\)\{0,1\}$/\1/p')
rollout_ok=1
if [ "$author_ok" -eq 0 ]; then
  rollout_ok=0
elif [ -z "$r_issue" ]; then
  if [ -z "$explicit" ]; then
    fail rollout "no issue in the branch name, pass --issue N (or --expect to assert linkage)"
    rollout_ok=0
  fi
else
  r_out=$("$ROLLOUT" "$r_issue" 2> /dev/null)
  r_rc=$?
  r_line=$(printf '%s\n' "$r_out" | sed -n 1p)
  derived=''
  if [ "$r_rc" -eq 0 ]; then
    case "$r_line" in
      "ROLLOUT merge "*) derived=closing ;;
      "ROLLOUT run-it "* | "ROLLOUT keep-open "*) derived=refs ;;
    esac
  fi
  if [ -z "$derived" ]; then
    fail rollout "cannot derive the Rollout of #$r_issue: ${r_line:-exit $r_rc, no output}"
    rollout_ok=0
  elif [ -z "$explicit" ]; then
    expect=$derived
  elif [ "$explicit" != "$derived" ]; then
    fail rollout "--expect $explicit contradicts #$r_issue: $r_line (needs $derived)"
  fi
fi

# --- linkage -----------------------------------------------------------------
if [ "$rollout_ok" -eq 1 ]; then
lk_out=$("$LINKAGE" "$pr" --expect "$expect" 2> /dev/null)
lk_rc=$?
lk_line=$(printf '%s\n' "$lk_out" | sed -n 1p)
case "$lk_line" in
  MATCH*) [ "$lk_rc" -eq 0 ] || fail linkage "exit $lk_rc: $lk_line" ;;
  SKIP*)
    if [ "$lk_rc" -ne 0 ]; then
      fail linkage "${lk_line:-no output}"
    elif [ -z "$issue" ]; then
      fail linkage "$lk_line (branch names no issue, pass --issue N)"
    else
      lj=$($GH pr view "$pr" --json body,closingIssuesReferences 2> /dev/null) || lj=''
      api=$(printf '%s' "$lj" | jq -r '[.closingIssuesReferences[]?.number] | sort | join(",")' 2> /dev/null) || api=x
      body_t=$(printf '%s' "$lj" | jq -r '.body // ""' 2> /dev/null |
        grep -oiE '\b(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]*:?[[:space:]]*([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+' |
        sed -E 's/^[A-Za-z]+[[:space:]]*:?[[:space:]]*//' | sort -u | tr '\n' ',' | sed 's/,$//')
      has_ref=$(printf '%s' "$lj" | jq -r '.body // ""' 2> /dev/null | grep -ciE "\\b(Refs|Part of)[[:space:]]+#$issue\\b")
      if [ -z "$lj" ] || [ "$api" = x ]; then
        fail linkage "cannot read PR #$pr body"
      elif [ "$expect" = closing ]; then
        if [ "$body_t" != "#$issue" ] || { [ "$pr_base" = "$default_branch" ] && [ "$api" != "$issue" ]; }; then
          fail linkage "$lk_line (PR must close exactly #$issue: api=[$api] body=[$body_t])"
        fi
      elif [ -n "$api" ] || [ -n "$body_t" ] || [ "${has_ref:-0}" -eq 0 ]; then
        fail linkage "$lk_line (PR must reference #$issue with Refs or Part of and close nothing: api=[$api] body=[$body_t])"
      fi
    fi
    ;;
  *) fail linkage "${lk_line:-exit $lk_rc, no output}" ;;
esac
fi
if [ -z "$issue" ]; then
  issue=$(printf '%s' "${lk_line-}" | sed -n 's/.* issue=#\([0-9][0-9]*\).*/\1/p')
fi

# --- checks ------------------------------------------------------------------
if cj=$($GH pr checks "$pr" --json name,bucket 2> /dev/null) || [ -n "${cj-}" ]; then
  if ! printf '%s' "$cj" | jq -e 'type == "array"' > /dev/null 2>&1; then
    fail checks "cannot parse checks"
  elif [ "$(printf '%s' "$cj" | jq 'length')" = 0 ]; then
    fail checks "no checks reported"
  else
    bad=$(printf '%s' "$cj" | jq -r '[.[] | select(.bucket != "pass" and .bucket != "skipping") | "\(.name)=\(.bucket)"] | join(", ")')
    [ -z "$bad" ] || fail checks "$bad"
  fi
else
  fail checks "cannot read checks"
fi

# --- gates -------------------------------------------------------------------
if [ -z "$status_out" ]; then
  fail gates "no pipeline run to read"
else
  rstatus=$(field "$status_out" status)
  if printf '%s\n' "$status_out" | grep -q 'awaiting_agent\|,awaiting_approval,'; then
    fail gates "run $run has a step awaiting approval: $(printf '%s\n' "$status_out" | grep 'awaiting_agent\|,awaiting_approval,' | sed -n 1p | sed 's/^[[:space:]]*//' | one_line)"
  fi
  case "$rstatus" in
    '') fail gates "run $run reports no status" ;;
    *failed* | *aborted* | *cancel*) fail gates "run $run is $rstatus" ;;
  esac
fi

# --- test-weakening ----------------------------------------------------------
# Advisory only (cbundy/dev-system#314): never sets failed, and a detector
# problem is itself only a WARN, so a detector bug cannot block a merge.
weakened=''
# (skipped when the author or base guard already failed: nothing is merging)
if [ "$author_ok" -eq 1 ] && [ -n "$pr_base" ] && [ -n "$pr_head" ] &&
  { [ "$pr_base" = "$default_branch" ] || [ "$pr_base" = "$base" ]; }; then
  w_rc=0 w_out=''
  if git fetch --quiet origin "+refs/heads/$pr_base:refs/remotes/origin/$pr_base" 2> /dev/null; then
    w_out=$("$WEAKENING" --base "origin/$pr_base" --head "$pr_head" 2>&1) || w_rc=$?
  else
    w_rc=1 w_out="cannot fetch origin/$pr_base"
  fi
  if [ "$w_rc" -ne 0 ]; then
    printf 'GUARD test-weakening WARN detector error: %s\n' "$(printf '%s' "$w_out" | one_line)"
  else
    weakened=$(printf '%s\n' "$w_out" | grep '^WEAKENED ')
    printf '%s\n' "$weakened" | grep '^WEAKENED commit=.* restored=no ' | while IFS= read -r w_line; do
      w_commit=$(printf '%s' "$w_line" | sed 's/^WEAKENED commit=\([^ ]*\) .*/\1/')
      w_step=$(printf '%s' "$w_line" | sed 's/.* step=\([^ ]*\) .*/\1/')
      w_files=$(printf '%s' "$w_line" | sed 's/.* files=\(.*\) kinds=.*/\1/')
      w_kinds=$(printf '%s' "$w_line" | sed 's/.* kinds=//')
      printf 'GUARD test-weakening WARN %.7s step=%s files=%s kinds=%s - have the adjudicator judge it against the brief; restore via fixer unless the removal is justified\n' "$w_commit" "$w_step" "$w_files" "$w_kinds"
    done
  fi
fi

# --- base --------------------------------------------------------------------
if [ -z "$pr_base" ]; then
  fail base "cannot read the PR base"
else
  default=$default_branch
  if [ "$pr_base" != "$default" ] && [ "$pr_base" != "$base" ]; then
    fail base "PR targets $pr_base, default branch is ${default:-unknown}${base:+, --base is $base}; if the PR intentionally targets an epic/integration branch, confirm that with the brief and rerun with --base $pr_base"
  fi
fi

# --- mergeable ---------------------------------------------------------------
# mergeStateStatus, not mergeable: a BEHIND PR still reports MERGEABLE, yet
# strict branch protection refuses it (cbundy/dev-system#246).
mbase=${pr_base:-its base}
mj=$pj
mtry=1
while :; do
  mstate='' mmerge='' mmss='' mreason='' mverdict=unknown
  if [ -z "$mj" ]; then
    mverdict=fail mreason="cannot read merge state"
  else
    mstate=$(printf '%s' "$mj" | jq -r '.state // empty' 2> /dev/null)
    mmerge=$(printf '%s' "$mj" | jq -r '.mergeable // empty' 2> /dev/null)
    mmss=$(printf '%s' "$mj" | jq -r '.mergeStateStatus // empty' 2> /dev/null)
    mdraft=$(printf '%s' "$mj" | jq -r '.isDraft // empty' 2> /dev/null)
    if [ -z "$mstate" ]; then
      :
    elif [ "$mstate" != OPEN ]; then
      mverdict=fail mreason="PR is $mstate"
    elif [ "$mdraft" = true ] || [ "$mmss" = DRAFT ]; then
      mverdict=fail mreason="PR is a draft"
    elif [ "$mmss" = DIRTY ] || [ "$mmerge" = CONFLICTING ]; then
      mverdict=fail mreason="conflicts with $mbase, rebase and re-gate: $REBASE_FIX"
    else
      case "$mmss" in
        BEHIND) mverdict=fail mreason="behind $mbase, $BEHIND_FIX" ;;
        BLOCKED) mverdict=fail mreason="branch rules not met (required checks or reviews); read which rule is unmet, never use --admin" ;;
        CLEAN | UNSTABLE | HAS_HOOKS) mverdict=pass ;;
      esac
    fi
  fi
  [ "$mverdict" = unknown ] || break
  if [ "$mtry" -ge "$mtries" ]; then
    mverdict=fail mreason="GitHub has not computed mergeability, retry"
    break
  fi
  mtry=$((mtry + 1))
  sleep "$msleep"
  mj=$($GH pr view "$pr" --json state,isDraft,mergeable,mergeStateStatus 2> /dev/null) || mj=''
done
[ "$mverdict" != fail ] || fail mergeable "$mreason"

[ "$failed" -eq 0 ] || exit 1
if [ -n "$emit" ]; then
  close_issue=''
  if [ "$pr_base" != "$default_branch" ] && [ "$expect" = closing ]; then
    close_issue=$issue
  fi
  [ -z "$weakened" ] || printf '%s\n' "$weakened"
  printf 'VERIFIED pr=%s branch=%s head=%s run=%s issue=%s close_issue=%s gated_patch=%s rebased_from=%s\n' "$pr" "$branch" "$pr_head" "$run" "$issue" "$close_issue" "$gated_patch" "$rebased_from"
fi
exit 0
