#!/bin/bash
#
# dev-init: start-up setup for the dev-system base image.
#
# Wires up the state that cannot be baked into the image: it checks the
# /persist volumes, seeds tool config that must exist before first use,
# re-points git at gh's credentials and recovers no-mistakes runtime state.
# Runs as node on every container start (postStartCommand from the image's
# devcontainer metadata, or the runtime's own start hook).
#
# Idempotent and best-effort: every problem is logged, and the exit status is
# always 0, so a container never fails to start because of this script. Run
# `dev-doctor` for a strict pass/fail health check.
set -u

log() {
  echo "dev-init: $*" >&2
}

PERSIST_DIRS="${CLAUDE_CONFIG_DIR:-/persist/claude} ${CODEX_HOME:-/persist/codex} ${GH_CONFIG_DIR:-/persist/gh} ${NM_HOME:-/persist/no-mistakes}"
CALLUM_TOOLS=/usr/local/share/callum-tools
OTEL_SNIPPET=/etc/profile.d/dev-system-otel.sh
CODEX_SYSTEM_CONFIG=/etc/codex/config.toml
CODEX_OTEL_MARKER='# Managed by dev-init: codex OTel export (cbundy/dev-system#68). Rewritten on every start; do not edit.'

# The telemetry defaults live in one place, the profile snippet. BASH_ENV has
# normally sourced it already; sourcing it again is a no-op, and makes the
# daemon and dev-doctor started below see the same values when it has not.
# shellcheck source=SCRIPTDIR/otel-env.sh
[ -r "$OTEL_SNIPPET" ] && . "$OTEL_SNIPPET"

# 1. Every persistence directory exists and is writable. A missing directory
#    under a writable mount (one volume for all of /persist) is created; an
#    unwritable one gets a loud message naming the fix.
check_persist_dirs() {
  local dir
  for dir in $PERSIST_DIRS; do
    if [ ! -d "$dir" ] && ! mkdir -m 0700 "$dir" 2>/dev/null; then
      log "WARNING: $dir is missing and cannot be created by $(id -un) ($(id -u):$(id -g))."
      log "  Fix: mount a volume there owned by 1000:1000 (k8s: securityContext.fsGroup: 1000; Docker: chown 1000:1000 on the volume)."
      continue
    fi
    if [ ! -w "$dir" ]; then
      log "WARNING: $dir is not writable by $(id -un) ($(id -u):$(id -g)) - state for this tool will NOT persist and logins will fail."
      log "  Fix: chown 1000:1000 the volume behind $dir (k8s: securityContext.fsGroup: 1000)."
    fi
  done
}

# 2. Claude records how it was installed in .claude.json, which lives in the
#    (initially empty) CLAUDE_CONFIG_DIR rather than the image. Without it,
#    `claude doctor` warns that the native install's method is "not set".
#    Only a missing key is filled in; the rest of the file is left as is.
seed_claude_config() {
  local cfg="${CLAUDE_CONFIG_DIR:-/persist/claude}/.claude.json" tmp
  [ -w "$(dirname "$cfg")" ] || return 0
  if [ ! -s "$cfg" ]; then
    (umask 077 && echo '{"installMethod":"native"}' > "$cfg") && log "seeded installMethod native in $cfg"
    return 0
  fi
  jq -e 'has("installMethod")' "$cfg" >/dev/null 2>&1 && return 0
  tmp=$(mktemp "$cfg.XXXXXX") || return 0
  if jq '.installMethod = "native"' "$cfg" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$cfg" && log "seeded installMethod native in $cfg"
  else
    log "WARNING: $cfg is not valid JSON - left untouched"
  fi
  rm -f "$tmp"
}

# 3. codex cannot use its bwrap sandbox inside these containers (it needs
#    namespaces the container does not grant - dev-system#19), so default it to
#    full access. Only a top-level sandbox_mode counts; one inside a [table]
#    (e.g. a profile) is a different setting. Top-level keys must come before
#    any table in TOML, so the default is prepended.
seed_codex_config() {
  local cfg="${CODEX_HOME:-/persist/codex}/config.toml"
  [ -w "$(dirname "$cfg")" ] || return 0
  if [ -f "$cfg" ] && awk '/^[[:space:]]*\[/ { exit 1 } /^[[:space:]]*sandbox_mode[[:space:]]*=/ { found = 1; exit } END { exit !found }' "$cfg"; then
    return 0
  fi
  local tmp
  tmp=$(mktemp "$cfg.XXXXXX") || return 0
  {
    echo '# Seeded by dev-init: bwrap cannot run inside this container (cbundy/dev-system#19).'
    echo 'sandbox_mode = "danger-full-access"'
    if [ -f "$cfg" ]; then
      echo
      cat "$cfg"
    fi
  } > "$tmp" && mv "$tmp" "$cfg" && log "seeded sandbox_mode = \"danger-full-access\" in $cfg"
  rm -f "$tmp"
}

# 4. codex OTel export, under the same switch as Claude Code: codex reads its
#    exporters only from config.toml (no OTEL_* enable variables), so dev-init
#    writes codex's system-level config, /etc/codex/config.toml, a layer that
#    ranks below the user's $CODEX_HOME/config.toml. The user's file is never
#    touched, and a user [otel] table there makes dev-init step aside. The
#    system file lives in the container filesystem, not /persist, so it never
#    outlives the runtime that supplied the endpoint. Only a file carrying
#    dev-init's marker is ever rewritten or removed; a consumer image's own
#    /etc/codex/config.toml is left alone.
configure_codex_otel() {
  local cfg="$CODEX_SYSTEM_CONFIG" ep="${OTEL_EXPORTER_OTLP_ENDPOINT:-}"
  local proto="${OTEL_EXPORTER_OTLP_PROTOCOL:-http/protobuf}"
  local user_cfg="${CODEX_HOME:-/persist/codex}/config.toml"
  local logs_ep metrics_ep kind env_name prompts=false tmp
  local ours=false
  [ -f "$cfg" ] && [ "$(head -n 1 "$cfg" 2>/dev/null)" = "$CODEX_OTEL_MARKER" ] && ours=true

  if [ -z "$ep" ]; then
    if [ "$ours" = true ]; then
      rm -f "$cfg" && log "telemetry off (no OTEL_EXPORTER_OTLP_ENDPOINT): removed $cfg"
    fi
    return 0
  fi
  # codex merges layers table by table, so a user exporter of another kind
  # (otlp-grpc over our otlp-http) would merge into an invalid two-variant
  # table. A user who configures [otel] themselves gets exactly their config.
  if [ -f "$user_cfg" ] && grep -qE '^[[:space:]]*(\[[[:space:]]*otel[[:space:]]*[].]|otel[[:space:]]*[.=])' "$user_cfg"; then
    log "NOTE: $user_cfg configures [otel] itself - dev-init leaves codex OTel export to it"
    [ "$ours" = true ] && rm -f "$cfg"
    return 0
  fi
  if [ -e "$cfg" ] && [ "$ours" = false ]; then
    log "NOTE: $cfg was not written by dev-init - left as is, so codex OTel export is not configured by dev-init"
    return 0
  fi
  if [ ! -w "$(dirname "$cfg")" ]; then
    log "WARNING: $(dirname "$cfg") is not writable by $(id -un) - codex will not export telemetry"
    return 0
  fi

  # codex's OTLP/HTTP endpoints are per signal (it does not append /v1/...),
  # and an endpoint it is given overrides the OTEL_* environment, so the
  # per-signal variables are honoured here the way the OTel spec defines them.
  ep="${ep%/}"
  case "$proto" in
    grpc)
      kind=otlp-grpc
      logs_ep="${OTEL_EXPORTER_OTLP_LOGS_ENDPOINT:-$ep}"
      metrics_ep="${OTEL_EXPORTER_OTLP_METRICS_ENDPOINT:-$ep}"
      ;;
    http/protobuf | http/json)
      kind=otlp-http
      logs_ep="${OTEL_EXPORTER_OTLP_LOGS_ENDPOINT:-$ep/v1/logs}"
      metrics_ep="${OTEL_EXPORTER_OTLP_METRICS_ENDPOINT:-$ep/v1/metrics}"
      ;;
    *)
      log "WARNING: OTEL_EXPORTER_OTLP_PROTOCOL=$proto is not grpc, http/protobuf or http/json - codex will not export telemetry"
      [ "$ours" = true ] && rm -f "$cfg"
      return 0
      ;;
  esac
  # codex sets its own `env` resource attribute from [otel].environment
  # (default "dev"), overriding OTEL_RESOURCE_ATTRIBUTES, so pass env= through.
  env_name=$(printf '%s\n' "${OTEL_RESOURCE_ATTRIBUTES:-}" | tr ',' '\n' | sed -n 's/^[[:space:]]*env=//p' | head -n 1)
  [ "${OTEL_LOG_USER_PROMPTS:-}" = 1 ] && prompts=true

  # Everything below goes into TOML basic strings: refuse anything that would
  # need escaping rather than write a file codex cannot parse.
  case "$logs_ep$metrics_ep$env_name" in
    *[\"\\[:space:][:cntrl:]]*)
      log "WARNING: the OTLP endpoint or env= resource attribute contains quotes, backslashes or whitespace - codex will not export telemetry"
      [ "$ours" = true ] && rm -f "$cfg"
      return 0
      ;;
  esac

  tmp=$(mktemp "$cfg.XXXXXX") || return 0
  {
    echo "$CODEX_OTEL_MARKER"
    echo '[otel]'
    [ -n "$env_name" ] && echo "environment = \"$env_name\""
    echo "log_user_prompt = $prompts"
    if [ "$kind" = otlp-grpc ]; then
      echo "exporter = { otlp-grpc = { endpoint = \"$logs_ep\" } }"
      echo "metrics_exporter = { otlp-grpc = { endpoint = \"$metrics_ep\" } }"
    else
      local enc=binary
      [ "$proto" = http/json ] && enc=json
      echo "exporter = { otlp-http = { endpoint = \"$logs_ep\", protocol = \"$enc\" } }"
      echo "metrics_exporter = { otlp-http = { endpoint = \"$metrics_ep\", protocol = \"$enc\" } }"
    fi
  } > "$tmp" && chmod 0644 "$tmp" && mv "$tmp" "$cfg" && log "telemetry on: codex exports to $ep ($proto) via $cfg"
  rm -f "$tmp"
}

# 5. The no-mistakes codex model pin, with the callum-tools `codexModel`
#    semantics: DEV_CODEX_MODEL overrides the feature's default, and an empty
#    value skips the pin. An existing pin is never touched.
seed_no_mistakes_model() {
  local nm_home="${NM_HOME:-/persist/no-mistakes}" model
  [ -w "$nm_home" ] || return 0
  if [ "${DEV_CODEX_MODEL+set}" = set ]; then
    model="$DEV_CODEX_MODEL"
  else
    model=$(cat /usr/local/share/dev-system/codex-model.default 2>/dev/null || true)
  fi
  "$CALLUM_TOOLS/pin-codex-model.sh" "$nm_home/config.yaml" "$model" \
    || log "WARNING: could not write the codex model pin to $nm_home/config.yaml"
}

# 6. ~/.gitconfig is not persisted, so git's link to gh's credential helper
#    is redone on every start.
setup_git_credentials() {
  command -v gh >/dev/null 2>&1 || return 0
  gh auth status >/dev/null 2>&1 || return 0
  gh auth setup-git >/dev/null 2>&1 || log "WARNING: gh auth setup-git failed - git may not authenticate to GitHub over HTTPS"
}

# 7. no-mistakes in a gated workspace. Registration persists in NM_HOME, but
#    the daemon is a process and is gone after every restart, so it is started
#    whenever the workspace opts in. Then the callum-tools recovery re-registers
#    a repo the daemon has lost (e.g. a fresh volume).
recover_no_mistakes() {
  local ws="${DEV_WORKSPACE:-$PWD}" top
  command -v no-mistakes >/dev/null 2>&1 || return 0
  [ -d "$ws" ] || return 0
  if ! top=$(git -C "$ws" rev-parse --show-toplevel 2>/dev/null); then
    if [ -e "$ws/.git" ]; then
      log "WARNING: git cannot read the repo at $ws (owned by $(stat -c %U "$ws" 2>/dev/null), not $(id -un)) - no-mistakes recovery skipped."
      log "  Fix: chown -R 1000:1000 the checkout, or: git config --global --add safe.directory $ws"
    fi
    return 0
  fi
  [ -f "$top/.no-mistakes.yaml" ] || return 0
  [ -w "${NM_HOME:-/persist/no-mistakes}" ] || return 0
  ( cd "$top" && no-mistakes daemon start >/dev/null 2>&1 ) || true
  ( cd "$top" && "$CALLUM_TOOLS/recover-no-mistakes.sh" ) || true
}

check_persist_dirs
seed_claude_config
seed_codex_config
configure_codex_otel
seed_no_mistakes_model
setup_git_credentials
recover_no_mistakes

# 8. Report anything still broken, without failing the start.
dev-doctor --warn-only || true
exit 0
