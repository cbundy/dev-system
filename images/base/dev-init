#!/bin/bash
#
# dev-init: start-up setup for the dev-system base image.
#
# Wires up the state that cannot be baked into the image: it checks the
# /persist volumes, logs the coder CLI in from DEV_CODER_TOKEN_FILE when the
# workspace opts in, seeds tool config that must exist before first use,
# moves an older Claude login into a shared Claude login directory,
# points codex's telemetry at OTEL_EXPORTER_OTLP_ENDPOINT when the runtime
# sets one, re-points git at gh's credentials, clones the workspace repo
# (DEV_REPO_URL) on first start, recovers no-mistakes runtime state, starts
# the agentsview session push when one is configured, checks the optional
# /shared mount, starts the login page when DEV_LOGIN_PORT asks for it and,
# last, installs the Claude plugins: the image's default ones
# (DEV_DEFAULT_PLUGINS) and the ones the repo enables.
# Runs as node on every container start (postStartCommand from the image's
# devcontainer metadata, or the runtime's own start hook).
#
# Usage: dev-init [--repo | --plugins]
#   --repo runs only the repo steps (5a, 5, 6, 11, 7, in that order): the token login, git
#   credentials, the clone or fetch, the Claude plugins and the no-mistakes
#   recovery. dev-login runs it once gh's login is done, for a clone that was
#   waiting for one.
#   --plugins runs only step 11, the Claude plugins (the retry dev-doctor
#   names for a missing default plugin).
#
# Idempotent and best-effort: every problem is logged, and the exit status is
# always 0, so a container never fails to start because of this script. Run
# `dev-doctor` for a strict pass/fail health check.
set -u

# shellcheck source=workspace.sh
. /usr/local/share/dev-system/workspace.sh
# shellcheck source=plugins.sh
. /usr/local/share/dev-system/plugins.sh
# shellcheck source=persist.sh
. /usr/local/share/dev-system/persist.sh
# shellcheck source=gh.sh
. /usr/local/share/dev-system/gh.sh
# shellcheck source=claude-auth.sh
. /usr/local/share/dev-system/claude-auth.sh

log() {
  echo "dev-init: $*" >&2
}

case "${1:-}" in
  "" | --repo | --plugins) ;;
  *)
    echo "usage: dev-init [--repo | --plugins]" >&2
    exit 2
    ;;
esac

CALLUM_TOOLS=/usr/local/share/callum-tools
# Held by the running agentsview push loop; container-local on purpose (see
# start_agentsview_push). dev-doctor reads the same path.
AGENTSVIEW_PUSH_LOCK=/tmp/dev-agentsview-push.lock
AGENTSVIEW_PUSH_LOG=/tmp/dev-agentsview-push.log
FACTORY_EVENT_PUSH_LOCK=/tmp/dev-factory-event-push.lock
FACTORY_EVENT_PUSH_LOG=/tmp/dev-factory-event-push.log
HEARTBEAT_LOCK=/tmp/dev-heartbeat.lock
HEARTBEAT_LOG=/tmp/dev-heartbeat.log
LOGIN_PAGE_LOCK=/tmp/dev-login-page.lock
LOGIN_PAGE_LOG=/tmp/dev-login-page.log

# 1. Every persistence directory (the image's one list, persist.sh) exists, is
#    writable and has a volume behind it. A missing directory is created as
#    node:node 0700: first plainly, then with `sudo -n` for a root-owned
#    /persist on a volume that predates the directory (cbundy/dev-system#269),
#    so existing volumes converge on a new contract directory at the next
#    start. A directory that already exists is never chowned. The one change
#    to one is tightening a node-owned, looser-than-0700 mode, which node does
#    itself. Where neither works, a loud message names the exact fix. A
#    writable directory with no volume at it or above it (its mount point is /,
#    the container's own layer) loses its state on every rebuild. That stays a
#    warning (not raised for dev-restart-self, which has no per-dir
#    volume in the desktop templates) - a one-off `docker run IMAGE <cmd>` has no volumes on purpose.
check_persist_dirs() {
  local dir mode unmounted="" needs_volume
  needs_volume=$(persist_dirs --volume)
  while IFS= read -r dir; do
    if [ ! -d "$dir" ]; then
      mkdir -m 0700 "$dir" 2>/dev/null ||
        { command -v sudo >/dev/null 2>&1 && sudo -n install -d -o "$(id -u)" -g "$(id -g)" -m 0700 "$dir" 2>/dev/null; } ||
        [ -d "$dir" ] || {
        log "WARNING: $dir is missing and cannot be created by $(id -un) ($(id -u):$(id -g))."
        log "  Fix: $(persist_fix_cmd "$dir") (or mount a volume there owned by 1000:1000; k8s: securityContext.fsGroup: 1000)."
        continue
      }
    elif [ -O "$dir" ]; then
      mode=$(stat -c %a "$dir" 2>/dev/null)
      [ "$mode" = 700 ] || chmod 0700 "$dir" 2>/dev/null || true
    fi
    if [ ! -w "$dir" ]; then
      log "WARNING: $dir is not writable by $(id -un) ($(id -u):$(id -g)) - state for this tool will NOT persist and logins will fail."
      log "  Fix: chown 1000:1000 the volume behind $dir (k8s: securityContext.fsGroup: 1000)."
    elif [ "$(stat -c %m "$dir" 2>/dev/null)" = / ] && printf '%s\n' "$needs_volume" | grep -qxF -- "$dir"; then
      unmounted="$unmounted $dir"
    fi
  done < <(persist_dirs)
  [ -n "$unmounted" ] || return 0
  log "WARNING: no volume behind$unmounted - logins and tool state there are LOST when this container is rebuilt or removed."
  log "  Fix (devcontainer): the per-repo mounts from the base-image template - npx callum-dev update --devcontainer base-image, or copy them from images/base/README.md (\"Extending the image\")."
  log "  Fix (docker run / compose): a named volume per directory (images/base/README.md, \"First start, headless\"). Kubernetes / Coder: one volume at /persist."
  log "  A throwaway container with no volumes on purpose can ignore this."
}

# 1b. Finish a dev-restart-self restart (cbundy/dev-system#263): restore the
#     autostart schedule and automatic_updates it saved, and report what the
#     last request was. Early, before the slow plugin install, so a one-off
#     schedule never keeps firing for long. A no-op when the helper is missing
#     or there is nothing saved; best-effort, never fails the start.
resume_restart_self() {
  command -v dev-restart-self >/dev/null 2>&1 || return 0
  dev-restart-self --resume 2>&1 | while IFS= read -r line; do log "$line"; done
  return 0
}

# 2. Claude records how it was installed in .claude.json, which lives in the
#    (initially empty) CLAUDE_CONFIG_DIR rather than the image. Without it,
#    `claude doctor` warns that the native install's method is "not set".
#    Only a missing key is filled in; the rest of the file is left as is.
seed_claude_config() {
  local cfg="${CLAUDE_CONFIG_DIR:-/persist/claude}/.claude.json" tmp
  [ -w "$(dirname "$cfg")" ] || return 0
  if [ ! -s "$cfg" ]; then
    (umask 077 && echo '{"installMethod":"native"}' > "$cfg") && log "seeded installMethod native in $cfg"
    return 0
  fi
  jq -e 'has("installMethod")' "$cfg" >/dev/null 2>&1 && return 0
  tmp=$(mktemp "$cfg.XXXXXX") || return 0
  if jq '.installMethod = "native"' "$cfg" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$cfg" && log "seeded installMethod native in $cfg"
  else
    log "WARNING: $cfg is not valid JSON - left untouched"
  fi
  rm -f "$tmp"
}

# 2b. A runtime that opts in to a shared Claude login sets
#     CLAUDE_SECURESTORAGE_CONFIG_DIR (/persist/claude-auth, a shared volume).
#     Unset, nothing here runs and the login stays in CLAUDE_CONFIG_DIR. Set,
#     a login made before, in CLAUDE_CONFIG_DIR, moves there when the
#     directory holds none yet, so the first container to start keeps its
#     login and every other one sharing the directory uses it too. A hard
#     link publishes it, so two containers starting at once never overwrite
#     each other. The source copy is removed, never left behind as a second
#     holder of the same refresh token. When the directory already holds a
#     login, the old one stays where it is, unused: a grant of its own.
adopt_claude_login() {
  local cfg="${CLAUDE_CONFIG_DIR:-/persist/claude}" auth="${CLAUDE_SECURESTORAGE_CONFIG_DIR-}" tmp
  [ -n "$auth" ] && [ "$auth" != "$cfg" ] || return 0
  [ -f "$cfg/.credentials.json" ] && [ ! -L "$cfg/.credentials.json" ] || return 0
  [ -w "$auth" ] && [ ! -e "$auth/.credentials.json" ] || return 0
  tmp=$(mktemp "$auth/.credentials.json.XXXXXX") || return 0
  if cp "$cfg/.credentials.json" "$tmp" && chmod 0600 "$tmp" && ln "$tmp" "$auth/.credentials.json" 2>/dev/null; then
    rm -f "$cfg/.credentials.json"
    log "moved the Claude login from $cfg to $auth"
  fi
  rm -f "$tmp"
}

# 3. codex cannot use its bwrap sandbox inside these containers (it needs
#    namespaces the container does not grant - dev-system#19), so default it to
#    full access. Only a top-level sandbox_mode counts; one inside a [table]
#    (e.g. a profile) is a different setting. Top-level keys must come before
#    any table in TOML, so the default is prepended.
seed_codex_config() {
  local cfg="${CODEX_HOME:-/persist/codex}/config.toml"
  [ -w "$(dirname "$cfg")" ] || return 0
  if [ -f "$cfg" ] && awk '/^[[:space:]]*\[/ { exit 1 } /^[[:space:]]*sandbox_mode[[:space:]]*=/ { found = 1; exit } END { exit !found }' "$cfg"; then
    return 0
  fi
  local tmp
  tmp=$(mktemp "$cfg.XXXXXX") || return 0
  {
    echo '# Seeded by dev-init: bwrap cannot run inside this container (cbundy/dev-system#19).'
    echo 'sandbox_mode = "danger-full-access"'
    if [ -f "$cfg" ]; then
      echo
      cat "$cfg"
    fi
  } > "$tmp" && mv "$tmp" "$cfg" && log "seeded sandbox_mode = \"danger-full-access\" in $cfg"
  rm -f "$tmp"
}

# 3b. codex telemetry (cbundy/dev-system#68): with OTEL_EXPORTER_OTLP_ENDPOINT
#    set, an [otel] table in codex's config.toml, between marker comments,
#    sends codex's logs and metrics there, labelled with the runtime's env;
#    unset, the table is removed. codex-otel.sh has the rules.
# shellcheck source=codex-otel.sh
. /usr/local/share/dev-system/codex-otel.sh
configure_codex_otel() {
  codex_otel_configure "${CODEX_HOME:-/persist/codex}/config.toml" /usr/local/share/dev-system/telemetry.sh
}

# 4. The no-mistakes managed block in the global config: three parts - the
#    pipeline's ordered agent list (`agent: [codex, claude]`), the model pin
#    (`agent_config`: codex, and claude's model and effort) and the review
#    roles (`review_agents`: reviewer and fixer, no fallback). Rewritten on every start so a change
#    reaches a workspace whose /persist outlived the image (pin-codex-model.sh
#    has the rules: a key set by hand outside the block wins over its part
#    only, the old unmarked block is migrated). Each value comes from the
#    first of these that has it:
#    - DEV_NM_AGENTS / DEV_CODEX_MODEL / DEV_CLAUDE_MODEL / DEV_CLAUDE_EFFORT /
#      DEV_REVIEW_AGENT / DEV_REVIEW_MODEL / DEV_REVIEW_EFFORT, when set at
#      all: an empty value skips that part (an empty agent list writes no
#      `agent`, an empty codex model no pin, an empty review agent no
#      review roles);
#    - each file model_sources lists (models.sh parses them, never sources):
#      the models file fetched once per start from DEV_MODELS_URL (default:
#      images/base/models.env on this repo's main branch, so a merged change
#      reaches every workspace on its next start; empty turns the fetch off),
#      then the copy baked into the image, the offline fallback. Per key, a
#      valid fetched value beats the baked one.
#    A changed block makes step 7 restart a running daemon, which reads the
#    config only at start-up.
MODELS_BAKED=/usr/local/share/dev-system/models.env
MODELS_FETCHED=""
MODELS_URL_USED=""
NM_PIN_CHANGED=false

# The models files to read, highest precedence first.
model_sources() {
  [ -z "$MODELS_FETCHED" ] || echo "$MODELS_FETCHED"
  echo "$MODELS_BAKED"
}

# resolve_model <env var> <models.env key>: the value to write, or nothing.
resolve_model() {
  local sources
  mapfile -t sources < <(model_sources)
  models_resolve "$1" "$2" "${sources[@]}"
}

# fetch_models: fetches the models file from DEV_MODELS_URL into
# MODELS_FETCHED. Any failure is one WARNING, and the baked file is used.
fetch_models() {
  local url tmp reason
  url=$(models_url) || return 0
  if ! tmp=$(mktemp "${TMPDIR:-/tmp}/dev-models.XXXXXX"); then
    log "WARNING: could not fetch the models file from $url (no temp file) - using the image's baked models"
    return 0
  fi
  if reason=$(models_fetch "$url" "$tmp"); then
    MODELS_FETCHED="$tmp"
    MODELS_URL_USED="$url"
  else
    log "WARNING: could not use the models file from $url ($reason) - using the image's baked models"
    rm -f "$tmp"
  fi
}

seed_no_mistakes_model() {
  local nm_home="${NM_HOME:-/persist/no-mistakes}" agents codex claude claude_effort out block pin
  local review_agent review_model review_effort review
  [ -w "$nm_home" ] || return 0
  # shellcheck source=models.sh
  . /usr/local/share/dev-system/models.sh
  fetch_models
  agents=$(resolve_model DEV_NM_AGENTS AGENTS)
  codex=$(resolve_model DEV_CODEX_MODEL CODEX_MODEL)
  claude=$(resolve_model DEV_CLAUDE_MODEL CLAUDE_MODEL)
  claude_effort=$(resolve_model DEV_CLAUDE_EFFORT CLAUDE_EFFORT)
  review_agent=$(resolve_model DEV_REVIEW_AGENT REVIEW_AGENT)
  review_model=$(resolve_model DEV_REVIEW_MODEL REVIEW_MODEL)
  review_effort=$(resolve_model DEV_REVIEW_EFFORT REVIEW_EFFORT)
  if [ -n "$MODELS_FETCHED" ]; then
    rm -f "$MODELS_FETCHED"
    MODELS_FETCHED=""
  fi
  if ! out=$("$CALLUM_TOOLS/pin-codex-model.sh" "$nm_home/config.yaml" "$codex" "$claude" "$agents" "$claude_effort" "$review_agent" "$review_model" "$review_effort"); then
    log "WARNING: could not write the no-mistakes managed block (agent order, model pin and review roles) to $nm_home/config.yaml"
    return 0
  fi
  [ "$out" = changed ] || return 0
  NM_PIN_CHANGED=true
  if grep -q '^# BEGIN dev-system managed' "$nm_home/config.yaml"; then
    # What the block holds: a key set by hand outside it drops its part.
    block=$(sed -n '/^# BEGIN dev-system managed/,/^# END dev-system managed$/p' "$nm_home/config.yaml")
    agents=$(printf '%s\n' "$block" | sed -n 's/^agent: \[\(.*\)\]$/\1/p' | sed 's/, /,/g')
    pin="no model pin"
    review="no review roles"
    if printf '%s\n' "$block" | grep -q '^agent_config:'; then
      pin="codex ${codex}${claude:+, claude $claude}${claude_effort:+ ($claude_effort)}"
    fi
    printf '%s\n' "$block" | grep -q '^review_agents:' \
      && review="review ${review_agent}${review_model:+ $review_model}${review_effort:+ ($review_effort)}, no fallback"
    log "no-mistakes managed block in $nm_home/config.yaml: agents ${agents:-not set}; $pin; $review"
  else
    log "removed dev-init's no-mistakes managed block from $nm_home/config.yaml"
  fi
  [ -z "$MODELS_URL_USED" ] || log "models read from $MODELS_URL_USED, with the image's baked models as the fallback"
}

# 5a. Token mode (cbundy/dev-system#728): with DEV_GH_TOKEN_FILE set, gh holds
#    exactly one account, the token file's, and nothing else (not a browser login,
#    not Coder's GitHub external auth) is ever used for GitHub. Runs before step 5
#    and the clone. Every account is removed first; then the token is read from the
#    file on stdin only (never argv, a log or an exported variable), gh's account
#    is resolved, its identity is written to gh_identity_file (login, id, name,
#    email; mode 0600; no token) and git's user.name and user.email are set from
#    it. A missing, empty, unreadable or rejected token logs one line (the path and
#    the cause, never the token), removes any identity file, leaves gh with no
#    account and carries on. Without DEV_GH_TOKEN_FILE this does nothing.
gh_remove_accounts() {
  local user cfg="${GH_CONFIG_DIR:-$HOME/.config/gh}" hosts tmp
  while IFS= read -r user; do
    [ -z "$user" ] || gh auth logout --hostname github.com --user "$user" >/dev/null 2>&1
  done < <(gh auth status --json hosts --hostname github.com 2>/dev/null \
    | jq -r '.hosts["github.com"][]?.login // empty' 2>/dev/null)
  # What logout leaves behind: an entry for github.com in hosts.yml.
  hosts="$cfg/hosts.yml"
  if [ -f "$hosts" ] && grep -q '^github\.com:' "$hosts"; then
    tmp=$(mktemp "$cfg/.hosts.XXXXXX") || return 0
    if awk '/^github\.com:/ { skip = 1; next } skip && /^[^[:space:]]/ { skip = 0 } !skip' "$hosts" > "$tmp"; then
      chmod 600 "$tmp"
      mv -f "$tmp" "$hosts"
    else
      rm -f "$tmp"
    fi
  fi
}

setup_gh_token() {
  gh_token_mode || return 0
  local tf="$DEV_GH_TOKEN_FILE" idf cause="" user login id name email tmp
  idf=$(gh_identity_file)
  rm -f "$idf"
  if ! command -v gh >/dev/null 2>&1; then
    log "WARNING: DEV_GH_TOKEN_FILE ($tf) is set but gh is not on PATH - no GitHub login"
    return 0
  fi
  gh_remove_accounts
  if [ ! -e "$tf" ]; then
    cause="the file does not exist"
  elif [ ! -r "$tf" ]; then
    cause="the file is not readable"
  elif ! grep -q '[^[:space:]]' "$tf" 2>/dev/null; then
    cause="the file is empty"
  elif ! gh auth login --hostname github.com --with-token < "$tf" >/dev/null 2>&1; then
    cause="GitHub rejected the token"
  else
    user=$(gh api user 2>/dev/null) || user=""
    login=$(printf '%s' "$user" | jq -r '.login // empty' 2>/dev/null)
    id=$(printf '%s' "$user" | jq -r '.id // empty' 2>/dev/null)
    name=$(printf '%s' "$user" | jq -r '.name // empty' 2>/dev/null)
    if [ -z "$login" ] || [ -z "$id" ]; then
      cause="GitHub rejected the token (gh api user failed)"
      gh_remove_accounts
    fi
  fi
  if [ -n "$cause" ]; then
    log "WARNING: DEV_GH_TOKEN_FILE ($tf): $cause - gh has no GitHub account (no fallback login)"
    return 0
  fi
  [ -n "$name" ] || name="$login"
  email="${DEV_GIT_EMAIL:-$(gh_noreply_email "$id" "$login")}"
  mkdir -p "$(dirname "$idf")" 2>/dev/null
  tmp=$(mktemp "$(dirname "$idf")/.identity.XXXXXX") || { log "WARNING: cannot write $idf"; return 0; }
  chmod 600 "$tmp"
  if jq -n --arg login "$login" --argjson id "$id" --arg name "$name" --arg email "$email" \
    '{login: $login, id: $id, name: $name, email: $email}' > "$tmp" && mv -f "$tmp" "$idf"; then
    git config --global user.name "$name"
    git config --global user.email "$email"
    gh auth setup-git >/dev/null 2>&1 || log "WARNING: gh auth setup-git failed - git may not authenticate to GitHub over HTTPS"
    log "gh is logged in as $login from DEV_GH_TOKEN_FILE ($tf)"
  else
    rm -f "$tmp"
    log "WARNING: could not write $idf"
  fi
}

# 1a. Coder CLI login (cbundy/dev-system#540, opt-in): with DEV_CODER_TOKEN_FILE
#    set (the template mounts the token only into workspaces that opt in), the
#    CLI's login is rebuilt on every start, because ~/.config/coderv2 is not on a
#    volume. The token's first line goes to <config dir>/session (directory 0700,
#    file 0600, written under umask 077; never echoed, never on a command line) and
#    the URL (CODER_URL, else CODER_AGENT_URL, trailing slash stripped) to url.
#    Runs before resume_restart_self, which needs the login. A missing or empty
#    file, no URL or no coder on PATH logs one WARNING and writes no session file.
#    Without DEV_CODER_TOKEN_FILE this does nothing and leaves the config alone.
setup_coder_login() {
  [ -n "${DEV_CODER_TOKEN_FILE:-}" ] || return 0
  local tf="$DEV_CODER_TOKEN_FILE" dir="${CODER_CONFIG_DIR:-$HOME/.config/coderv2}"
  local url="${CODER_URL:-${CODER_AGENT_URL:-}}" token="" who=""
  url="${url%/}"
  if ! command -v coder >/dev/null 2>&1; then
    log "WARNING: DEV_CODER_TOKEN_FILE ($tf) is set but coder is not on PATH - no Coder login"
    return 0
  fi
  if [ ! -r "$tf" ]; then
    log "WARNING: DEV_CODER_TOKEN_FILE ($tf): the file does not exist or is not readable - no Coder login"
    return 0
  fi
  IFS= read -r token < "$tf" || true
  token="${token%$'\r'}"
  if ! printf '%s' "$token" | grep -q '[^[:space:]]'; then
    log "WARNING: DEV_CODER_TOKEN_FILE ($tf): the file is empty - no Coder login"
    return 0
  fi
  if [ -z "$url" ]; then
    log "WARNING: DEV_CODER_TOKEN_FILE ($tf) is set but neither CODER_URL nor CODER_AGENT_URL is - no Coder login"
    return 0
  fi
  if ! (
    umask 077
    mkdir -p "$dir" && chmod 700 "$dir" \
      && printf '%s' "$token" > "$dir/session" && chmod 600 "$dir/session" \
      && printf '%s' "$url" > "$dir/url" && chmod 600 "$dir/url"
  ); then
    log "WARNING: could not write the Coder login under $dir"
    return 0
  fi
  who=$(CODER_URL="$url" timeout 10 coder whoami 2>/dev/null) || who=""
  # The CLI prints "[ Coder is running at <url>, You're authenticated as <user> ! ..."
  # (v2.36); take the name after "authenticated as", else a bare one-word answer.
  who=$(printf '%s\n' "$who" | sed -n -e "s/.*authenticated as \([^ ]*\).*/\1/p" -e t -e '/^[^ ]*$/p' | head -n 1)
  if [ -n "$who" ]; then
    log "coder CLI is logged in as $who from DEV_CODER_TOKEN_FILE ($tf)"
  else
    log "WARNING: DEV_CODER_TOKEN_FILE ($tf): coder whoami failed - the token may be expired or rejected"
  fi
  return 0
}

# 5. ~/.gitconfig is not persisted, so git's link to gh's credential helper
#    is redone on every start.
setup_git_credentials() {
  command -v gh >/dev/null 2>&1 || return 0
  gh auth status >/dev/null 2>&1 || return 0
  gh auth setup-git >/dev/null 2>&1 || log "WARNING: gh auth setup-git failed - git may not authenticate to GitHub over HTTPS"
}

# Can git authenticate for this URL? Coder's agent sets GIT_ASKPASS (GitHub
# external auth); `gh auth setup-git` (step 5) configures a credential helper.
has_git_credential() {
  { [ -n "${GIT_ASKPASS:-}" ] && ! gh_token_mode; } || [ -n "$(git config --get-urlmatch credential.helper "$1" 2>/dev/null)" ]
}

# Why git failed, from its output: the first error line (the cause; the
# lines after it are generic advice), else the last line.
git_reason() {
  local line
  line=$(printf '%s\n' "$1" | grep -m 1 -E '^(fatal|error|remote|ssh): ')
  [ -n "$line" ] || line=$(printf '%s\n' "$1" | grep -v '^[[:space:]]*$' | tail -n 1)
  echo "$line"
}

# 6. The workspace repo (cbundy/dev-system#77). The image carries only the
#    repo's URL (DEV_REPO_URL, set by CI in a consumer image); the checkout is
#    work in progress, so it lives in persistent storage, at DEV_WORKSPACE
#    (default /workspaces/<repo name>, see workspace.sh):
#    - missing or an empty directory: clone it (DEV_REPO_BRANCH, if set);
#    - already a git repo (an earlier start's clone, a bind-mounted
#      checkout): fetch only. Never a pull or merge, which would sooner or
#      later collide with uncommitted work, branches or agent worktrees;
#    - anything else in the way: warn and leave it alone.
#    After step 5, so gh's credential helper is in place. A clone is tried
#    even without any credential (a public repo needs none); if that fails
#    for want of one, it waits for a GitHub login: dev-login runs this step
#    again (dev-init --repo) once gh's login is done. git never prompts, and
#    each git call is limited to 120s, so a start never hangs here.
sync_repo() {
  local url="${DEV_REPO_URL:-}" ws="${DEV_WORKSPACE:-}" out rc reason ssh
  local -a clone=(clone --quiet) gitx=(git)
  # Token mode: Coder's GIT_ASKPASS (external auth) is never used; gh's credential helper answers.
  ! gh_token_mode || gitx=(env -u GIT_ASKPASS git)
  [ -n "$url" ] || return 0
  if [ -z "$ws" ]; then
    log "WARNING: no directory name in DEV_REPO_URL ($url) - nothing cloned."
    log "  Fix: set DEV_WORKSPACE to the directory to clone into."
    return 0
  fi
  # git must fail, not wait for an answer nobody can give.
  local ssh_cmd="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"

  if [ -e "$ws/.git" ]; then
    # No remote (or a repo git refuses to read, which step 7 reports): nothing to fetch.
    [ -n "$(git -C "$ws" remote 2>/dev/null)" ] || return 0
    out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$ssh_cmd" timeout -k 10 120 "${gitx[@]}" -C "$ws" fetch --prune --quiet 2>&1) \
      || log "WARNING: git fetch in $ws failed ($(git_reason "$out")) - carrying on with the refs already there"
    return 0
  fi
  if [ -n "$(ls -A "$ws" 2>/dev/null)" ]; then
    log "WARNING: $ws is not empty and not a git repository - DEV_REPO_URL is not cloned into it."
    log "  Fix: move its contents away and run: dev-init --repo (or set DEV_WORKSPACE to another directory)"
    return 0
  fi

  # GIT_ASKPASS and gh's credential helper answer only for HTTPS. The first
  # matching pattern wins: an scp-like [user@]host:path is SSH too.
  case "$url" in
    ssh://* | *+ssh://* | ssh+*://*) ssh=true ;;
    *://* | /*) ssh=false ;;
    *:*) ssh=true ;;
    *) ssh=false ;;
  esac
  [ "$ssh" = false ] || log "WARNING: DEV_REPO_URL is an SSH URL ($url), which needs SSH keys in this container (only HTTPS works with GIT_ASKPASS or gh's login). Trying anyway."

  [ -z "${DEV_REPO_BRANCH:-}" ] || clone+=(--branch "$DEV_REPO_BRANCH")
  out=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="$ssh_cmd" timeout -k 10 120 "${gitx[@]}" "${clone[@]}" -- "$url" "$ws" 2>&1)
  rc=$?
  if [ "$rc" -eq 0 ]; then
    log "cloned $url${DEV_REPO_BRANCH:+ (branch $DEV_REPO_BRANCH)} into $ws"
    return 0
  fi
  case "$rc" in
    124 | 137) reason="it did not finish within 120s" ;;
    *) reason=$(git_reason "$out") ;;
  esac
  log "WARNING: could not clone $url into $ws: $reason"
  if ! has_git_credential "$url" \
    && printf '%s\n' "$out" | grep -qiE 'could not read (username|password)|authentication failed|terminal prompts disabled|repository not found'; then
    log "  Waiting for a GitHub login: git has no credential for it yet. dev-login clones it once gh is logged in (see its sign-in link); after a login made any other way, run: dev-init --repo"
  else
    log "  Fix: check DEV_REPO_URL${DEV_REPO_BRANCH:+ and DEV_REPO_BRANCH} and that git's credential here can read the repo, then run: dev-init --repo"
  fi
}

# 7. no-mistakes in a gated workspace. Registration persists in NM_HOME, but
#    the daemon is a process and is gone after every restart, so it is started
#    whenever the workspace opts in (restarted instead when step 4 changed the
#    managed block under a daemon that is already running). Then the callum-tools recovery re-registers
#    a repo the daemon has lost (e.g. a fresh volume).
#    `daemon start` waits up to 135s for a daemon that never answers
#    (cbundy/dev-system#101), so each call here has its own short limit: a
#    stuck no-mistakes never holds up the steps after this one (the login page
#    above all). The recovery script bounds its own calls; the outer limit is
#    only a backstop.
NM_START_LIMIT=30
NM_RECOVER_LIMIT=100
recover_no_mistakes() {
  local ws top out rc action nm_home="${NM_HOME:-/persist/no-mistakes}"
  # shellcheck disable=SC2119 # the argument is optional; none means the default
  ws=$(workspace)
  command -v no-mistakes >/dev/null 2>&1 || return 0
  [ -d "$ws" ] || return 0
  if ! top=$(git -C "$ws" rev-parse --show-toplevel 2>/dev/null); then
    if [ -e "$ws/.git" ]; then
      log "WARNING: git cannot read the repo at $ws (owned by $(stat -c %U "$ws" 2>/dev/null), not $(id -un)) - no-mistakes recovery skipped."
      log "  Fix: chown -R 1000:1000 the checkout, or: git config --global --add safe.directory $ws"
    fi
    return 0
  fi
  [ -f "$top/.no-mistakes.yaml" ] || return 0
  [ -w "$nm_home" ] || return 0
  # A daemon already running (a second dev-init in this container) read the
  # config before step 4 rewrote the managed block, so it is restarted to see it.
  # `daemon status` exits 0 either way; only its text tells running from not.
  action=start
  if [ "$NM_PIN_CHANGED" = true ] \
    && out=$(cd "$top" && timeout -k 5 "$NM_START_LIMIT" no-mistakes daemon status </dev/null 2>&1) \
    && printf '%s\n' "$out" | grep -qi 'daemon running'; then
    action=restart
  fi
  out=$(cd "$top" && timeout -k 5 "$NM_START_LIMIT" no-mistakes daemon "$action" </dev/null 2>&1)
  rc=$?
  case "$rc" in
    0) [ "$action" = start ] || log "restarted the no-mistakes daemon so it runs on the new agent order and model pin" ;;
    124 | 137)
      log "WARNING: no-mistakes daemon $action did not finish within ${NM_START_LIMIT}s - the no-mistakes daemon is not running, and the repo recovery is skipped."
      log "  Fix: see $nm_home/logs (cli.log, daemon-bootstrap.log), then run in $top: no-mistakes daemon $action && no-mistakes init"
      return 0
      ;;
    *)
      # Already running is the normal case on a second dev-init.
      printf '%s\n' "$out" | grep -qi 'already running' \
        || log "WARNING: no-mistakes daemon $action failed: $(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 1)"
      ;;
  esac
  ( cd "$top" && timeout -k 5 "$NM_RECOVER_LIMIT" "$CALLUM_TOOLS/recover-no-mistakes.sh" </dev/null )
  case $? in
    124 | 137) log "WARNING: the no-mistakes recovery did not finish within ${NM_RECOVER_LIMIT}s - stopped. Fix: run in $top: no-mistakes init" ;;
  esac
  return 0
}

# Sets a top-level key in a TOML file: replaced where it already appears
# before the first [table], otherwise prepended (top-level keys must come
# before any table). The value is passed through the environment, not awk -v,
# so backslashes in it reach the file unchanged. With "seed" as the fourth
# argument an existing key is left alone. The file is rewritten only on a
# change, and through mktemp, so it stays 0600 (it can hold tokens).
set_toml_top_key() {
  local file="$1" key="$2" value="$3" mode="${4:-set}" tmp present=false rc
  if [ -f "$file" ] && K="$key" awk '/^[[:space:]]*\[/ { exit 1 } $0 ~ ("^[[:space:]]*" ENVIRON["K"] "[[:space:]]*=") { found = 1; exit } END { exit !found }' "$file"; then
    present=true
    [ "$mode" = seed ] && return 0
    grep -qxF -- "$key = $value" "$file" && return 0
  fi
  tmp=$(mktemp "$file.XXXXXX") || return 1
  if [ "$present" = true ]; then
    K="$key" V="$value" awk '
      /^[[:space:]]*\[/ { in_table = 1 }
      !in_table && $0 ~ ("^[[:space:]]*" ENVIRON["K"] "[[:space:]]*=") { print ENVIRON["K"] " = " ENVIRON["V"]; next }
      { print }' "$file" > "$tmp"
  else
    {
      printf '%s = %s\n' "$key" "$value"
      if [ -f "$file" ]; then cat "$file"; fi
    } > "$tmp"
  fi
  rc=$?
  [ "$rc" -eq 0 ] && mv "$tmp" "$file"
  rc=$?
  rm -f "$tmp"
  return "$rc"
}

# 8. agentsview session push. With a PostgreSQL URL configured (the
#    agentsview-pg-url secret file, or AGENTSVIEW_PG_URL: agentsview.sh), keep
#    `agentsview pg push --watch` running so this machine's Claude and codex
#    sessions reach the central PostgreSQL that `agentsview pg serve` reads.
#    The data dir holds the installation ID that identifies this machine in
#    the shared database, so it must persist, and it follows the Claude and
#    codex volumes: by default each repo (or workspace) has its own, so each is
#    one machine. Containers that do share these volumes are one machine too:
#    agentsview's own lock in the data dir lets one container push at a time,
#    and the loop in the others takes over when that container stops. The
#    container-local lock below only stops a second dev-init in the same
#    container from starting a second loop. The machine's label is
#    DEV_MACHINE_NAME, or on the desktop desktop-<checkout folder>, seeded
#    only, so a label set in config.toml by hand stays.
start_agentsview_push() {
  local data="${AGENTSVIEW_DATA_DIR:-/persist/agentsview}" name="" name_mode=set rc=0
  # shellcheck source=agentsview.sh
  . /usr/local/share/dev-system/agentsview.sh
  agentsview_pg_url >/dev/null || rc=$?
  [ "$rc" -eq 1 ] && return 0
  if [ "$rc" -ne 0 ]; then
    log "WARNING: $(agentsview_pg_url_file) is empty or not readable by $(id -un) - agentsview session push not started (dev-doctor has the fix)."
    return 0
  fi
  command -v agentsview >/dev/null 2>&1 || return 0
  if [ ! -w "$data" ]; then
    log "WARNING: $data is not writable - agentsview session push not started."
    return 0
  fi
  # The push starts a local agentsview daemon. Its default port, 8080, is one
  # a repo's own dev server is likely to want; a taken port falls through to
  # the next free one.
  set_toml_top_key "$data/config.toml" port 47180 seed \
    || log "WARNING: could not seed the agentsview daemon port in $data/config.toml"
  if [ -n "${DEV_MACHINE_NAME:-}" ]; then
    name="$DEV_MACHINE_NAME"
  elif [ "${DEV_DESKTOP:-0}" = 1 ]; then
    # shellcheck disable=SC2119 # the argument is optional; none means the default
    name="desktop-$(basename "$(workspace)")"
    name_mode=seed
  fi
  if [ -n "$name" ]; then
    name=$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')
    set_toml_top_key "$data/config.toml" local_machine_name "\"$name\"" "$name_mode" \
      || log "WARNING: could not set local_machine_name in $data/config.toml"
  fi
  # Already running in this container (dev-init ran before, e.g. by hand).
  flock -n "$AGENTSVIEW_PUSH_LOCK" true 2>/dev/null || return 0
  : > "$AGENTSVIEW_PUSH_LOG"
  setsid nohup flock -n "$AGENTSVIEW_PUSH_LOCK" /usr/local/share/dev-system/agentsview-push-loop \
    >> "$AGENTSVIEW_PUSH_LOG" 2>&1 < /dev/null &
  log "started agentsview session push (log: $AGENTSVIEW_PUSH_LOG, $data/pg-watch.log)"
}

# 8b. The factory event log push (cbundy/dev-system#740): with the writer
#      secret of the factory database, keep factory-event-push-loop running so
#      the lines callum-flow-event appends to <events dir>/factory reach
#      factory.event_store. The old event-push-loop is no longer started: callum-flow-event
#      writes no old log lines (cbundy/dev-system#1143), so factory.events gets no new rows.
start_factory_event_push() {
  local rc=0
  # shellcheck source=factory-db.sh
  . /usr/local/share/dev-system/factory-db.sh
  factory_db_url writer >/dev/null || rc=$?
  case "$rc" in
    0) ;;
    1) return 0 ;;
    *) log "WARNING: $(factory_db_url_file writer) is empty or not readable - factory event push (new log) not started."; return 0 ;;
  esac
  command -v psql >/dev/null 2>&1 || { log "WARNING: psql is not on PATH - factory event push (new log) not started. This image is older than the base image that ships postgresql-client: rebuild the container (dev-restart-self, or Rebuild Container); do not install it by hand."; return 0; }
  [ -w "${CALLUM_EVENTS_DIR:-/persist/events}" ] || { log "WARNING: ${CALLUM_EVENTS_DIR:-/persist/events} is not writable - factory event push (new log) not started."; return 0; }
  flock -n "$FACTORY_EVENT_PUSH_LOCK" true 2>/dev/null || return 0
  : > "$FACTORY_EVENT_PUSH_LOG"
  setsid nohup flock -n "$FACTORY_EVENT_PUSH_LOCK" /usr/local/share/dev-system/factory-event-push-loop \
    >> "$FACTORY_EVENT_PUSH_LOG" 2>&1 < /dev/null &
  log "started factory event push (new log) (log: $FACTORY_EVENT_PUSH_LOG)"
}

# 8d. The worker heartbeat (cbundy/dev-system#339): with either the agentsview
#     PostgreSQL URL or the factory database writer URL, keep heartbeat-loop
#     running so this device's factory.workers row (in each configured database)
#     says it is alive, what it runs and whether it is busy.
start_heartbeat() {
  # shellcheck source=factory-db.sh
  . /usr/local/share/dev-system/factory-db.sh
  # off, or unreadable counts as not configured (steps 8 and 8c already warned)
  if ! agentsview_pg_url >/dev/null 2>&1 && ! factory_db_url writer >/dev/null 2>&1; then return 0; fi
  command -v psql >/dev/null 2>&1 || { log "WARNING: psql is not on PATH - worker heartbeat not started. This image is older than the base image that ships postgresql-client: rebuild the container (dev-restart-self, or Rebuild Container); do not install it by hand."; return 0; }
  flock -n "$HEARTBEAT_LOCK" true 2>/dev/null || return 0
  : > "$HEARTBEAT_LOG"
  setsid nohup flock -n "$HEARTBEAT_LOCK" /usr/local/share/dev-system/heartbeat-loop \
    >> "$HEARTBEAT_LOG" 2>&1 < /dev/null &
  log "started worker heartbeat (log: $HEARTBEAT_LOG)"
}

# 9. The shared files mount (DEV_SHARED_DIR) is optional, so an unmounted one
#    is left alone. A mount node cannot write gets a warning naming the fix.
check_shared_dir() {
  local dir="${DEV_SHARED_DIR:-/shared}"
  mountpoint -q "$dir" 2>/dev/null || return 0
  [ -w "$dir" ] && return 0
  log "WARNING: $dir is mounted but not writable by $(id -un) ($(id -u):$(id -g)) - files cannot be shared through it."
  log "  Fix: squash all NFS clients to a NAS user that can write the export (Linux exports: all_squash,anonuid=1000,anongid=1000; TrueNAS: Mapall User/Group), or own it by UID 1000 (a Docker volume: chown 1000:1000)."
}

# 10. The login page (dev-login serve), only when DEV_LOGIN_PORT is set: no
#     port is opened by default. It runs in the background, one per container,
#     and exits by itself once every login is done (unless
#     DEV_LOGIN_PAGE_EXIT=0).
start_login_page() {
  [ -n "${DEV_LOGIN_PORT:-}" ] || return 0
  command -v dev-login >/dev/null 2>&1 || return 0
  flock -n "$LOGIN_PAGE_LOCK" true 2>/dev/null || return 0
  : > "$LOGIN_PAGE_LOG"
  setsid nohup flock -n "$LOGIN_PAGE_LOCK" dev-login serve >> "$LOGIN_PAGE_LOG" 2>&1 < /dev/null &
  log "started the login page on port $DEV_LOGIN_PORT (log: $LOGIN_PAGE_LOG)"
}

# 11. The Claude plugins (plugins.sh): the image's default plugins
#     (DEV_DEFAULT_PLUGINS, cbundy/dev-system#148 - callum-flow, so every
#     workspace has the dev-system skills, with or without a repo) and the
#     ones the workspace repo's committed .claude/settings.json enables (#112).
#     A repo can enable plugins (enabledPlugins) from marketplaces it declares
#     (extraKnownMarketplaces), but Claude installs them only from its
#     interactive folder-trust prompt, which a headless session, or any session
#     on a fresh CLAUDE_CONFIG_DIR volume, may never show. So each wanted plugin
#     that Claude has not installed is installed here (user scope, in
#     CLAUDE_CONFIG_DIR), after adding its marketplace when Claude does not know
#     it yet: a repo plugin's from the source the repo declares (github or
#     git), a default plugin's from the source DEV_DEFAULT_PLUGINS gives.
#     An install that fails
#     on a marketplace Claude already knew is retried once after updating it
#     (the plugin may be newer than the marketplace's copy). Failures are
#     logged and the start carries on. A marketplace whose ref moved is
#     removed and re-added, and the user-scope plugins installed from it
#     (hand-installed too) come back; project-scope installs whose project
#     directory is gone are pruned.
#     Last in a full run: it needs the network and can be slow, the plugins
#     matter only once Claude starts, and a runtime that bounds dev-init as a
#     whole (Coder: 300s) must never lose the login page to it. So the whole
#     step has a deadline (DEV_PLUGIN_INSTALL_TIMEOUT, default 120s), each CLI
#     call is limited to 60s or what is left of it, and once it has passed the
#     plugins not yet installed get one WARNING. In dev-init --repo it runs
#     right after step 6, so a fresh clone counts; dev-init --plugins runs only
#     this step.

# write_versions: refresh the version snapshot (dev-version --snapshot,
# ${DEV_VERSIONS_FILE:-/tmp/dev-versions.json}) that the heartbeat and the
# reconciler read. Local lookups only; a failure is logged, never fatal.
write_versions() {
  dev-version --snapshot > /dev/null 2>&1 || log "WARNING: could not write the version snapshot"
}

# run_factory_db_migrate: bring the factory database's schema up to this image's version before
# the loop starts (cbundy/dev-system#888). factory-db-migrate does nothing without the migrator's
# secret, bounds itself (DEV_FACTORY_DB_MIGRATE_TIMEOUT, default 120s), records its outcome in
# ${DEV_FACTORY_DB_MIGRATE_STATUS:-/tmp/dev-factory-db-migrate.json}, which the loop's schema rail
# reads, and always exits 0 here. An image without the command is skipped.
run_factory_db_migrate() {
  local out line
  if ! command -v factory-db-migrate > /dev/null 2>&1; then
    log "factory-db-migrate is not in this image, skipping the schema migrate"
    return 0
  fi
  out=$(factory-db-migrate 2>&1) || log "WARNING: factory-db-migrate exited $?"
  while IFS= read -r line; do
    [ -z "$line" ] || log "$line"
  done <<< "$out"
}

if [ "${1:-}" = --repo ]; then
  setup_gh_token
  setup_git_credentials
  sync_repo
  install_plugins
  write_versions
  recover_no_mistakes
  exit 0
fi
if [ "${1:-}" = --plugins ]; then
  install_plugins
  write_versions
  exit 0
fi

check_persist_dirs
setup_coder_login
resume_restart_self
seed_claude_config
adopt_claude_login
seed_codex_config
configure_codex_otel
seed_no_mistakes_model
setup_claude_api_key
setup_gh_token
setup_git_credentials
sync_repo
run_factory_db_migrate
recover_no_mistakes
write_versions
start_agentsview_push
start_factory_event_push
start_heartbeat
check_shared_dir
start_login_page
install_plugins
write_versions

# 12. Report anything still broken, without failing the start.
dev-doctor --warn-only || true
exit 0
