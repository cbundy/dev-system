#!/bin/bash
#
# dev-remote-sessions: brings the Remote Control sessions that were live when the
# container stopped back online after a restart (cbundy/dev-system#533).
#
# Claude Code keeps a record of every running session in
# $CLAUDE_CONFIG_DIR/sessions/<pid>.json (sessionId, cwd, kind, name, tmux,
# bridgeSessionId, procStart, updatedAt) and deletes it on a graceful exit. A
# container stop SIGKILLs what is still running, so those records stay behind
# and, until now, nothing read them. This helper reads them (an undocumented
# format, so it is parsed defensively: a missing field or bad JSON skips that
# record with a log line, never an error) and starts each session again in its
# own cwd, in the tmux session `rc-restored` (one window per session):
#   - a session a `claude remote-control` server spawned (entrypoint sdk-cli),
#     when no supervisor server runs (session mode), is reattached with
#     `claude remote-control --session-id cse_<id>`: the same claude.ai
#     session comes back online, its history loaded from claude.ai, with the
#     server's permission mode. Its transcript records neither its claude.ai
#     session nor its permission mode, so resuming it as an interactive
#     session would open a new claude.ai session instead.
#   - in server mode (DEV_REMOTE_CONTROL_MODE=server) such a session is NOT
#     started: the supervisor's server registers again on its prior
#     environment, reconnects the sessions it lists itself and picks up the
#     others when work arrives. A `--session-id` reattach would register on
#     that same environment from the session's worktree, where its "already
#     served" guard (it reads the bridge pointer of its own cwd) never fires,
#     so it would poll the server's work and tear the environment down when
#     it ends. The session is only written to the ledger, and its worktree is
#     kept (see cwds) for DEV_REMOTE_CONTROL_RESTORE_HOURS.
#   - any other session is resumed with
#     `claude --resume <id> --remote-control <name>`, with the permission
#     mode, effort and model from its transcript.
# No message is sent: a restored session waits for the owner.
#
# Usage: dev-remote-sessions <command>
#   snapshot  record the live sessions (pid and process start still match) in the
#             state dir, replacing the last snapshot, each with updatedAt
#             raised to the snapshot time (when it was last seen live). A
#             session that ends gracefully is thereby remembered until the
#             next snapshot. The
#             session of the supervisor's own Claude (or Remote Control server)
#             process is also recorded in supervisor/, for good (`plan` adopts
#             the stale records in tmux session `claude` while it is empty). A no-op
#             until `restore` ran this boot, so a boot that never restores never
#             overwrites the snapshot the restore needs.
#   plan      once per boot (exit 3 when already done): freeze the restore
#             candidates into pending.json. dev-remote-control runs it before
#             it prunes worktrees.
#   pending   recompute the current candidates (JSON lines), without changing
#             the frozen plan in pending.json.
#   taken     print the sessionIds the supervisor must not resume: the live
#             sessions, the planned restores and the sessions already restored.
#   cwds      print "live<TAB>dir" / "pending<TAB>dir" for every live session,
#             every planned (or, before `plan`, candidate) restore and every
#             server-spawned session `restore` left to the server (within the
#             window): dev-prune-worktrees keeps these.
#   restore   once per boot (exit 3 when already done): start each planned
#             session that is not live (server mode: except server-spawned
#             ones, left to the server), record every record it considered in
#             the ledger.
#
# Candidates are the latest snapshot plus stale records (their process is gone),
# deduplicated by sessionId (server-spawned ones by bridgeSessionId), minus:
# sessions that are live, the supervisor's own sessions (in supervisor/),
# records without a bridgeSessionId, non-interactive sessions, sessions last
# seen live (last updated, or last snapshotted) more than
# DEV_REMOTE_CONTROL_RESTORE_HOURS (default 24, 0 turns restoring off) ago,
# sessions with no transcript (server-spawned ones need none), and records
# already in the ledger.
#
# State, in ${DEV_RESTART_SELF_DIR:-/persist/dev-restart-self}/remote-sessions:
#   snapshot/  the last snapshot        pending.json  the planned candidates
#   ledger/    one file per record considered, so a session is never restored
#              twice (a session the owner later exits stays gone)
#   supervisor/  one file per sessionId the supervisor's process ran
# Per-boot markers live in /tmp (they hold pid 1's start time, so a container
# restart invalidates them).
#
# Test overrides: DEV_REMOTE_SESSIONS_SOCKET (tmux -L socket), DEV_SYSTEM_SHARE.
set -u

CFG=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
SESS_DIR=$CFG/sessions
STATE=${DEV_RESTART_SELF_DIR:-/persist/dev-restart-self}/remote-sessions
SHARE=${DEV_SYSTEM_SHARE:-/usr/local/share/dev-system}
MARK_DIR=${DEV_REMOTE_SESSIONS_MARK_DIR:-/tmp}
HOURS=${DEV_REMOTE_CONTROL_RESTORE_HOURS:-24}
case $HOURS in '' | *[!0-9]*) HOURS=24 ;; esac
RESTORED_SESSION=rc-restored
SUPERVISOR_SESSION=claude

log() {
  echo "dev-remote-sessions: $*" >&2
}

# shellcheck source=claude-config.sh
. "$SHARE/claude-config.sh" 2>/dev/null || prepare_claude_config() { :; }

tm() {
  if [ -n "${DEV_REMOTE_SESSIONS_SOCKET:-}" ]; then
    TMUX='' tmux -L "$DEV_REMOTE_SESSIONS_SOCKET" "$@"
  else
    tmux "$@"
  fi
}

# Field 22 of /proc/<pid>/stat (the process start time), the way Claude records
# it as procStart. The command name (field 2) may hold spaces, so cut after ")".
proc_start() {
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "${20:-}"
}

# Field 4 of /proc/<pid>/stat (the parent pid).
proc_ppid() {
  local s
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "${2:-}"
}

# This boot's identity: pid 1's start time (a container restart changes it).
boot_id() {
  proc_start 1 || echo unknown
}

marked() { [ "$(cat "$MARK_DIR/dev-remote-sessions.$1" 2>/dev/null)" = "$(boot_id)" ]; }
mark() { boot_id > "$MARK_DIR/dev-remote-sessions.$1" 2>/dev/null; }

# Normalized records of every readable <dir>/*.json, one JSON line each.
load_dir() {
  local f
  for f in "$1"/*.json; do
    [ -f "$f" ] || continue
    jq -ce 'select(type == "object" and (.pid | type == "number") and (.sessionId | type == "string"))
      | {pid, procStart: ((.procStart // "") | tostring), sessionId, cwd: (.cwd // ""),
         kind: (.kind // ""), name: (.name // ""), bridgeSessionId: (.bridgeSessionId // ""),
         tmux: (.tmux // ""), entrypoint: (.entrypoint // ""), updatedAt: (.updatedAt // 0)}' "$f" 2>/dev/null ||
      log "skipping $f: not a session record"
  done
}

# Is the process in record $1 (JSON line) still the one that wrote it?
is_live() {
  local pid start
  pid=$(jq -r .pid <<< "$1") start=$(jq -r .procStart <<< "$1")
  kill -0 "$pid" 2>/dev/null || return 1
  [ -z "$start" ] || [ "$(proc_start "$pid")" = "$start" ]
}

# The pid of the process in the first window of the supervisor's tmux session
# (dev-remote-control's pane: a shell running Claude, or Claude itself).
supervisor_pane() {
  tm display-message -p -t "=$SUPERVISOR_SESSION:^" '#{pane_pid}' 2>/dev/null
}

# Is record $1 the supervisor's own process: the pane process $2 or its child?
is_supervisor() {
  local pid
  pid=$(jq -r .pid <<< "$1")
  [ "$pid" = "$2" ] || [ "$(proc_ppid "$pid")" = "$2" ]
}

rec_key() { jq -r '"\(.pid)-\(.procStart)"' <<< "$1"; }

live_records() {
  local r
  while IFS= read -r r; do
    [ -z "$r" ] || ! is_live "$r" || echo "$r"
  done < <(load_dir "$SESS_DIR")
}

live_sids() {
  live_records | jq -r .sessionId
}

# The restore candidates, as JSON lines carrying the transcript's permission
# mode, effort and model.
candidates() {
  local live all r now_ms cutoff sup
  live=$(live_records)
  all=$(
    load_dir "$STATE/snapshot"
    load_dir "$SESS_DIR"
  )
  [ -n "$all" ] || return 0
  now_ms=$(($(date +%s) * 1000))
  cutoff=$((now_ms - HOURS * 3600000))
  # Records not live and not in the ledger; then one per session.
  local kept=""
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    is_live "$r" && continue
    [ ! -e "$STATE/ledger/$(rec_key "$r")" ] || continue
    kept="$kept$r
"
  done <<< "$all"
  [ -n "$kept" ] || return 0
  sup=$(find "$STATE/supervisor" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | jq -Rcs 'split("\n") | map(select(. != ""))')
  # A server can run one claude.ai session under more than one local sessionId
  # over time, so server-spawned records are one per claude.ai session instead.
  jq -cs --argjson live "$(printf '%s\n' "$live" | jq -cs '[.[] | .sessionId, .bridgeSessionId | select(. != "")]')" \
    --argjson cutoff "$cutoff" --argjson sup "$sup" '
    def spawned: .entrypoint == "sdk-cli" and (.bridgeSessionId | test("^session_[A-Za-z0-9]+$"));
    group_by(if spawned then .bridgeSessionId else .sessionId end)
    | map({keys: map("\(.pid)-\(.procStart)")} + (max_by(.updatedAt)))
    | .[]
    | select(.kind == "interactive" and .bridgeSessionId != "" and .cwd != "" and .updatedAt >= $cutoff
        and (.sessionId as $s | ($live + $sup) | index($s) | not)
        and ((spawned and (.bridgeSessionId as $b | $live | index($b))) | not))' <<< "$kept" |
    while IFS= read -r r; do
      enrich "$r" || true
    done
}

# Did a `claude remote-control` server spawn the session in record $1? Its
# children run Claude through the SDK, and claude.ai knows the session as
# cse_<id> for the record's bridgeSessionId session_<id>.
server_spawned() {
  jq -e '.entrypoint == "sdk-cli" and (.bridgeSessionId | test("^session_[A-Za-z0-9]+$"))' <<< "$1" > /dev/null 2>&1
}

# Adds the transcript's permissionMode, effort and model to candidate $1 and
# prints it; fails (logged) when the session has no transcript. A
# server-spawned session is printed as it is: claude.ai holds its history and
# the server's permission mode applies.
enrich() {
  local sid cwd t line mode effort model
  if server_spawned "$1"; then
    echo "$1"
    return 0
  fi
  sid=$(jq -r .sessionId <<< "$1") cwd=$(jq -r .cwd <<< "$1")
  t=$CFG/projects/${cwd//[^a-zA-Z0-9]/-}/$sid.jsonl
  if [ ! -f "$t" ]; then
    t=$(find "$CFG/projects" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -n 1)
  fi
  if [ -z "$t" ] || [ ! -f "$t" ]; then
    log "session $sid has no transcript: not restoring it"
    return 1
  fi
  mode=$(grep '"type":"permission-mode"' "$t" 2>/dev/null | tail -n 1 | jq -r '.permissionMode // empty' 2>/dev/null)
  line=$(grep '"type":"assistant"' "$t" 2>/dev/null | grep -v '"model":"<synthetic>"' | tail -n 1)
  effort=$(jq -r '.effort // empty' <<< "$line" 2>/dev/null)
  model=$(jq -r '.message.model // empty' <<< "$line" 2>/dev/null)
  jq -c --arg m "$mode" --arg e "$effort" --arg mo "$model" '. + {permissionMode: $m, effort: $e, model: $mo}' <<< "$1" 2>/dev/null
}

cmd_snapshot() {
  marked restored || return 0
  local tmp r pane sid now_ms
  mkdir -p "$STATE" || { log "cannot create $STATE"; return 1; }
  tmp=$(mktemp -d "$STATE/.snapshot.XXXXXX") || return 1
  pane=$(supervisor_pane)
  now_ms=$(($(date +%s) * 1000))
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    jq -c --argjson now "$now_ms" '.updatedAt = ([.updatedAt, $now] | max)' <<< "$r" > "$tmp/$(rec_key "$r").json"
    if [ -n "$pane" ] && is_supervisor "$r" "$pane"; then
      sid=$(jq -r .sessionId <<< "$r")
      case $sid in '' | *[!A-Za-z0-9-]*) ;; *) mkdir -p "$STATE/supervisor" && : > "$STATE/supervisor/$sid" ;; esac
    fi
  done < <(live_records)
  rm -rf "$STATE/snapshot"
  mv "$tmp" "$STATE/snapshot"
}

# Until a snapshot has identified the supervisor's process (supervisor/ is
# empty, as on the first start of an image with this helper), the supervisor's
# own sessions in session mode are the stale records in its tmux session: they
# are recorded in supervisor/, so they are never restored and stay the
# conversation DEV_REMOTE_CONTROL_RESUME resumes. In server mode such records
# are the server's spawned sessions, which the server takes back
# (restore leaves them to it).
adopt_supervisor_records() {
  local r sid
  [ "${DEV_REMOTE_CONTROL_MODE:-session}" = session ] || return 0
  [ -z "$(find "$STATE/supervisor" -mindepth 1 -maxdepth 1 2>/dev/null)" ] || return 0
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    is_live "$r" && continue
    [ "$(jq -r '.tmux | split(":")[0]' <<< "$r")" = "$SUPERVISOR_SESSION" ] || continue
    sid=$(jq -r .sessionId <<< "$r")
    case $sid in '' | *[!A-Za-z0-9-]*) ;; *) mkdir -p "$STATE/supervisor" && : > "$STATE/supervisor/$sid" ;; esac
  done < <(load_dir "$SESS_DIR")
}

cmd_plan() {
  marked planned && return 3
  mkdir -p "$STATE" || { log "cannot create $STATE"; return 1; }
  adopt_supervisor_records
  if [ "$HOURS" = 0 ]; then
    : > "$STATE/pending.json"
  else
    candidates > "$STATE/pending.json.tmp" && mv "$STATE/pending.json.tmp" "$STATE/pending.json"
  fi
  mark planned
  log "$(grep -c . "$STATE/pending.json" 2>/dev/null || echo 0) session(s) to restore"
}

cmd_cwds() {
  local r
  while IFS= read -r r; do
    [ -z "$r" ] || printf 'live\t%s\n' "$(jq -r .cwd <<< "$r")"
  done < <(live_records)
  [ "$HOURS" != 0 ] || return 0
  while IFS= read -r r; do
    [ -z "$r" ] || printf 'pending\t%s\n' "$(jq -r .cwd <<< "$r")"
  done < <(if [ -f "$STATE/pending.json" ]; then cat "$STATE/pending.json"; else candidates; fi)
  # Server-spawned sessions left to the server keep their worktree for the
  # window, so a server restart later in the boot cannot prune it. Ledger line:
  # "<sid> <epoch> server-left <cwd>".
  local f sid epoch tag cwd live now
  live=$(live_sids)
  now=$(date +%s)
  for f in "$STATE/ledger"/*; do
    [ -f "$f" ] || continue
    IFS=' ' read -r sid epoch tag cwd < "$f" || true
    [ "${tag:-}" = server-left ] || continue
    [ -n "${cwd:-}" ] || continue
    case $epoch in '' | *[!0-9]*) continue ;; esac
    [ $((now - epoch)) -lt $((HOURS * 3600)) ] || continue
    ! grep -qxF -e "$sid" <<< "$live" || continue
    printf 'pending\t%s\n' "$cwd"
  done
}

launch() {
  local sid cwd name mode effort model
  sid=$(jq -r .sessionId <<< "$1") cwd=$(jq -r .cwd <<< "$1") name=$(jq -r .name <<< "$1")
  mode=$(jq -r .permissionMode <<< "$1") effort=$(jq -r .effort <<< "$1") model=$(jq -r .model <<< "$1")
  if [ ! -d "$cwd" ]; then
    log "session $sid: $cwd no longer exists, not restoring it"
    return 1
  fi
  [ -n "$name" ] || name="restored-${sid:0:8}"
  local -a args
  if server_spawned "$1"; then
    # Reattached as the server would spawn it: same claude.ai session, the
    # server's permission mode (dev-remote-control's), no --resume.
    args=(remote-control --session-id "cse_$(jq -r '.bridgeSessionId | ltrimstr("session_")' <<< "$1")")
    if [ "${DEV_REMOTE_CONTROL_SKIP_PERMISSIONS:-0}" = 1 ]; then
      prepare_claude_config "$cwd" 1
      args+=(--permission-mode bypassPermissions)
    else
      prepare_claude_config "$cwd"
    fi
  else
    prepare_claude_config "$cwd"
    args=(--resume "$sid" --remote-control "$name")
    case $mode in
      bypassPermissions) args+=(--dangerously-skip-permissions --settings '{"skipDangerousModePermissionPrompt":true}') ;;
      "" | default) ;;
      *) args+=(--permission-mode "$mode") ;;
    esac
    [ -z "$effort" ] || args+=(--effort "$effort")
    [ -z "$model" ] || args+=(--model "$model")
  fi
  # shellcheck disable=SC2016
  local -a cmd=(bash -c ". '$SHARE/telemetry.sh'; claude \"\$@\"" bash "${args[@]}")
  if tm has-session -t "=$RESTORED_SESSION" 2>/dev/null; then
    tm new-window -d -t "=$RESTORED_SESSION:" -n "${sid:0:8}" -c "$cwd" "${cmd[@]}" 9>&-
  else
    tm new-session -d -s "$RESTORED_SESSION" -n "${sid:0:8}" -c "$cwd" "${cmd[@]}" 9>&-
  fi || { log "session $sid: could not start it in tmux"; return 1; }
  log "restored session $sid (\"$name\") in $cwd - attach: tmux attach -t $RESTORED_SESSION"
}

cmd_taken() {
  live_sids
  [ ! -f "$STATE/pending.json" ] || jq -r '.sessionId // empty' "$STATE/pending.json" 2>/dev/null
  cat "$STATE/ledger"/* 2>/dev/null | cut -d' ' -f1
}

cmd_restore() {
  marked restored && return 3
  mark restored
  [ "$HOURS" != 0 ] || return 0
  local r k sid bridge cwd mode_server=0 m
  [ "${DEV_REMOTE_CONTROL_MODE:-session}" != server ] || mode_server=1
  mkdir -p "$STATE/ledger" || { log "cannot create $STATE"; return 1; }
  if [ ! -f "$STATE/pending.json" ]; then
    candidates > "$STATE/pending.json"
  fi
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    sid=$(jq -r .sessionId <<< "$r" 2>/dev/null) || continue
    # Ledger first: whatever happens next, this record is never tried again.
    bridge="" cwd=""
    if server_spawned "$r"; then
      bridge=$(jq -r .bridgeSessionId <<< "$r")
      cwd=$(jq -r .cwd <<< "$r")
    fi
    for k in $(jq -r '.keys[]?' <<< "$r" 2>/dev/null); do
      if [ "$mode_server" = 1 ] && [ -n "$bridge" ]; then
        echo "$sid $(date +%s) server-left $cwd" > "$STATE/ledger/$k"
      else
        echo "$sid $(date +%s)" > "$STATE/ledger/$k"
      fi
    done
    if [ "$mode_server" = 1 ] && [ -n "$bridge" ]; then
      log "session $sid (claude.ai $bridge) is left to the Remote Control server, which serves its environment"
      continue
    fi
    if m=$(live_records | jq -r --arg s "$sid" \
      'select(.sessionId == $s) | "its local conversation \($s) is open in live session pid \(.pid) (claude.ai \(.bridgeSessionId))"' | head -n 1) && [ -n "$m" ]; then
      log "session $sid is already running: $m: not restoring it"
      continue
    fi
    if [ -n "$bridge" ] && m=$(live_records | jq -r --arg b "$bridge" \
      'select(.bridgeSessionId == $b) | "claude.ai session \($b) is already online (pid \(.pid))"' | head -n 1) && [ -n "$m" ]; then
      log "session $sid is already running: $m: not restoring it"
      continue
    fi
    launch "$r" || true
  done < "$STATE/pending.json"
  rm -f "$STATE/pending.json"
  return 0
}

case "${1:-}" in
  snapshot) cmd_snapshot ;;
  plan) cmd_plan ;;
  pending) candidates ;;
  taken) cmd_taken ;;
  cwds) cmd_cwds ;;
  restore) cmd_restore ;;
  *)
    echo "usage: dev-remote-sessions snapshot|plan|pending|taken|cwds|restore" >&2
    exit 2
    ;;
esac
