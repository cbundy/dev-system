# The models the no-mistakes pipeline runs on, for every dev-system workspace.
#
# The single source of truth: the base image bakes this file in, and dev-init
# rewrites the managed model pin in the global no-mistakes config from it on
# every start (env DEV_CODEX_MODEL / DEV_CLAUDE_MODEL override it). The
# deprecated callum-tools feature's codexModel default must match CODEX_MODEL
# (npm test checks it).
#
# Format: KEY=value lines, # comments and blank lines only. It is parsed, never
# sourced (images/base/models.sh): unknown keys are ignored, and a value must
# match [A-Za-z0-9._:/-]+ - no quotes, spaces or shell syntax.

# codex, the pipeline's first agent.
CODEX_MODEL=gpt-6.1-sol
# claude, the fallback agent.
CLAUDE_MODEL=claude-sonnet-5-5
