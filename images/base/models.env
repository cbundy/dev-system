# The agents and models the no-mistakes pipeline runs on, for every dev-system
# workspace.
#
# The single source of truth: edit here, merge to main, and every workspace
# picks it up on its next start - dev-init fetches this file from main
# (DEV_MODELS_URL) and rewrites the managed block in the global no-mistakes
# config from it (the agent order and the model pin), with no release or image
# rebuild. The image's baked copy is the offline fallback. Env DEV_NM_AGENTS /
# DEV_CODEX_MODEL / DEV_CLAUDE_MODEL / DEV_CLAUDE_EFFORT override both. A repo
# that sets `agent:` in its own .no-mistakes.yaml replaces the agent order for
# that repo.
# The deprecated callum-tools feature's codexModel default must match
# CODEX_MODEL (npm test checks it).
#
# Format: KEY=value lines, # comments and blank lines only. It is parsed, never
# sourced (images/base/models.sh): unknown keys are ignored, a model must match
# [A-Za-z0-9._:/-]+, CLAUDE_EFFORT is one of low, medium, high, xhigh, max,
# and AGENTS is comma-separated names, each matching [a-z0-9][a-z0-9:_-]* - no
# quotes, spaces or shell syntax.

# The pipeline's ordered agent list: no-mistakes moves to the next agent when
# one fails (e.g. out of usage). Written as `agent: [codex, claude]`.
AGENTS=codex,claude

# codex's model.
CODEX_MODEL=gpt-6.1-sol
# claude's model and reasoning effort (its --effort): the fallback when codex
# fails, e.g. out of usage.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
