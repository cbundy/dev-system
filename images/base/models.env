# The agents and models the no-mistakes pipeline runs on, for every dev-system
# workspace.
#
# The single source of truth: edit here, merge to main, and every workspace
# picks it up on its next start - dev-init fetches this file from main
# (DEV_MODELS_URL) and rewrites the managed block in the global no-mistakes
# config from it (the agent order, the model pin and the review roles), with no release or image
# rebuild. The image's baked copy is the offline fallback. Env DEV_NM_AGENTS /
# DEV_CODEX_MODEL / DEV_CLAUDE_MODEL / DEV_CLAUDE_EFFORT / DEV_REVIEW_AGENT /
# DEV_REVIEW_MODEL / DEV_REVIEW_EFFORT override both. A repo that sets `agent:`
# in its own .no-mistakes.yaml replaces the agent order for that repo.
# The deprecated callum-tools feature's codexModel default must match
# CODEX_MODEL (npm test checks it).
#
# Format: KEY=value lines, # comments and blank lines only. It is parsed, never
# sourced (images/base/models.sh): unknown keys are ignored, a model must match
# [A-Za-z0-9._:/-]+, CLAUDE_EFFORT and REVIEW_EFFORT are one of low, medium,
# high, xhigh, max, REVIEW_AGENT is one name matching [a-z0-9][a-z0-9:_-]* (no
# comma), and AGENTS is comma-separated names, each matching that - no quotes,
# spaces or shell syntax.

# The pipeline's ordered agent list: no-mistakes moves to the next agent when
# one fails (e.g. out of usage). Written as `agent: [codex, claude]`.
AGENTS=codex,claude

# codex's model.
CODEX_MODEL=gpt-6.1-sol
# claude's model and reasoning effort: the fallback for every non-review step
# when codex fails, e.g. out of usage.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# The review loop's reviewer and review fixer both run on this agent, model and
# effort. There is no fallback by design: a failing review agent (e.g. out of
# usage) fails the review step visibly instead of a weaker model serving it.
# The review roles live in no-mistakes' review_agents, while the other models
# live in agent_config, so the role model wins.
REVIEW_AGENT=claude
REVIEW_MODEL=claude-opus-5-5
REVIEW_EFFORT=high
