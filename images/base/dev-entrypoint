#!/bin/bash
#
# dev-entrypoint: the dev-system base image's ENTRYPOINT (under tini).
#
# Runs dev-init, then the container's command. The default command (the
# image CMD) is dev-remote-control, which keeps Claude Code running with
# Remote Control; any other command (`docker run IMAGE bash`, a k8s `args:`, a
# CI step) runs instead, with its exit status passed through.
#
# dev-init runs in the workspace (see workspace.sh): $DEV_WORKSPACE once it
# exists, else the start directory (the image WORKDIR or the runtime's working
# directory) unless that is /, else $HOME. On a first start with DEV_REPO_URL,
# dev-init clones the repo into $DEV_WORKSPACE itself. The command still
# starts in the original directory. dev-init is best-effort and time-limited,
# so it never blocks start-up for long, and its report goes to stderr so it
# never mixes with the command's own output. The limit leaves room for the
# clone's own 120s and the checks after it.
#
# Desktop dev containers do not use this: the devcontainer CLI and VS Code
# replace the entrypoint (overrideCommand), and the image metadata's
# postStartCommand runs dev-init instead.
set -u

# Also derives (and exports) DEV_WORKSPACE from DEV_REPO_URL, for dev-init and
# the command alike.
# shellcheck source=workspace.sh
. /usr/local/share/dev-system/workspace.sh

log() {
  echo "dev-entrypoint: $*" >&2
}

# Both initialization and the command must finish through the same stop path.
# A heartbeat can already be running while dev-init is still reporting checks.
# shellcheck disable=SC2317 # Invoked by the EXIT trap.
final_heartbeat() {
  local hb=/usr/local/share/dev-system/heartbeat-loop
  if [ "$(id -u)" != 0 ] && [ -x "$hb" ]; then
    timeout 10 "$hb" --final >&2 || true
  fi
}
trap 'final_heartbeat' EXIT

stopped=0
run_child() {
  local child status
  ( trap - INT QUIT; exec "$@" ) <&0 &
  child=$!
  trap 'stopped=1; kill -s TERM "$child" 2>/dev/null || true' TERM
  trap 'stopped=1; kill -s INT "$child" 2>/dev/null || true' INT
  trap 'stopped=1; kill -s HUP "$child" 2>/dev/null || true' HUP
  while kill -0 "$child" 2>/dev/null; do
    wait "$child"
  done
  status=0
  wait "$child" || status=$?
  trap - TERM INT HUP
  return "$status"
}

if [ "$(id -u)" = 0 ]; then
  # Run as root (docker run --user root), dev-init would leave root-owned
  # files in the /persist volumes that node then cannot write.
  log "running as root - dev-init skipped (it runs as node)"
else
  # shellcheck disable=SC2119 # the argument is optional; none means the default
  ws=$(workspace)
  # Keep the entrypoint responsive to stop signals while initialization runs.
  # shellcheck disable=SC2016 # $1 is the workspace passed to the child bash.
  run_child bash -c 'cd "$1" && exec timeout -k 10 300 dev-init' bash "$ws" >&2
  status=$?
  [ "$stopped" = 0 ] || exit "$status"
  case "$status" in
    0) ;;
    124 | 137) log "WARNING: dev-init did not finish within 300s - continuing without it" ;;
    *) log "WARNING: dev-init failed - continuing without it" ;;
  esac
fi

# An empty command (a runtime that clears the image CMD) means the default.
[ "$#" -gt 0 ] || set -- dev-remote-control

# Run the command as a child, not exec, so the stop path can write the worker's final
# heartbeat once it has exited (heartbeat-loop --final, #467). Stop signals are forwarded to
# the child; bash's wait returns early (128+signal) when a trapped signal arrives, so loop
# until the child has really exited, then take its own status from a final wait.
run_child "$@"
status=$?
exit "$status"
