#!/bin/sh
#
# callum-flow-merge: run callum-flow-merge-guard and, only if every guard
# passes, squash-merge the PR and log the `merged` event (cbundy/dev-system#219), written with
# `callum-flow-event --type merged --data`. The event needs an issue here: when the guard knows none, the
# merge still succeeds, a warning says so and no `merged` event is written (callum-flow-sweep's
# "unrecorded merges to main" rule records such a merge later, with a null issue).
# After a successful merge the PR's size is read once, `gh pr view <pr> --json files,additions,deletions`,
# and `mergedAt`, and the event carries `files` (the paths), `file_lines`, `additions` and `deletions`, and
# `merged_at` (GitHub's mergedAt as given), plus `title: null` (the loop's ready/claimed events carry the title).
# A failed size read warns and writes the size fields as null, a missing mergedAt writes merged_at null: the
# merge already happened, so the event is still written.
# This is the one command that can merge, so it is allowed only in the main
# checkout's gitignored .claude/settings.local.json, never in the synced
# allow list.
#
# Usage: callum-flow-merge <pr> --patch ID [--method squash|merge|rebase] [guard options]
#   Guard options (--expect, --patch, --base, --issue) go straight to the
#   guard; without --expect the guard derives the linkage from the issue's Rollout.
#   The factory loop merges with --patch <id> (docs/factory-loop/v2/SPEC.md 9.3):
#   the guard checks the approved patch instead of a pipeline run, and prints each
#   FAIL line with its class for the loop to act on.
#   The merge method is squash unless --method or CALLUM_FLOW_MERGE_METHOD
#   (a per-repo override) says otherwise.
#
# The merge is `gh pr merge <pr> --<method> --match-head-commit <sha>` with the
# sha the guard verified, so a push after the check makes GitHub refuse it.
# GitHub also refuses for a branch rule (for example a PR that fell behind its
# base); on a refusal the PR is re-read to say which of the two it was.
# The guard's advisory `GUARD test-weakening WARN` lines are relayed to stderr
# (they never block); after a successful merge one `test_weakened` event is
# logged per WEAKENED line the guard reported, restored ones included
# (cbundy/dev-system#314).
# After the merge and the `merged` event, `callum-flow-milestone tag <pr>` puts
# the PR and the issues it closes into the Next release milestone
# (cbundy/dev-system#403). A failure there only warns - the merge already
# happened, and the release workflow's reconcile step catches anything missed.
# After success, a non-empty guard close_issue field prints a manual closure
# instruction; this script does not close the issue itself.
#
# Exit codes: 0 merged, 1 a guard failed (its GUARD lines are printed) or the
# merge was refused, 2 usage error.
#
# Environment (for tests): CALLUM_FLOW_GH_BIN, CALLUM_FLOW_GUARD_BIN (the
# guard, default: beside this script), CALLUM_FLOW_EVENT_BIN
# (callum-flow-event), CALLUM_FLOW_MILESTONE_BIN (callum-flow-milestone, default:
# beside this script).
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
GUARD=${CALLUM_FLOW_GUARD_BIN:-$here/callum-flow-merge-guard}
EVENT=${CALLUM_FLOW_EVENT_BIN:-callum-flow-event}
MILESTONE=${CALLUM_FLOW_MILESTONE_BIN:-$here/callum-flow-milestone}
method=${CALLUM_FLOW_MERGE_METHOD:-squash}

usage() {
  [ -z "${1-}" ] || echo "callum-flow-merge: $1" >&2
  echo "usage: callum-flow-merge <pr> --patch ID [--method squash|merge|rebase] [--expect closing|refs] [--base BRANCH] [--issue N]" >&2
  exit 2
}

[ $# -ge 1 ] || usage
pr=$1
shift
case "$pr" in '' | -* | *[!0-9]*) usage "<pr> must be a number" ;; esac

# Rebuild the guard arguments without --method.
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  if [ "$a" = --method ]; then
    [ "$n" -gt 0 ] || usage "--method needs a value"
    method=$1
    shift
    n=$((n - 1))
  else
    set -- "$@" "$a"
  fi
done
case "$method" in squash | merge | rebase) ;; *) usage "method must be squash, merge or rebase" ;; esac

out=$("$GUARD" "$pr" "$@" --emit-verified)
rc=$?
if [ "$rc" -ne 0 ]; then
  [ -z "$out" ] || printf '%s\n' "$out"
  exit "$rc"
fi
printf '%s\n' "$out" | grep '^GUARD ' >&2
v=$(printf '%s\n' "$out" | sed -n 's/^VERIFIED //p' | sed -n 1p)
get() { printf '%s\n' "$v" | tr ' ' '\n' | sed -n "s/^$1=//p"; }
branch=$(get branch) sha=$(get head) issue=$(get issue) close_issue=$(get close_issue)
[ -n "$sha" ] || { echo "callum-flow-merge: the guard verified no head sha - not merging" >&2; exit 1; }

merge_rc=0
merge_err=$($GH pr merge "$pr" "--$method" --match-head-commit "$sha" 2>&1) || merge_rc=$?
[ -z "$merge_err" ] || printf '%s\n' "$merge_err" >&2
if [ "$merge_rc" -ne 0 ]; then
  now=$($GH pr view "$pr" --json headRefOid,mergeStateStatus 2> /dev/null) || now=''
  now_sha=$(printf '%s' "$now" | jq -r '.headRefOid // empty' 2> /dev/null)
  now_state=$(printf '%s' "$now" | jq -r '.mergeStateStatus // empty' 2> /dev/null)
  if [ -n "$now_sha" ] && [ "$now_sha" != "$sha" ]; then
    echo "callum-flow-merge: head moved since the check (verified $(printf %.7s "$sha"), now $(printf %.7s "$now_sha")) - re-gate" >&2
  else
    case "$now_state" in
      BEHIND | DIRTY | BLOCKED | DRAFT) echo "callum-flow-merge: GitHub refused: merge state $now_state (branch rule) - see the guard's mergeable action" >&2 ;;
      *) echo "callum-flow-merge: GitHub refused the merge (merge state ${now_state:-unknown}), head unchanged - see the error above, retry or check the PR" >&2 ;;
    esac
  fi
  exit 1
fi

# The merged event needs an issue in this script: with none known, warn and write none.
if [ -z "$issue" ]; then
  echo "callum-flow-merge: warning: no issue known, merged event not recorded" >&2
else
  # The size of the merged PR and the time GitHub merged it, read once after the merge:
  # {files, file_lines, additions, deletions} (all null when the size does not read) and merged_at (null when absent).
  size='{"files":null,"file_lines":null,"additions":null,"deletions":null}'
  merged_at=
  if sv=$($GH pr view "$pr" --json files,additions,deletions,mergedAt 2> /dev/null); then
    merged_at=$(printf '%s' "$sv" | jq -r '.mergedAt | strings' 2> /dev/null) || merged_at=
  fi
  if [ -n "$sv" ] &&
    sz=$(printf '%s' "$sv" | jq -ce '{files: ([.files[]?.path | select(type == "string" and . != "")]), file_lines: [.files[]? | objects | select((.path | type) == "string" and .path != "" and (.additions | type) == "number" and (.deletions | type) == "number" and .additions >= 0 and .deletions >= 0 and .additions == (.additions | floor) and .deletions == (.deletions | floor)) | {path, additions, deletions}], additions: (.additions | numbers), deletions: (.deletions | numbers)}' 2> /dev/null); then
    size=$sz
  else
    echo "callum-flow-merge: warning: could not read the size of PR #$pr - merged event written without it" >&2
  fi
  $EVENT --type merged --issue "$issue" --data "$(jq -nc --argjson pr "$pr" --arg b "$branch" --arg h "$sha" --arg at "$merged_at" --argjson s "$size" \
    '{pr: $pr, branch: (if $b == "" then null else $b end), head: $h, by: "factory", recovered: false,
      merged_at: (if $at == "" then null else $at end), title: null} + $s')" ||
    echo "callum-flow-merge: warning: merged event not recorded" >&2
fi
# milestone tagging never fails a merge that already succeeded
"$MILESTONE" tag "$pr" ||
  echo "callum-flow-merge: warning: milestone tagging failed - the release reconcile step will catch it" >&2
# one test_weakened event per flagged commit (the guard's WEAKENED lines)
printf '%s\n' "$out" | grep '^WEAKENED ' | while IFS= read -r w_line; do
  w_commit=$(printf '%s' "$w_line" | sed 's/^WEAKENED commit=\([^ ]*\) .*/\1/')
  w_restored=$(printf '%s' "$w_line" | sed 's/.* restored=\([^ ]*\) .*/\1/')
  w_files=$(printf '%s' "$w_line" | sed 's/.* files=\(.*\) kinds=.*/\1/')
  w_kinds=$(printf '%s' "$w_line" | sed 's/.* kinds=//')
  if [ -z "$issue" ]; then
    echo "callum-flow-merge: warning: no issue known, test_weakened event for $(printf %.7s "$w_commit") not recorded" >&2
    continue
  fi
  $EVENT --type test_weakened --issue "$issue" --data "$(jq -nc --argjson pr "$pr" --arg b "$branch" --arg h "$sha" \
    --arg c "$(printf %.7s "$w_commit")" --arg r "$w_restored" --arg k "$w_kinds" --arg f "$w_files" \
    '{branch: $b, pr: $pr, head: $h, commit: $c, restored: ($r == "yes"), kinds: ($k | split(",")), files: ($f | split(","))}')" ||
    echo "callum-flow-merge: warning: test_weakened event not recorded" >&2
done
if [ -n "$close_issue" ]; then
  printf 'Close issue #%s by hand with a comment naming merged PR #%s; GitHub registers no closing references on a non-default base.\n' "$close_issue" "$pr"
fi
exit 0
