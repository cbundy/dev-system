#!/bin/sh
#
# callum-flow-sweep: release stale `In development` labels so no issue stays
# claimed forever (cbundy/dev-system#220). Pairs with callum-flow-claim, whose
# claim comments carry the lease. Handles open AND closed issues.
#
# Usage: callum-flow-sweep
#
# Rules, applied in this order to each `In development` issue:
#   1. Closed: remove the label, and log `closed` (below) when the issue's
#      latest event is not final.
#   2. Open, with a PR merged after the newest claim comment was created (a
#      merged PR that closes or just references the issue shows up as a
#      `cross-referenced` timeline event) whose head branch follows the repo
#      convention `issue-<N>-...` for this issue (matching is by branch name,
#      so release or other PRs that merely mention the issue do not count):
#      remove the label. No comment, no event (`merged` is logged elsewhere).
#   3. Open, newest claim comment expired (server updated_at + the comment's
#      own `lease:`): remove `In development`, add `ready`, unassign the
#      claimant, comment why, and log `callum-flow-event reclaimed`.
#   4. Open with no claim comment (legacy or hand claims): untouched, one
#      stderr note. Never flipped to `ready`.
# After those rules, one more pass records issues closed outside the factory
# (cbundy/dev-system#342). Every issue in the event log whose latest event is
# not final (`closed` or `abandoned`; `merged` is not final, the issue may still
# be open) and that GitHub reports closed gets `callum-flow-event closed --note
# <GitHub's state_reason: completed, not_planned or duplicate> --actor sweep`.
# The log is this device's file (`callum-flow-event --path`) plus, when
# dev-query is configured, the latest event per issue in factory.events, so
# issues only another device saw are found too. A failed central read warns
# and falls back to the local log. The pass has no time limit, so the first run
# is the backfill. Two devices sweeping before either has pushed can both log
# `closed`; consumers count identical consecutive rows once.
# Each issue is re-read directly (not through the label list, which lags)
# and skipped when it no longer carries the label, so a second run right
# after the first writes nothing.
#
# Exit codes: 0 ok, 1 a gh failure (the other issues are still swept), 2 usage
# error.
#
# Trust (cbundy/dev-system#310): issues, comments, the timeline and PRs are read
# only through callum-flow-issue-read. An untrusted issue is skipped without a
# word (one stderr line gives the count), an untrusted `claimed-by:` comment is
# ignored, and a cross-referenced event by an untrusted actor or from an
# untrusted PR never counts as a merge. A reader failure is an error for that
# issue, never "no comments".
#
# Environment: CALLUM_FLOW_REPO, CALLUM_FLOW_READY_LABEL,
# CALLUM_FLOW_IN_DEV_LABEL; for tests CALLUM_FLOW_GH_BIN, CALLUM_FLOW_EVENT_BIN,
# CALLUM_FLOW_ISSUE_READ_BIN (callum-flow-issue-read), CALLUM_FLOW_DEV_QUERY_BIN.
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
EVENT=${CALLUM_FLOW_EVENT_BIN:-callum-flow-event}
READ=${CALLUM_FLOW_ISSUE_READ_BIN:-callum-flow-issue-read}
DEVQ=${CALLUM_FLOW_DEV_QUERY_BIN:-dev-query}
READY=${CALLUM_FLOW_READY_LABEL:-ready}
INDEV=${CALLUM_FLOW_IN_DEV_LABEL:-In development}

err() { echo "callum-flow-sweep: $*" >&2; }
if [ $# -ne 0 ]; then
  err "takes no arguments"
  echo "usage: callum-flow-sweep" >&2
  exit 2
fi
command -v jq >/dev/null 2>&1 || { err "jq not found"; exit 1; }

repo=${CALLUM_FLOW_REPO-}
[ -n "$repo" ] || repo=$("$GH" repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || repo=
[ -n "$repo" ] || { err "cannot determine the repo (set CALLUM_FLOW_REPO)"; exit 1; }
export CALLUM_FLOW_REPO="$repo"

d=$("$GH" api -i rate_limit 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: *//p' | sed -n 1p)
now=''
[ -z "$d" ] || now=$(date -u -d "$d" +%s 2>/dev/null) || now=''
[ -n "$now" ] || now=$(date -u +%s)

if ! lj=$("$READ" --json --list --label "$INDEV" --state all) ||
  ! list=$(printf '%s' "$lj" | jq -r '.issues[].number'); then
  err "cannot list $INDEV issues"
  exit 1
fi
untrusted=$(printf '%s' "$lj" | jq -r '.stripped // 0')
[ "$untrusted" = 0 ] || err "note: skipped $untrusted $INDEV issue(s) by untrusted authors"

tmp=$(mktemp -d 2>/dev/null) || { err "cannot create a temporary directory"; exit 1; }
trap 'rm -rf "$tmp"' EXIT
: > "$tmp/handled"

# latest_open_issues: the issues whose latest event is not final, from this
# device's log and (best effort) the central factory.events.
: > "$tmp/central"
if command -v "$DEVQ" >/dev/null 2>&1; then
  crc=0
  "$DEVQ" -At -v "repo=$repo" -c "SELECT DISTINCT ON (issue) to_char(ts AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') || '|' || issue || '|' || state
    FROM factory.events WHERE repo = :'repo' AND issue IS NOT NULL ORDER BY issue, ts DESC, seq DESC" \
    > "$tmp/central.raw" 2> "$tmp/central.err" < /dev/null || crc=$?
  if [ "$crc" -eq 0 ]; then
    jq -R -c 'split("|") | select(length == 3) | {ts: .[0], issue: (.[1] | tonumber), state: .[2]}' "$tmp/central.raw" > "$tmp/central" 2>/dev/null || : > "$tmp/central"
  elif [ "$crc" -ne 78 ]; then
    err "warning: cannot read the central event log (dev-query exit $crc), using this device's log only"
  fi
fi
: > "$tmp/local"
logfile=$("$EVENT" --path --repo "$repo" 2>/dev/null) || logfile=
if [ -n "$logfile" ] && [ -f "$logfile" ]; then
  jq -R -c 'fromjson? | select(type == "object" and (.issue | type) == "number") | {ts: .ts, issue: .issue, state: .state}' "$logfile" > "$tmp/local" 2>/dev/null || : > "$tmp/local"
fi
# Latest per issue by ts; jq sorts stably, so equal timestamps keep file order
# (central first, then this device's log).
cat "$tmp/central" "$tmp/local" | jq -s -r 'sort_by(.ts) | group_by(.issue) | map(last) | .[] | "\(.issue) \(.state)"' > "$tmp/latest" 2>/dev/null || : > "$tmp/latest"
# is_final N: the issue's latest event is closed or abandoned
is_final() { awk -v n="$1" '$1 == n && ($2 == "closed" || $2 == "abandoned") { f = 1 } END { exit !f }' "$tmp/latest"; }
# has_events N: the log has seen the issue at all
has_events() { awk -v n="$1" '$1 == n { f = 1 } END { exit !f }' "$tmp/latest"; }
# log_closed N VIEW: log the closed event with GitHub's close reason
log_closed() {
  reason=$(printf '%s' "$2" | jq -r '.state_reason // empty')
  "$EVENT" closed --issue "$1" --note "$reason" --actor sweep >/dev/null 2>&1 || err "warning: could not log the closed event for #$1"
  echo "$1" >> "$tmp/handled"
}

rc=0
for n in $list; do
  crc=0
  vj=$("$READ" --json "$n") || crc=$?
  # an untrusted issue is skipped without a word (the list already counted it)
  if [ "$crc" -eq 3 ]; then continue; fi
  if [ "$crc" -ne 0 ] || ! view=$(printf '%s' "$vj" | jq -ce '.issue | if type == "object" then . else error("shape") end'); then
    err "cannot read #$n"
    rc=1
    continue
  fi
  # The list lags behind edits: trust the direct read.
  printf '%s' "$view" | jq -e --arg l "$INDEV" '.labels | map(.name) | index($l)' >/dev/null || continue
  state=$(printf '%s' "$view" | jq -r '.state | ascii_upcase')

  if [ "$state" = CLOSED ]; then
    if has_events "$n" && ! is_final "$n"; then log_closed "$n" "$view"; fi
    "$GH" issue edit "$n" --remove-label "$INDEV" >/dev/null || { err "cannot unlabel closed #$n"; rc=1; }
    continue
  fi

  if ! cj=$("$READ" --json "$n" --comments) ||
    ! cs=$(printf '%s' "$cj" | jq -ce 'if (.comments | type) == "array" then .comments else error("shape") end'); then
    err "cannot read comments of #$n"
    rc=1
    continue
  fi
  claim=$(printf '%s' "$cs" | jq -c '
    [ .[] | select((.body // "") | contains("<!-- callum-flow-claim -->"))
      | . as $c | ((.body | split("\n"))[0]
        | capture("^claimed-by: (?<dev>.+) at (?<at>[^ ]+) lease: (?<lease>[0-9]+)")?) as $p
      | select($p)
      | {dev: $p.dev, at: $p.at, lease: ($p.lease | tonumber), created: $c.created_at,
         updated: $c.updated_at, user: ($c.user.login // ""),
         renewed: ((($c.body | split("\n") | map(select(startswith("renewed: "))) | last) // "") | ltrimstr("renewed: ")),
         exp: (($c.updated_at | fromdateiso8601) + ($p.lease | tonumber) * 60)} ]
    | sort_by(.created) | last // empty')
  if [ -z "$claim" ]; then
    err "note: #$n is $INDEV with no claim comment (legacy or hand claim) - left alone"
    continue
  fi
  created=$(printf '%s' "$claim" | jq -r .created)

  if ! tj=$("$READ" --json --timeline "$n") ||
    ! tl=$(printf '%s' "$tj" | jq -ce 'if (.events | type) == "array" then .events else error("shape") end'); then
    err "cannot read the timeline of #$n"
    rc=1
    continue
  fi
  merged=0
  failed=0
  for pr in $(printf '%s' "$tl" | jq -r --arg c "$created" '
      .[] | select(.event == "cross-referenced" and (.source.issue.pull_request.merged_at // "") > $c)
      | .source.issue.number'); do
    crc=0
    pj=$("$READ" --json --pr "$pr") || crc=$?
    # an untrusted PR never counts as a merge
    if [ "$crc" -eq 3 ]; then continue; fi
    if [ "$crc" -ne 0 ] || ! ref=$(printf '%s' "$pj" | jq -r '.pr.head.ref // empty') || [ -z "$ref" ]; then
      err "cannot read PR #$pr"
      failed=1
      break
    fi
    if printf '%s\n' "$ref" | grep -Eq "(^|/)issue-$n-"; then
      merged=1
      break
    fi
  done
  if [ "$failed" = 1 ]; then
    rc=1
    continue
  fi
  if [ "$merged" = 1 ]; then
    "$GH" issue edit "$n" --remove-label "$INDEV" >/dev/null || { err "cannot unlabel merged #$n"; rc=1; }
    continue
  fi

  if printf '%s' "$claim" | jq -e --argjson now "$now" '.exp > $now' >/dev/null; then
    continue
  fi

  user=$(printf '%s' "$claim" | jq -r .user)
  set -- --remove-label "$INDEV" --add-label "$READY"
  [ -z "$user" ] || set -- "$@" --remove-assignee "$user"
  "$GH" issue edit "$n" "$@" >/dev/null || { err "cannot reclaim #$n"; rc=1; continue; }
  text=$(printf '%s' "$claim" | jq -r '
    (if .renewed == "" then "none" else .renewed end) as $r
    | "Claim lease expired, so the issue goes back to ready. Device: " + .dev + ". Claimed at: " + .at
      + ". Last renewal: " + $r + ". Lease: " + (.lease | tostring) + " minutes."')
  "$GH" issue comment "$n" --body "$text" >/dev/null || { err "reclaimed #$n but could not comment"; rc=1; }
  "$EVENT" reclaimed --issue "$n" --note "lease expired" >/dev/null 2>&1 || err "warning: could not log the reclaimed event for #$n"
done

# Issues closed outside the factory: every issue the log has seen, not final,
# that GitHub reports closed. Open ones are left alone.
cands=$(awk '$2 != "closed" && $2 != "abandoned" && $2 != "untrusted_stripped" { print $1 }' "$tmp/latest")
for n in $cands; do
  grep -qx "$n" "$tmp/handled" && continue
  crc=0
  vj=$("$READ" --json "$n") || crc=$?
  if [ "$crc" -eq 3 ]; then continue; fi
  if [ "$crc" -ne 0 ] || ! view=$(printf '%s' "$vj" | jq -ce '.issue | if type == "object" then . else error("shape") end'); then
    err "cannot read #$n"
    rc=1
    continue
  fi
  [ "$(printf '%s' "$view" | jq -r '.state | ascii_upcase')" = CLOSED ] || continue
  log_closed "$n" "$view"
done
exit "$rc"
