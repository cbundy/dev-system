#!/bin/sh
#
# callum-flow-sweep: release lapsed claims so no issue stays claimed forever
# (cbundy/dev-system#220), and record issues closed outside the factory
# (cbundy/dev-system#342). Pairs with callum-flow-claim, whose claim comments
# carry the lease. Handles open AND closed issues.
#
# Usage: callum-flow-sweep
#
# Candidates are the issues the event log and callum-flow-factory-state list as
# live (docs/factory-loop/v2/SPEC.md 3.6), never a label list: every issue in
# the log whose latest event (judged by lifecycle events only:
# untrusted_stripped, usage, watcher_error, test_weakened, claim_lost, renewed,
# loop, reviewed, intervention, prompt_denied and prompt_waiting are ignored) is not final (`closed` or
# `abandoned`; `merged` is not final, the issue may still be open), plus every
# issue `callum-flow-factory-state --github off` lists live (which also covers
# an issue known only from a mirror run, and a new life after abandonment). The
# log is this device's file (`callum-flow-event --path`) plus, when dev-query
# is configured, the latest lifecycle event and the latest claim event per
# issue in factory.events, so issues only another device saw are found too. A
# failed central read warns and falls back to the local log; a failed
# factory-state read adds nothing.
# Each candidate is read directly, and these rules apply in order:
#   1. Closed: log `callum-flow-event closed --note <GitHub's state_reason:
#      completed, not_planned or duplicate> --actor sweep` when its latest
#      event is not final. The pass has no time limit, so the first run is the
#      backfill. Two devices sweeping before either has pushed can both log
#      `closed`; consumers count identical consecutive rows once.
#   2. Open, its claim already ended (the last of its claim events - claimed,
#      ready, reclaimed, merged, closed, abandoned - is one that ends it, whichever
#      device logged it; no other event, such as a watcher's head_mismatch after a
#      drop, revives an ended claim; the rule is shared with callum-flow-claim in
#      claim-events.sh): left alone, even when this device's own log still shows
#      `claimed`.
#   3. Open with no claim comment (legacy or hand claims): left alone, one
#      stderr note. Never flipped to `ready`.
#   4. Open, with a PR merged after the newest claim comment was created (a
#      merged PR that closes or just references the issue shows up as a
#      `cross-referenced` timeline event) whose head branch is this issue's
#      (`issue-<N>`, or `issue-<N>-...`, after any `<prefix>/`; matching is by
#      branch name, so release or other PRs that merely mention the issue do
#      not count): log `callum-flow-event merged --pr <P> [--head <sha>] --actor
#      sweep` and leave it alone. This runs before the lease check, so a claim
#      kept live by renewals still ends; whoever holds the claim. Afterwards the
#      issue reads as released, so a second run writes nothing.
#   5. Open, newest claim comment live (server updated_at + the comment's own
#      `lease:`): left alone.
#   6. Open, newest claim expired: add `ready`, unassign the claimant, comment
#      why, and log `callum-flow-event reclaimed`. Across devices a lapsed claim
#      is reclaimed once: the first reclaim ends the claim for every other device.
# The sweep never adds or removes any other label: the factory loop is the only
# writer of the `factory:*` labels, and a loop record whose claim lapsed is
# claimed again onto itself. A second run right after the first writes nothing:
# a reclaimed issue's latest event is `reclaimed`, and a closed one's `closed`.
#
# Exit codes: 0 ok, 1 a gh failure (the other issues are still swept), 2 usage
# error.
#
# Trust (cbundy/dev-system#310): issues, comments, the timeline and PRs are read
# only through callum-flow-issue-read. An untrusted issue is skipped without a
# word, an untrusted `claimed-by:` comment is ignored, and a cross-referenced
# event by an untrusted actor or from an untrusted PR never counts as a merge.
# A reader failure is an error for that issue, never "no comments".
#
# Environment: CALLUM_FLOW_REPO, CALLUM_FLOW_READY_LABEL; for tests
# CALLUM_FLOW_GH_BIN, CALLUM_FLOW_EVENT_BIN, CALLUM_FLOW_ISSUE_READ_BIN
# (callum-flow-issue-read), CALLUM_FLOW_DEV_QUERY_BIN,
# CALLUM_FLOW_FACTORY_STATE_BIN (callum-flow-factory-state), CALLUM_FLOW_SHARE_DIR
# (where claim-events.sh is installed, default /usr/local/share/dev-system).
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
EVENT=${CALLUM_FLOW_EVENT_BIN:-callum-flow-event}
READ=${CALLUM_FLOW_ISSUE_READ_BIN:-callum-flow-issue-read}
DEVQ=${CALLUM_FLOW_DEV_QUERY_BIN:-dev-query}
FSTATE=${CALLUM_FLOW_FACTORY_STATE_BIN:-callum-flow-factory-state}
READY=${CALLUM_FLOW_READY_LABEL:-ready}
SHARE=${CALLUM_FLOW_SHARE_DIR:-/usr/local/share/dev-system}

err() { echo "callum-flow-sweep: $*" >&2; }
if [ $# -ne 0 ]; then
  err "takes no arguments"
  echo "usage: callum-flow-sweep" >&2
  exit 2
fi
command -v jq >/dev/null 2>&1 || { err "jq not found"; exit 1; }
# shellcheck source=claim-events.sh
. "$SHARE/claim-events.sh" 2>/dev/null || { err "cannot read $SHARE/claim-events.sh"; exit 1; }
CE_TOOL=callum-flow-sweep

repo=${CALLUM_FLOW_REPO-}
[ -n "$repo" ] || repo=$("$GH" repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || repo=
[ -n "$repo" ] || { err "cannot determine the repo (set CALLUM_FLOW_REPO)"; exit 1; }
export CALLUM_FLOW_REPO="$repo"

d=$("$GH" api -i rate_limit 2>/dev/null | tr -d '\r' | sed -n 's/^[Dd]ate: *//p' | sed -n 1p)
now=''
[ -z "$d" ] || now=$(date -u -d "$d" +%s 2>/dev/null) || now=''
[ -n "$now" ] || now=$(date -u +%s)

tmp=$(mktemp -d 2>/dev/null) || { err "cannot create a temporary directory"; exit 1; }
trap 'rm -rf "$tmp"' EXIT

# The issues' latest events, from this device's log and (best effort) the central
# factory.events, through the shared rule (claim-events.sh): per issue its latest
# lifecycle event and its latest claim event. Housekeeping events (the noise list there)
# never decide whether an issue is final, or a recurring one would hide a closed issue for
# good. A log whose path cannot be located adds nothing.
ce_load "$tmp" "$(ce_device)" || :
# is_final N: the issue's latest event is closed or abandoned
is_final() { awk -v n="$1" '$1 == n && ($2 == "closed" || $2 == "abandoned") { f = 1 } END { exit !f }' "$tmp/latest"; }
# released N: the issue's latest claim event ended its claim: back in the queue
# (ready, reclaimed), merged, or final
released() { awk -v n="$1" '$1 == n && $3 != "claimed" && $3 != "none" { f = 1 } END { exit !f }' "$tmp/latest"; }
# log_closed N VIEW: log the closed event with GitHub's close reason
log_closed() {
  reason=$(printf '%s' "$2" | jq -r '.state_reason // empty')
  "$EVENT" closed --issue "$1" --note "$reason" --actor sweep >/dev/null 2>&1 || err "warning: could not log the closed event for #$1"
}

# The candidates: every issue the log has seen that is not final, and every issue
# callum-flow-factory-state lists as live (a failed read adds nothing). A listed
# issue the log already closed (the tool reads the log a moment earlier) is not
# logged twice; an abandoned one it lists has a new life (a later run), so it
# stays a candidate.
cands=$(awk '$2 != "closed" && $2 != "abandoned" { print $1 }' "$tmp/latest")
: > "$tmp/live"
if fs=$("$FSTATE" --repo "$repo" --github off --format json 2>/dev/null </dev/null); then
  printf '%s' "$fs" | jq -r '.repos[]? | .issues[]? | .issue' > "$tmp/live" 2>/dev/null || : > "$tmp/live"
  cands=$(printf '%s\n' "$cands" | cat - "$tmp/live" | awk 'NF && !seen[$1]++')
  cands=$(for n in $cands; do awk -v n="$n" '$1 == n && $2 == "closed" { f = 1 } END { exit !f }' "$tmp/latest" || echo "$n"; done)
fi
# listed N: callum-flow-factory-state lists the issue as live
listed() { grep -qx "$1" "$tmp/live"; }

rc=0
for n in $cands; do
  crc=0
  vj=$("$READ" --json "$n") || crc=$?
  # an untrusted issue is skipped without a word
  if [ "$crc" -eq 3 ]; then continue; fi
  if [ "$crc" -ne 0 ] || ! view=$(printf '%s' "$vj" | jq -ce '.issue | if type == "object" then . else error("shape") end'); then
    err "cannot read #$n"
    rc=1
    continue
  fi
  state=$(printf '%s' "$view" | jq -r '.state | ascii_upcase')

  if [ "$state" = CLOSED ]; then
    if ! is_final "$n" || listed "$n"; then log_closed "$n" "$view"; fi
    continue
  fi
  released "$n" && continue

  if ! cj=$("$READ" --json "$n" --comments) ||
    ! cs=$(printf '%s' "$cj" | jq -ce 'if (.comments | type) == "array" then .comments else error("shape") end'); then
    err "cannot read comments of #$n"
    rc=1
    continue
  fi
  claim=$(printf '%s' "$cs" | jq -c '
    [ .[] | select((.body // "") | contains("<!-- callum-flow-claim -->"))
      | . as $c | ((.body | split("\n"))[0]
        | capture("^claimed-by: (?<dev>.+) at (?<at>[^ ]+) lease: (?<lease>[0-9]+)")?) as $p
      | select($p)
      | {dev: $p.dev, at: $p.at, lease: ($p.lease | tonumber), created: $c.created_at,
         updated: $c.updated_at, user: ($c.user.login // ""),
         renewed: ((($c.body | split("\n") | map(select(startswith("renewed: "))) | last) // "") | ltrimstr("renewed: ")),
         exp: (($c.updated_at | fromdateiso8601) + ($p.lease | tonumber) * 60)} ]
    | sort_by(.created) | last // empty')
  if [ -z "$claim" ]; then
    err "note: #$n is live in the event log with no claim comment (legacy or hand claim) - left alone"
    continue
  fi
  created=$(printf '%s' "$claim" | jq -r .created)

  # A merge made outside the factory ends the claim, kept live by renewals or not.
  if ! tj=$("$READ" --json --timeline "$n") ||
    ! tl=$(printf '%s' "$tj" | jq -ce 'if (.events | type) == "array" then .events else error("shape") end'); then
    err "cannot read the timeline of #$n"
    rc=1
    continue
  fi
  merged=0
  failed=0
  mhead=
  for pr in $(printf '%s' "$tl" | jq -r --arg c "$created" '
      .[] | select(.event == "cross-referenced" and (.source.issue.pull_request.merged_at // "") > $c)
      | .source.issue.number'); do
    crc=0
    pj=$("$READ" --json --pr "$pr") || crc=$?
    # an untrusted PR never counts as a merge
    if [ "$crc" -eq 3 ]; then continue; fi
    if [ "$crc" -ne 0 ] || ! ref=$(printf '%s' "$pj" | jq -r '.pr.head.ref // empty') || [ -z "$ref" ]; then
      err "cannot read PR #$pr"
      failed=1
      break
    fi
    if printf '%s\n' "$ref" | grep -Eq "(^|/)issue-$n(-|\$)"; then
      merged=$pr
      mhead=$(printf '%s' "$pj" | jq -r '.pr.head.sha // empty')
      printf '%s\n' "$mhead" | grep -Eq '^[0-9a-f]{7,40}$' || mhead=
      break
    fi
  done
  if [ "$failed" = 1 ]; then
    rc=1
    continue
  fi
  if [ "$merged" != 0 ]; then
    if [ -n "$mhead" ]; then
      "$EVENT" merged --issue "$n" --pr "$merged" --head "$mhead" --actor sweep >/dev/null 2>&1 || err "warning: could not log the merged event for #$n"
    else
      "$EVENT" merged --issue "$n" --pr "$merged" --actor sweep >/dev/null 2>&1 || err "warning: could not log the merged event for #$n"
    fi
    continue
  fi

  if printf '%s' "$claim" | jq -e --argjson now "$now" '.exp > $now' >/dev/null; then
    continue
  fi

  user=$(printf '%s' "$claim" | jq -r .user)
  set -- --add-label "$READY"
  [ -z "$user" ] || set -- "$@" --remove-assignee "$user"
  "$GH" issue edit "$n" "$@" >/dev/null || { err "cannot reclaim #$n"; rc=1; continue; }
  text=$(printf '%s' "$claim" | jq -r '
    (if .renewed == "" then "none" else .renewed end) as $r
    | "Claim lease expired, so the issue goes back to ready. Device: " + .dev + ". Claimed at: " + .at
      + ". Last renewal: " + $r + ". Lease: " + (.lease | tostring) + " minutes."')
  "$GH" issue comment "$n" --body "$text" >/dev/null || { err "reclaimed #$n but could not comment"; rc=1; }
  "$EVENT" reclaimed --issue "$n" --note "lease expired" >/dev/null 2>&1 || err "warning: could not log the reclaimed event for #$n"
done
exit "$rc"
