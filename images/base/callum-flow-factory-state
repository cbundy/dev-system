function table(head, rows) {
  const all = [head, ...rows].map((r) => r.map((c) => (c === null || c === undefined || c === '' ? '-' : String(c))));
  const w = head.map((_, i) => Math.max(...all.map((r) => r[i].length)));
  return all.map((r) => r.map((c, i) => c.padEnd(w[i])).join('  ').trimEnd()).join('\n');
}
const dur = (m) => {
  if (m === null || m === undefined) return '-';
  if (m < 60) return `${m}m`;
  if (m < 2880) return `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}m`;
  return `${Math.floor(m / 1440)}d`;
};

function renderText(r) {
  const out = [];
  out.push(`Factory state at ${r.at} (${r.at_source})`);
  out.push(`Stuck rules (minutes): ${Object.entries(r.rules).map(([k, v]) => `${k}=${v}`).join(' ')}`);
  out.push(`GitHub: ${r.github['n/a'] ? `n/a: ${r.github['n/a']}` : r.github.note}`);
  if (r.approximate) out.push(`Approximate: ${r.approximate}`);
  out.push('');
  out.push('Stuck');
  out.push(r.stuck.length ? table(['repo', 'issue', 'stage', 'rule', 'in stage', 'why'], r.stuck.map((s) => [s.repo, `#${s.issue}`, s.stage, s.rule, dur(s.minutes_in_stage), s.detail])) : 'none');
  out.push('');
  out.push('Workers');
  out.push(r.workers['n/a'] ? `n/a: ${r.workers['n/a']}` : JSON.stringify(r.workers));
  if (r.runs !== 'read') {
    out.push('');
    out.push(`Pipeline runs: n/a: ${r.runs['n/a']}`);
  }
  for (const repo of r.repos) {
    out.push('');
    out.push(`== ${repo.repo} - coverage: ${repo.coverage.class}`);
    const c = repo.coverage;
    out.push(`events ${c.events} (last ${c.last_event_at || '-'}), runs ${c.runs} (last update ${c.last_run_update_at || '-'}), heartbeat ${c.heartbeat}`);
    if (c.devices.length) out.push(`devices: ${c.devices.map((d) => `${d.device} (${d.events} events, last ${d.last_event_at})`).join('; ')}`);
    out.push(`live issues by source: mirror ${c.live_issue_sources.mirror}, event ${c.live_issue_sources.event}, github ${c.live_issue_sources.github}`);
    for (const n of c.notes) out.push(`note: ${n}`);
    const row = (i) => [`#${i.issue}`, i.stage + (i.approximate ? ' (approx)' : ''), dur(i.minutes_in_stage), i.holder, i.run, i.pr ? `#${i.pr}` : null,
      i.stuck ? `STUCK ${i.stuck.rule}` : null, i.source, [i.detail, i.hint, ...i.flags].filter(Boolean).join('; ')];
    const head = ['issue', 'stage', 'in stage', 'holder', 'run', 'pr', 'stuck', 'source', 'detail'];
    out.push('');
    out.push('Live issues');
    out.push(repo.issues.length ? table(head, repo.issues.map(row)) : 'none');
    if (repo.recent.length) {
      out.push('');
      out.push('Recently ended (24h)');
      out.push(table(head, repo.recent.map(row)));
    }
    if (repo.other_runs.length) {
      out.push('');
      out.push('Other runs (branch has no issue number)');
      out.push(table(['run', 'branch', 'device', 'status', 'parked', 'created'], repo.other_runs.map((o) => [o.run, o.branch, o.device, o.status, o.parked ? 'yes' : 'no', o.created_at])));
    }
  }
  return `${out.join('\n')}\n`;
}

// ---------------------------------------------------------------- main

async function main(argv) {
  const opts = parseArgs(argv);
  if (opts.help) {
    process.stdout.write(`${USAGE}\n`);
    return 0;
  }
  let report;
  if (opts.source === 'old') {
    const base = loadBase(opts, true);
    report = buildReport(base, loadEvents('old', base), opts);
  } else if (opts.source === 'new') {
    const base = loadBase(opts, false);
    report = buildReport(base, loadEvents('new', base), opts);
  } else {
    // shadow: the old answer is printed and decides the exit code; the new read only gets recorded
    const base = loadBase(opts, true);
    report = await factorySource().runShadow({
      tool: 'factory-state',
      old: () => buildReport(base, loadEvents('old', base), opts),
      new: () => buildReport(base, loadEvents('new', base), opts),
      normalize: normalizeForCompare,
      repo: opts.repos.length ? opts.repos.join(',') : null,
      args: argv.join(' '),
    });
  }
  process.stdout.write(opts.format === 'json' ? `${JSON.stringify(report, null, 2)}\n` : renderText(report));
  return 0;
}

if (require.main === module) {
  main(process.argv.slice(2)).then((code) => {
    process.exitCode = code;
  }, (e) => {
    if (e instanceof UsageError) {
      process.stderr.write(`callum-flow-factory-state: ${e.message}\n${USAGE}\n`);
      process.exitCode = 2;
    } else if (e instanceof InputError) {
      process.stderr.write(`callum-flow-factory-state: ${e.message}\n`);
      process.exitCode = 1;
    } else {
      process.stderr.write(`${e && e.stack ? e.stack : e}\n`);
      process.exitCode = 1;
    }
  });
}

module.exports = {
  deriveState, parseArgs, renderText, RUN_LINK, SQL_META, SQL_EVENTS, SQL_EVENT_LOG, SQL_RUNS, DEFAULT_RULES, STAGES,
  mapOldRow, mapEventLogRow, normalizeForCompare,
};
