#!/bin/sh
#
# callum-flow-designer-route: decide which model the designer sub-agent runs on
# for an issue, Opus (its frontmatter model, the control) or Sonnet (the
# treatment), so the factory can compare the two on real numbers (cbundy/dev-system#1040).
# The split must be stable and exact, so it is computed, never asked of a model.
# Distinct from callum-flow-design-route, which picks session or sub-agent.
#
# Usage: callum-flow-designer-route <issue>
#        callum-flow-designer-route -h | --help
#
# Prints exactly one line, the model alias to pass as `model` on the designer
# call. Order of decision:
#   1. a `model:<alias>` label -> that alias (reason=label; with several, the
#      first in sorted order, with a warning). The owner's pick, so the
#      comparison leaves it out.
#   2. CALLUM_FLOW_DESIGNER_SONNET_PCT unset, empty or 0 -> opus (reason=default)
#   3. bucket = POSIX `cksum` CRC of "designer:<owner/repo>#<issue>" (repo
#      lower-cased) mod 100; sonnet when bucket < pct, else opus (reason=hash).
#      The `designer:` salt keeps the buckets independent of the other routes'.
# If the repo or the labels cannot be read it prints opus with a warning on
# stderr (reason=fallback): routing never blocks the design.
#
# Every decision is logged once with
#   callum-flow-event --type designer_routed --issue N --data '{"model":..,"reason":..,"bucket":..,"sonnet_pct":..}'
# A logging failure never changes the output or the exit code.
#
# Exit codes: 0 routed (including the fallback) or -h | --help (usage on stdout,
# nothing logged, whatever the environment), 2 usage error (bad issue, or
# CALLUM_FLOW_DESIGNER_SONNET_PCT not a number from 0 to 100); nothing is logged.
#
# Environment: CALLUM_FLOW_DESIGNER_SONNET_PCT (default 0), CALLUM_FLOW_REPO
# (owner/name, default from gh); for tests CALLUM_FLOW_GH_BIN,
# CALLUM_FLOW_EVENT_BIN, CALLUM_FLOW_ISSUE_READ_BIN (callum-flow-issue-read).
set -u

GH=${CALLUM_FLOW_GH_BIN:-gh}
EVENT=${CALLUM_FLOW_EVENT_BIN:-callum-flow-event}
READ=${CALLUM_FLOW_ISSUE_READ_BIN:-callum-flow-issue-read}
PCT=${CALLUM_FLOW_DESIGNER_SONNET_PCT:-0}
# The control is the designer agent's frontmatter model (a test keeps them equal).
CONTROL=opus
TREATMENT=sonnet

usage() {
  [ -z "${1-}" ] || echo "callum-flow-designer-route: $1" >&2
  echo "usage: callum-flow-designer-route <issue>" >&2
  exit 2
}
help() {
  echo "usage: callum-flow-designer-route <issue>"
  exit 0
}
err() { echo "callum-flow-designer-route: $*" >&2; }

[ $# -ne 1 ] || case "$1" in -h | --help) help ;; esac

case "$PCT" in
  '' | *[!0-9]*) usage "CALLUM_FLOW_DESIGNER_SONNET_PCT must be a number from 0 to 100" ;;
esac
PCT=$(printf '%s' "$PCT" | sed 's/^0*//')
PCT=${PCT:-0}
[ "$PCT" -le 100 ] || usage "CALLUM_FLOW_DESIGNER_SONNET_PCT must be a number from 0 to 100"
[ $# -eq 1 ] || usage
n=$1
case "$n" in '' | *[!0-9]*) usage "issue must be a number, got '$n'" ;; esac

# The one place the issue's labels are read (one label per line), through the
# trusted-author reader (cbundy/dev-system#310): an untrusted issue, or any reader
# failure, makes this fail, and the route falls back to the control.
read_labels() {
  _rj=$(CALLUM_FLOW_REPO="$repo" "$READ" --json "$1") || return 1
  printf '%s' "$_rj" | jq -r '.issue.labels | if type == "array" then . else error("shape") end | map(.name) | .[]'
}

log() {
  _b=$3
  [ "$_b" != - ] || _b=null
  "$EVENT" --type designer_routed --issue "$n" \
    --data "{\"model\":\"$1\",\"reason\":\"$2\",\"bucket\":$_b,\"sonnet_pct\":$PCT}" >/dev/null 2>&1 ||
    err "warning: could not log the designer_routed event"
}
decide() { echo "$1"; log "$1" "$2" "$3"; exit 0; }

repo=${CALLUM_FLOW_REPO-}
[ -n "$repo" ] || repo=$("$GH" repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || repo=
if [ -z "$repo" ]; then
  err "warning: cannot determine the repo (set CALLUM_FLOW_REPO); routing to $CONTROL"
  decide "$CONTROL" fallback -
fi
repo=$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')

if ! labels=$(read_labels "$n" 2>/dev/null); then
  err "warning: cannot read the labels of #$n; routing to $CONTROL"
  decide "$CONTROL" fallback -
fi
# A label alias is passed to the Agent call as is, so only a plain alias or model id counts.
picks=$(printf '%s\n' "$labels" | sed -n 's/^model://p' | grep -E '^[A-Za-z0-9._-]+$' | LC_ALL=C sort -u)
if [ -n "$picks" ]; then
  pick=$(printf '%s\n' "$picks" | sed -n 1p)
  [ "$pick" = "$picks" ] || err "warning: #$n has several model: labels; using model:$pick"
  decide "$pick" label -
fi

[ "$PCT" -gt 0 ] || decide "$CONTROL" default -

bucket=$(printf 'designer:%s#%s' "$repo" "$n" | cksum | { read -r crc _; echo $((crc % 100)); })
if [ "$bucket" -lt "$PCT" ]; then decide "$TREATMENT" hash "$bucket"; fi
decide "$CONTROL" hash "$bucket"
