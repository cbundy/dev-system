{
  "extraKnownMarketplaces": {
    "callum": {
      "source": {
        "source": "github",
        "repo": "cbundy/dev-system",
        "ref": "v0.25.0"
      }
    }
  },
  "enabledPlugins": {
    "callum-flow@callum": true
  },
  "permissions": {
    "allow": [
      "Bash(no-mistakes axi run *)",
      "Bash(no-mistakes rerun *)",
      "Bash(no-mistakes axi abort *)",
      "Bash(no-mistakes axi sync *)",
      "Bash(no-mistakes axi status *)",
      "Bash(no-mistakes runs *)",
      "Bash(no-mistakes axi logs *)",
      "Bash(treehouse get *)",
      "Bash(treehouse return *)",
      "Bash(treehouse status *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(/usr/local/share/callum-tools/check-pr-linkage.sh *)",
      "Bash(callum-flow-event *)",
      "Bash(callum-flow-merge-guard *)",
      "Bash(callum-flow-rollout *)",
      "Bash(callum-flow-claim)",
      "Bash(callum-flow-claim *)",
      "Bash(callum-flow-design-route *)",
      "Bash(callum-flow-sweep)",
      "Bash(callum-flow-sweep *)",
      "Bash(callum-flow-evaluate *)",
      "Bash(callum-flow-issue-read *)"
    ],
    "deny": [
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh issue status)",
      "Bash(gh issue status *)"
    ]
  }
}
