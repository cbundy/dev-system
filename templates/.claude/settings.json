{
  "extraKnownMarketplaces": {
    "callum": {
      "source": {
        "source": "github",
        "repo": "cbundy/dev-system",
        "ref": "v0.10.0"
      }
    }
  },
  "enabledPlugins": {
    "callum-flow@callum": true
  },
  "permissions": {
    "allow": [
      "Bash(no-mistakes axi run *)",
      "Bash(no-mistakes rerun *)",
      "Bash(no-mistakes axi abort *)",
      "Bash(no-mistakes axi sync *)",
      "Bash(no-mistakes axi status *)",
      "Bash(no-mistakes runs *)",
      "Bash(no-mistakes axi logs *)",
      "Bash(treehouse get *)",
      "Bash(treehouse return *)",
      "Bash(treehouse status *)",
      "Bash(gh issue *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(/usr/local/share/callum-tools/check-pr-linkage.sh *)"
    ]
  }
}
