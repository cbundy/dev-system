{
  "attribution": {
    "commit": ""
  },
  "extraKnownMarketplaces": {
    "callum": {
      "source": {
        "source": "github",
        "repo": "cbundy/dev-system",
        "ref": "v0.99.0"
      }
    }
  },
  "enabledPlugins": {
    "callum-flow@callum": true
  },
  "permissions": {
    "allow": [
      "Bash(treehouse get *)",
      "Bash(treehouse return *)",
      "Bash(treehouse status *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(/usr/local/share/callum-tools/check-pr-linkage.sh *)",
      "Bash(callum-flow-event *)",
      "Bash(callum-flow-merge-guard *)",
      "Bash(callum-flow-rollout *)",
      "Bash(callum-flow-claim)",
      "Bash(callum-flow-claim *)",
      "Bash(callum-flow-milestone)",
      "Bash(callum-flow-milestone *)",
      "Bash(callum-flow-implementer-route *)",
      "Bash(callum-flow-designer-route *)",
      "Bash(callum-flow-sweep)",
      "Bash(callum-flow-sweep *)",
      "Bash(callum-flow-evaluate *)",
      "Bash(callum-flow-evidence-upload *)",
      "Bash(callum-flow-capture *)",
      "Bash(callum-flow-factory-state)",
      "Bash(callum-flow-factory-state *)",
      "Bash(callum-flow-issue-read *)"
    ],
    "deny": [
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh issue status)",
      "Bash(gh issue status *)"
    ]
  }
}
