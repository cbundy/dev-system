#!/usr/bin/env node
// factory-reconcile: the factory loop v2's one-shot reconcile migration (docs/factory-loop/v2/SPEC.md
// 6.3). It applies the owner's rule (every issue that shows as active must have a live step) to
// what v1 left behind, with v1's evidence, so v2's every-pass rule (R1, hooks/v2/reconcile.ts)
// never has to read v1-only facts. It runs in wave 1 while both live loops stay in observe mode,
// and again just before cutover (17.5); it is deleted at the delete wave.
//
//   factory-reconcile --repo <owner/name> [--device <name>] [--checkout <dir>] [--loop-dir <dir>]
//   factory-reconcile --repo <owner/name> ... --act <N>... | --act all
//
// Observe (the default) changes nothing. It lists this device's live claims (from
// callum-flow-factory-state) that have no v2 record, and the issues the factory shows as live with
// no live claim and no `ready` label: those with no holder at all, in a live stage or queued, and
// those queued after their claim ended or lapsed, whatever device made it (but a v2 record's
// queued state, which is live work). These are ghosts no device holds, which nothing else would
// ever end. For each it looks for live evidence within T, the timeout of the v2
// state its stage maps to (designing to designing, implementing to building, in pipeline and
// parked to reviewing, ready to merge to merge-queue's wait; any other stage, queued among them,
// 2 h): a no-mistakes run of the issue's branch updated (the fleet database's mirror); the open
// PR's head pushed (its head commit's date), a check run started or finished, or a review; a slot
// of the pool on the issue's branch whose HEAD or tree changed. It also lists the pool's other
// slots (those with no factory-loop: holder), and the issues that still carry `In development`
// with no live claim, open or closed. Each issue or slot gets one line: why it shows as active,
// what was checked, and the proposal: `leave the factory`, `free the slot`, `remove the label` or
// `live, no record: check again later`, with its open PR and its slot named. The migration
// requeues nothing (the owner, 2026-10-15): every issue it releases leaves the factory, whatever
// its labels, and the owner re-adds `ready` for any still wanted. The report is printed and
// appended to <loop dir>/reconcile-<date>.md.
//
// --act checks each named issue again and does what its proposal now says (approval is by issue,
// so a proposal that changed since the report is checked again): a release (hooks/v2/release.ts,
// 6.4) removes its factory labels and `In development`, frees the slot on its branch (its
// processes killed, its leftovers saved to <loop dir>/leftovers/, then `treehouse return
// --if-lease-id --force`), and logs `abandoned`, last, then the person intervention it is (cause
// reconcile, 7.2). Its events are built by hooks/v2/events.ts, the one seam every v2 event goes
// through. `--act all` acts on every proposal but `live`, and frees no slot that has a process
// running or changed within the last 2 hours: name its issue for either. A live issue named in
// --act is released all the same: the owner has judged it stalled. An issue's open PR is never
// updated or closed; re-adding `ready` brings it back, and the loop adopts the PR (3.5).
//
// --act fails closed. Before anything is done it checks that every event it would write is one the
// factory's readers count: hooks/v2/events.ts must write the release's and the intervention's
// fields as note tokens and read them back, and the callum-flow-event in use must log an
// `intervention` (tried against a scratch log). Both come with build unit U4, so the act run comes
// after U4 lands on feat/factory-loop-v2: run this tool from that branch, with
// CALLUM_FLOW_EVENT_BIN set to its images/base/callum-flow-event until the base image ships it.
// Until then --act refuses with exit 1 and changes nothing. A slot is returned only once its
// leftovers are saved or its tree is clean. Each event is checked in the log after it is written
// (callum-flow-event exits 0 when its write fails); one that is not there fails its issue, and its
// argv, with the intervention's, is kept in <loop dir>/unlogged-events.jsonl to log again.
//
// Slots are read and freed only on the device whose claims these are (the pool is that machine's):
// run elsewhere, the report says so and leaves every slot alone. The live loops' agents cannot be
// stopped from here; both loops are in observe mode while this runs.
//
// Exit codes: 0 ok (observe, or every approved action done), 1 a required read or an approved
// action failed or --act was refused, 2 usage. Environment: DEV_MACHINE_NAME (the device),
// CLAUDE_CONFIG_DIR (the loop dir), CALLUM_FLOW_EVENT_BIN (the event CLI); for tests
// CALLUM_FLOW_FACTORY_STATE_BIN, CALLUM_FLOW_DEV_QUERY_BIN, CALLUM_FLOW_GH_BIN,
// CALLUM_FLOW_ISSUE_READ_BIN, CALLUM_FLOW_TREEHOUSE_BIN and CALLUM_FLOW_GIT_BIN.
'use strict'

const { spawnSync } = require('node:child_process')
const fs = require('node:fs')
const { register } = require('node:module')
const os = require('node:os')
const path = require('node:path')
const { pathToFileURL } = require('node:url')

const ME = 'factory-reconcile'
const USAGE = `usage: ${ME} --repo <owner/name> [--device <name>] [--checkout <dir>] [--loop-dir <dir>] [--act <N>... | --act all]
  Lists this device's live claims with no v2 record, the live issues with no live claim and no
  ready label, the pool's other slots and the issues that still carry 'In development', each with a
  proposal, and changes nothing. Every release leaves the factory: nothing is requeued.
  --act <N>... | all   do what each named issue's proposal says now (all: every proposal but live;
                       a live issue named is released all the same); refused until
                       hooks/v2/events.ts and callum-flow-event carry v2's events (U4)
  --device <name>      the device whose claims to reconcile (default DEV_MACHINE_NAME, else the hostname)
  --checkout <dir>     the repo's main checkout: its pool and settings (default the current directory)
  --loop-dir <dir>     where the report and leftovers go (default <CLAUDE_CONFIG_DIR>/factory-loop/<owner>__<repo>)`

const MIN = 60_000
const HOUR = 60 * MIN
// any stage the timeouts do not name (6.3)
const OTHER_T = 2 * HOUR
// a slot that changed this recently, or runs a process, is freed only when its issue is named
const BUSY_MS = 2 * HOUR
// the v2 state each stage maps to, by its key in the stateTimeoutMs setting
const STAGE_TIMEOUT = { designing: 'design', implementing: 'build', 'in pipeline': 'review', parked: 'review', 'ready to merge': 'queueWait' }
const FACTORY_PREFIX = 'factory-loop:'
// the claim tool's claim label, which v2 drops (3.6); labels compare without regard to case
const IN_DEV = 'In development'
const ACTOR = 'factory-reconcile'
const KILL_GRACE_MS = 5_000

class UsageError extends Error {}
class ReadError extends Error {}
// the file the events that could not be logged are kept in, one JSON line each, to log again
const UNLOGGED = 'unlogged-events.jsonl'

// --- arguments ------------------------------------------------------------------------------------

function parseArgs(argv) {
  const o = { repo: null, device: null, checkout: null, loopDir: null, act: null, help: false }
  const need = (i, name) => {
    if (i + 1 >= argv.length || argv[i + 1].startsWith('--')) throw new UsageError(`${name} needs a value`)
    return argv[i + 1]
  }
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '-h' || a === '--help') o.help = true
    else if (a === '--repo') {
      o.repo = need(i++, a)
      if (!/^[\w.-]+\/[\w.-]+$/.test(o.repo)) throw new UsageError(`--repo must be owner/name, got '${o.repo}'`)
    } else if (a === '--device') o.device = need(i++, a)
    else if (a === '--checkout') o.checkout = need(i++, a)
    else if (a === '--loop-dir') o.loopDir = need(i++, a)
    else if (a === '--act') {
      const named = []
      while (i + 1 < argv.length && !argv[i + 1].startsWith('--')) named.push(argv[++i])
      if (named.length === 0) throw new UsageError('--act needs issue numbers or all')
      if (named.length === 1 && named[0] === 'all') o.act = 'all'
      else if (named.every((n) => /^[1-9]\d*$/.test(n))) o.act = [...new Set(named.map(Number))]
      else throw new UsageError(`--act takes issue numbers or all, got '${named.join(' ')}'`)
    } else throw new UsageError(`unknown argument '${a}'`)
  }
  if (!o.help && o.repo === null) throw new UsageError('--repo is required')
  return o
}

// --- the hooks it shares with the loop ---------------------------------------------------------------

// The loop's modules import each other without a file extension, as the engine resolves them;
// plain Node needs the ".ts" (scripts/factory-loop-replay.js does the same), and is told they are
// TypeScript modules so it need not guess.
const RESOLVE = `export async function resolve(specifier, context, next) {
  let r
  try { r = await next(specifier, context) } catch (err) {
    if (!/^\\.\\.?\\//.test(specifier) || /\\.[cm]?[jt]s$/.test(specifier)) throw err
    r = await next(specifier + '.ts', context)
  }
  return r.url.endsWith('.ts') ? { ...r, format: 'module-typescript' } : r
}`

let hooks = null

// loadHooks: release.ts (what a release removes and logs), events.ts (every v2 event's argv),
// keys.ts (the release's keys), config.ts (the settings) and contract.mjs (the loop dir).
async function loadHooks() {
  if (hooks !== null) return hooks
  register(`data:text/javascript,${encodeURIComponent(RESOLVE)}`)
  const dir = path.join(__dirname, '..', 'hooks')
  const load = (f) => import(pathToFileURL(path.join(dir, f)).href)
  const [release, events, keys, config, contract] = await Promise.all([load('v2/release.ts'), load('v2/events.ts'), load('v2/keys.ts'), load('config.ts'), load('contract.mjs')])
  hooks = { release, events, keys, config, contract }
  return hooks
}

// --- small helpers -----------------------------------------------------------------------------------

const iso = (ms) => (ms === null || ms === undefined ? null : new Date(ms).toISOString())
const ms = (v) => {
  const t = typeof v === 'string' && v !== '' ? Date.parse(v) : NaN
  return Number.isNaN(t) ? null : t
}
const short = (sha) => (typeof sha === 'string' ? sha.slice(0, 8) : 'none')

// dur: a span as people read it: 45m, 16h30m, 3d.
function dur(span) {
  if (span === null || span === undefined) return '-'
  const m = Math.max(0, Math.round(span / MIN))
  if (m < 60) return `${m}m`
  if (m < 2880) return `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}m`
  return `${Math.floor(m / 1440)}d`
}

// ago: when, as an age at the report's time.
const ago = (at, now) => (at === null ? 'never' : `${dur(now - at)} ago`)

// moved: a slot's HEAD and tree as the report says them.
const moved = (sf, now) => `HEAD moved ${ago(sf.head, now)}, tree ${sf.tree === null ? 'clean' : `changed ${ago(sf.tree, now)}`}`

// issueOfBranch: the issue an issue branch names, by the repo's convention (^|/)issue-<N>(-|$) (3.5,
// docs/metrics.md); null for any other branch.
function issueOfBranch(branch) {
  const m = /(?:^|\/)issue-([1-9]\d{0,8})(?:-|$)/.exec(branch || '')
  return m === null ? null : Number(m[1])
}

const labelNames = (labels) => (Array.isArray(labels) ? labels.map((l) => (typeof l === 'string' ? l : l && l.name)).filter((l) => typeof l === 'string') : [])
const hasLabel = (labels, name) => labels.some((l) => l.toLowerCase() === name.toLowerCase())

// --- the report (pure: what was read in, the proposals out) -------------------------------------------

// orphanOf: how the factory shows an issue with no live claim as active (6.3): with no holder, in a
// live stage or queued; or queued with a holder whose claim ended or lapsed. A v2 record's queued
// state is live work, never one. null for any other issue.
function orphanOf(i, h) {
  if (i.v2 !== null && i.v2 !== undefined) return null
  if (!i.holder && (i.stage === 'queued' || h.release.LIVE_STAGES.includes(i.stage))) return 'no holder'
  if (i.holder && i.stage === 'queued') return 'no live claim'
  return null
}

// buildReport: from what gather() read, every proposal (6.3). h: the shared hooks.
function buildReport(input, h) {
  const { at, device } = input
  const factory = input.factory
  const live = new Map(factory.issues.filter((i) => i.holder && h.release.LIVE_STAGES.includes(i.stage)).map((i) => [i.issue, i]))
  const hasRecord = (n) => {
    const c = input.claims.get(n)
    return c !== undefined && c.transition !== null && (c.claimed === null || c.transition >= c.claimed)
  }
  const plans = new Map()
  const planOf = (n) => {
    if (!plans.has(n)) plans.set(n, { issue: n, release: null, removeLabels: [], freeSlots: [], live: false })
    return plans.get(n)
  }
  const poolSlots = input.slots.ok ? input.slots.list.filter((s) => s.status !== 'available' && !(s.holder || '').startsWith(FACTORY_PREFIX)) : []
  const slotsOn = (n) => poolSlots.filter((s) => issueOfBranch(s.branch) === n)
  const named = new Set()

  // assess: one issue that shows as active: what was checked, and its proposal. orphan: how it
  // shows with no live claim (orphanOf), else null; such a one labelled ready is in the queue, not
  // a ghost: it is left out (null).
  const assess = (f, orphan) => {
    const n = f.issue
    const since = ms(f.entered_at)
    const key = STAGE_TIMEOUT[f.stage]
    const T = key === undefined ? OTHER_T : input.timeouts[key]
    const cutoff = at - T
    const gh = input.issues.get(n) || { ok: false, error: 'not read' }
    const labels = gh.ok ? gh.labels : []
    if (orphan && gh.ok && hasLabel(labels, input.readyLabel)) return null
    // the evidence: runs of its branch, its open PRs, the slots on its branch
    const runs = input.runs.ok ? input.runs.list.filter((r) => r.id === f.run || issueOfBranch(r.branch) === n) : []
    const runAt = runs.reduce((m, r) => Math.max(m, r.updated ?? -Infinity), -Infinity)
    const onBranch = input.prs.ok ? input.prs.open.filter((p) => p.number === f.pr || issueOfBranch(p.branch) === n).sort((a, b) => b.number - a.number) : []
    const prs = onBranch.filter((p) => !input.prFacts.get(p.number)?.untrusted)
    const untrusted = onBranch.filter((p) => input.prFacts.get(p.number)?.untrusted).map((p) => `#${p.number}`)
    const slots = slotsOn(n)
    for (const s of slots) named.add(s.path)
    const checked = []
    const times = []
    // what could not be read: with no live evidence found, a release waits until all of it is
    const unread = []
    if (!input.runs.ok) {
      checked.push(`runs n/a (${input.runs.error})`)
      unread.push('runs')
    } else if (input.runs.note) checked.push(input.runs.note)
    else if (runs.length === 0) checked.push('no run of its branch')
    else {
      checked.push(`run ${short(runs.find((r) => r.updated === runAt)?.id ?? runs[0].id)} updated ${ago(Number.isFinite(runAt) ? runAt : null, at)}`)
      if (Number.isFinite(runAt)) times.push(runAt)
    }
    if (!input.prs.ok) {
      checked.push(`PRs n/a (${input.prs.error})`)
      unread.push('PRs')
    } else if (prs.length === 0) checked.push('no open PR')
    if (untrusted.length) checked.push(`PR ${untrusted.join(', ')} by an untrusted author: not counted`)
    for (const p of prs) {
      const pf = input.prFacts.get(p.number) || { pushed: null, check: null, review: null, problems: ['not read'] }
      checked.push(`PR #${p.number}: head pushed ${ago(pf.pushed, at)}, a check ${ago(pf.check, at)}, a review ${ago(pf.review, at)}${pf.problems.length ? ` (${pf.problems.join('; ')})` : ''}`)
      for (const t of [pf.pushed, pf.check, pf.review]) if (t !== null) times.push(t)
      if (pf.problems.length) unread.push(`PR #${p.number}`)
    }
    if (!input.slots.ok) {
      checked.push(`slots n/a (${input.slots.error})`)
      unread.push('slots')
    } else if (slots.length === 0) checked.push('no slot on its branch')
    for (const s of slots) {
      const sf = input.slotFacts.get(s.path) || { head: null, tree: null, problems: ['not read'] }
      checked.push(`slot ${s.name} on ${s.branch}: ${moved(sf, at)}${sf.problems.length ? ` (${sf.problems.join('; ')})` : ''}`)
      for (const t of [sf.head, sf.tree]) if (t !== null) times.push(t)
      if (sf.problems.length) unread.push(`slot ${s.name}`)
    }
    const newest = times.length ? Math.max(...times) : null
    const isLive = newest !== null && newest >= cutoff
    const pr = prs[0]?.number ?? f.pr ?? null
    const branch = runs.find((r) => r.branch)?.branch ?? prs[0]?.branch ?? slots[0]?.branch ?? null
    // a slot is freed on the lease the report saw; one with no lease is the owner's to return
    const freeable = slots.filter((s) => s.lease)
    const unleased = slots.filter((s) => !s.lease).map((s) => s.name)
    const byHand = unleased.length ? `; slot ${unleased.join(', ')} is not leased: return it by hand` : ''
    const plan = planOf(n)
    // the release, out of the factory whatever the issue's labels: the migration requeues nothing
    const release = (what) => {
      const claimAt = input.claims.get(n)?.claimed ?? since ?? at
      plan.release = {
        issue: n,
        claim: h.keys.lifeOf(claimAt),
        outcome: 'leave',
        lives: null,
        stage: f.stage,
        checked: `${what}: ${checked.join('; ')}`,
        branch,
        pr,
      }
      plan.removeLabels = h.release.releaseLabels(labels, true, input.inDevLabel)
      plan.freeSlots = freeable
    }
    const whose = orphan ?? 'no v2 record'
    let proposal
    if (!gh.ok) proposal = `not read (${gh.error}): check again later`
    else if (isLive) {
      // released only when named: the owner may judge it stalled all the same
      release(`live within ${dur(T)}, released by name`)
      plan.live = true
      proposal = `live, ${whose}: check again later (named in --act, it leaves the factory)${byHand}`
    } else if (gh.state === 'closed') {
      plan.removeLabels = h.release.releaseLabels(labels, true, input.inDevLabel)
      plan.freeSlots = freeable
      proposal = `closed on GitHub (the sweep logs it): ${plan.removeLabels.length ? 'remove the label' : 'no label to remove'}${freeable.length ? ', free the slot' : ''}${byHand}`
    } else if (unread.length) {
      proposal = `not fully checked (${unread.join(', ')} not read): check again later`
    } else {
      release(`nothing within ${dur(T)}`)
      proposal = `leave the factory (abandoned: ${orphan ? `${orphan} and ` : ''}nothing is requeued)${byHand}`
    }
    return {
      issue: n,
      stage: f.stage,
      since,
      T,
      run: f.run ?? null,
      labels,
      checked,
      newest,
      proposal,
      pr,
      slots: slots.map((s) => s.name),
      whose,
    }
  }

  // this device's live claims with no v2 record
  const claims = []
  const recorded = []
  for (const f of [...live.values()].filter((i) => i.holder === device).sort((a, b) => a.issue - b.issue)) {
    if (hasRecord(f.issue)) recorded.push(f.issue)
    else claims.push(assess(f, null))
  }
  // the issues that show as active with no live claim and no ready label (6.3)
  const orphans = []
  for (const f of factory.issues.filter((i) => orphanOf(i, h) !== null && !hasRecord(i.issue)).sort((a, b) => a.issue - b.issue)) {
    const row = assess(f, orphanOf(f, h))
    if (row !== null) orphans.push(row)
  }

  // the pool's other slots
  const slots = []
  for (const s of poolSlots.filter((x) => !named.has(x.path)).sort((a, b) => Number(a.name) - Number(b.name) || a.path.localeCompare(b.path))) {
    const n = issueOfBranch(s.branch)
    const sf = input.slotFacts.get(s.path) || { head: null, tree: null, problems: [] }
    const activity = `${moved(sf, at)}${s.processes ? `, ${s.processes} process(es)` : ''}`
    const row = { name: s.name, path: s.path, branch: s.branch || null, issue: n, activity, proposal: '' }
    if (!s.branch) row.proposal = 'on no branch: listed only (v1 implementers detached theirs, and no owner is guessed)'
    else if (n === null) row.proposal = 'not an issue branch: listed only'
    else if (live.has(n)) row.proposal = `#${n} has a live claim (${live.get(n).holder}): listed only`
    else if (hasRecord(n)) row.proposal = `#${n} has a v2 record: listed only`
    else if (!s.lease) row.proposal = `#${n} has no live claim, but the slot is not leased: return it by hand`
    else {
      row.proposal = `#${n} has no live claim and no record: free the slot`
      planOf(n).freeSlots.push(s)
    }
    slots.push(row)
  }

  // `In development` with no live claim, open or closed (3.6)
  const labelRows = []
  if (input.inDev.ok) {
    for (const i of [...input.inDev.list].sort((a, b) => a.number - b.number)) {
      // a live claim's, or one a release above already takes off
      if (live.has(i.number) || plans.get(i.number)?.release) continue
      const p = planOf(i.number)
      const names = labelNames(i.labels).filter((l) => l.toLowerCase() === input.inDevLabel.toLowerCase())
      if (names.length === 0) continue
      p.removeLabels = [...new Set([...p.removeLabels, ...names])]
      const f = factory.recent.find((r) => r.issue === i.number) || factory.issues.find((r) => r.issue === i.number)
      labelRows.push({ issue: i.number, state: i.state, why: f ? `${f.stage}${f.detail ? ` (${f.detail})` : ''}` : 'no live claim', proposal: 'remove the label' })
    }
  }

  // what --act may do, by issue: only what something proposes; a live one only when named
  for (const [n, p] of [...plans]) if (p.release === null && p.removeLabels.length === 0 && p.freeSlots.length === 0) plans.delete(n)
  return {
    repo: input.repo,
    device,
    at,
    poolNote: input.slots.ok ? null : input.slots.error,
    inDevNote: input.inDev.ok ? null : input.inDev.error,
    claims,
    orphans,
    recorded,
    slots,
    labels: labelRows,
    plans,
  }
}

// renderReport: the report as Markdown, one line per issue or slot.
function renderReport(r) {
  const out = [`# ${ME}: ${r.repo} for ${r.device}, at ${iso(r.at)}`, '']
  const acts = [...r.plans.keys()].filter((n) => !r.plans.get(n).live).sort((a, b) => a - b)
  const named = [...r.plans.keys()].filter((n) => r.plans.get(n).live).sort((a, b) => a - b)
  out.push(acts.length ? `Approve by issue: \`${ME} --repo ${r.repo} --device ${r.device} --act ${acts.join(' ')}\` (or \`--act all\`).` : 'Nothing to approve.')
  if (named.length) out.push(`Live, released only when named: ${named.map((n) => `#${n}`).join(' ')}.`)
  out.push('Nothing is requeued: every release leaves the factory. Re-add `ready` to bring back an issue still wanted; the loop adopts its open PR.')
  const issueLine = (c, whose) => {
    const labels = c.labels.length ? c.labels.join(', ') : 'none'
    return (
      `- #${c.issue}: ${c.stage} for ${dur(r.at - (c.since ?? r.at))} with ${whose}; checked within ${dur(c.T)}: ${c.checked.join('; ')}. ` +
      `Proposal: ${c.proposal}. Labels: ${labels}. Open PR: ${c.pr === null ? 'none' : `#${c.pr}`}. Slot: ${c.slots.length ? c.slots.join(', ') : 'none'}.`
    )
  }
  out.push('', '## Live claims of this device with no v2 record', '')
  if (r.claims.length === 0) out.push('None.')
  for (const c of r.claims) out.push(issueLine(c, 'no v2 record'))
  if (r.recorded.length) out.push(`- With a v2 record, left to the loop: ${r.recorded.map((n) => `#${n}`).join(', ')}.`)
  out.push('', '## Live in the factory with no live claim and no ready label', '')
  if (r.orphans.length === 0) out.push('None.')
  for (const c of r.orphans) out.push(issueLine(c, c.whose))
  out.push('', '## The pool\'s other slots', '')
  if (r.poolNote !== null) out.push(`Not read: ${r.poolNote}.`)
  else if (r.slots.length === 0) out.push('None.')
  for (const s of r.slots) out.push(`- slot ${s.name} (${s.path}) on ${s.branch ?? 'no branch'}: ${s.activity}. Proposal: ${s.proposal}.`)
  out.push('', "## 'In development' with no live claim", '')
  if (r.inDevNote !== null) out.push(`Not read: ${r.inDevNote}.`)
  else if (r.labels.length === 0) out.push('None.')
  for (const l of r.labels) out.push(`- #${l.issue} (${l.state}): ${l.why}. Proposal: ${l.proposal}.`)
  return `${out.join('\n')}\n`
}

// --- reads ---------------------------------------------------------------------------------------------

const SQL_CLAIMS = `SELECT coalesce(json_agg(json_build_object('issue', issue, 'state', state,
  'ts', to_char(ts AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"')) ORDER BY issue, state), '[]'::json)
FROM (SELECT issue, state, max(ts) AS ts FROM factory.events
      WHERE lower(repo) = lower(:'repo') AND device = :'device' AND issue IS NOT NULL
        AND state IN ('claimed', 'transition')
      GROUP BY issue, state) x;`

const SQL_RUNS_EXIST = `SELECT to_regclass('nomistakes.runs') IS NOT NULL;`

const SQL_RUNS = `SELECT coalesce(json_agg(json_build_object('id', id, 'branch', branch, 'status', status,
  'updated_at', to_char(updated_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"')) ORDER BY updated_at, id), '[]'::json)
FROM nomistakes.runs
WHERE lower(repo) = lower(:'repo') AND branch IS NOT NULL AND updated_at > :'since'::timestamptz;`

// io: the commands it runs, by name, through one runner a test can replace.
function realIo(env) {
  const bins = {
    factoryState: env.CALLUM_FLOW_FACTORY_STATE_BIN || 'callum-flow-factory-state',
    devQuery: env.CALLUM_FLOW_DEV_QUERY_BIN || 'dev-query',
    gh: env.CALLUM_FLOW_GH_BIN || 'gh',
    issueRead: env.CALLUM_FLOW_ISSUE_READ_BIN || 'callum-flow-issue-read',
    event: env.CALLUM_FLOW_EVENT_BIN || 'callum-flow-event',
    treehouse: env.CALLUM_FLOW_TREEHOUSE_BIN || 'treehouse',
    git: env.CALLUM_FLOW_GIT_BIN || 'git',
  }
  const run = (name, args, opts = {}) => {
    const r = spawnSync(bins[name], args, {
      encoding: 'utf8',
      cwd: opts.cwd,
      env: { ...env, ...(opts.env || {}) },
      input: opts.input ?? '',
      maxBuffer: 256 * 1024 * 1024,
      timeout: opts.timeoutMs ?? 120_000,
    })
    const stderr = r.error ? String(r.error.message || r.error) : r.stderr || ''
    return { code: r.status === null ? 1 : r.status, stdout: r.stdout || '', stderr }
  }
  return { run }
}

const why = (r) => (r.stderr.trim().split('\n').pop() || `exit ${r.code}`).slice(0, 200)

function devQueryJson(io, sql, vars) {
  const args = ['-At']
  for (const [k, v] of Object.entries(vars)) args.push('-v', `${k}=${v}`)
  args.push('-c', sql)
  const r = io.run('devQuery', args)
  if (r.code !== 0) throw new ReadError(`dev-query: ${why(r)}`)
  try {
    return JSON.parse(r.stdout.trim())
  } catch {
    throw new ReadError('dev-query returned unreadable output')
  }
}

function readJson(r, what) {
  if (r.code !== 0) return { ok: false, error: `${what}: ${why(r)}` }
  try {
    return { ok: true, value: JSON.parse(r.stdout) }
  } catch {
    return { ok: false, error: `${what}: unreadable output` }
  }
}

// gather: everything the report reads (6.3), in one place.
function gather(o, io, settings) {
  const { repo, device } = o
  // the factory: required
  const fs1 = readJson(io.run('factoryState', ['--repo', repo, '--format', 'json', '--github', 'off'], { timeoutMs: 180_000 }), 'callum-flow-factory-state')
  if (!fs1.ok) throw new ReadError(fs1.error)
  const doc = fs1.value
  const at = ms(doc.at)
  const entry = Array.isArray(doc.repos) ? doc.repos.find((r) => String(r.repo).toLowerCase() === repo.toLowerCase()) : undefined
  if (at === null) throw new ReadError('callum-flow-factory-state: no time in its report')
  const factory = { issues: entry && Array.isArray(entry.issues) ? entry.issues : [], recent: entry && Array.isArray(entry.recent) ? entry.recent : [] }

  // this device's newest claim and transition per issue: the claim's time, and a v2 record
  const claims = new Map()
  for (const row of devQueryJson(io, SQL_CLAIMS, { repo, device })) {
    const c = claims.get(row.issue) || { claimed: null, transition: null }
    c[row.state] = ms(row.ts)
    claims.set(row.issue, c)
  }
  // the runs of the last week, when the mirror is there
  let runs
  try {
    const exists = io.run('devQuery', ['-At', '-c', SQL_RUNS_EXIST])
    if (exists.code !== 0) runs = { ok: false, error: `dev-query: ${why(exists)}` }
    // no mirror (it is optional, 2.4): no run can be live evidence
    else if (exists.stdout.trim() !== 't') runs = { ok: true, list: [], note: 'no run mirror (nomistakes.runs does not exist)' }
    else runs = { ok: true, list: devQueryJson(io, SQL_RUNS, { repo, since: iso(at - 7 * 24 * HOUR) }).map((r) => ({ id: r.id, branch: r.branch, status: r.status, updated: ms(r.updated_at) })) }
  } catch (err) {
    runs = { ok: false, error: err.message }
  }

  // this device's live claims, and the issues that show as active with no live claim (6.3)
  const candidates = factory.issues
    .filter((i) => (i.holder === device && settings.liveStages.includes(i.stage)) || ((i.v2 === null || i.v2 === undefined) && (i.stage === 'queued' || (!i.holder && settings.liveStages.includes(i.stage)))))
    .map((i) => i.issue)
  const readEnv = { env: { CALLUM_FLOW_REPO: repo } }
  // the candidates' labels and state, through the trusted reader
  const issues = new Map()
  for (const n of candidates) {
    const r = io.run('issueRead', ['--json', String(n)], readEnv)
    if (r.code === 3) issues.set(n, { ok: false, error: 'an untrusted author' })
    else {
      const j = readJson(r, 'callum-flow-issue-read')
      issues.set(n, j.ok && j.value.issue ? { ok: true, state: j.value.issue.state, labels: labelNames(j.value.issue.labels) } : { ok: false, error: j.ok ? 'no issue in the answer' : j.error })
    }
  }
  const inDevRead = readJson(io.run('issueRead', ['--json', '--list', '--label', settings.inDevLabel, '--state', 'all'], readEnv), 'callum-flow-issue-read --list')
  const inDev = inDevRead.ok && Array.isArray(inDevRead.value.issues) ? { ok: true, list: inDevRead.value.issues } : { ok: false, error: inDevRead.ok ? 'no issues in the answer' : inDevRead.error }

  // the open PRs, once; then the facts of each PR a candidate has
  const prList = readJson(io.run('gh', ['pr', 'list', '--repo', repo, '--state', 'open', '--limit', '500', '--json', 'number,headRefName,headRefOid']), 'gh pr list')
  const prs = prList.ok && Array.isArray(prList.value) ? { ok: true, open: prList.value.map((p) => ({ number: p.number, branch: p.headRefName, head: p.headRefOid })) } : { ok: false, error: prList.ok ? 'unexpected output' : prList.error }
  const prFacts = new Map()
  if (prs.ok) {
    const wanted = new Set()
    for (const n of candidates) {
      const f = factory.issues.find((i) => i.issue === n)
      for (const p of prs.open) if (p.number === f.pr || issueOfBranch(p.branch) === n) wanted.add(p.number)
    }
    for (const n of [...wanted].sort((a, b) => a - b)) prFacts.set(n, readPr(io, repo, prs.open.find((p) => p.number === n), readEnv))
  }

  // the pool, on its own machine only
  let slots
  const here = settings.machine
  if (here !== device) slots = { ok: false, error: `this machine is ${here}, not ${device}: run it there to read and free that pool` }
  else {
    const t = readJson(io.run('treehouse', ['status', '--json'], { cwd: o.checkout }), 'treehouse status')
    slots = t.ok && Array.isArray(t.value)
      ? {
          ok: true,
          list: t.value.map((s) => ({
            name: String(s.name ?? ''),
            path: String(s.path ?? ''),
            status: String(s.status ?? 'unknown'),
            branch: typeof s.branch === 'string' ? s.branch : '',
            lease: typeof s.lease_id === 'string' ? s.lease_id : '',
            holder: typeof s.lease_holder === 'string' ? s.lease_holder : '',
            processes: Array.isArray(s.processes) ? s.processes.length : 0,
          })),
        }
      : { ok: false, error: t.ok ? 'unexpected output' : t.error }
  }
  const slotFacts = new Map()
  if (slots.ok) for (const s of slots.list) if (s.status !== 'available' && !s.holder.startsWith(FACTORY_PREFIX) && s.path) slotFacts.set(s.path, readSlot(io, s.path))

  return { repo, device, at, timeouts: settings.timeouts, readyLabel: settings.readyLabel, inDevLabel: settings.inDevLabel, factory, claims, runs, issues, inDev, prs, prFacts, slots, slotFacts }
}

// readPr: when the PR's head was pushed (its head commit's date), and the newest check start or
// finish and review. A PR by an untrusted author is not the loop's, so nothing of it is read.
function readPr(io, repo, pr, readEnv) {
  const facts = { pushed: null, check: null, review: null, problems: [], untrusted: false }
  const v = io.run('issueRead', ['--json', '--pr', String(pr.number), '--comments'], readEnv)
  if (v.code === 3) return { ...facts, untrusted: true }
  const j = readJson(v, 'reviews')
  if (!j.ok) facts.problems.push(j.error)
  else
    for (const r of Array.isArray(j.value.reviews) ? j.value.reviews : []) {
      const t = ms(r.submitted_at)
      if (t !== null && t > (facts.review ?? -Infinity)) facts.review = t
    }
  if (pr.head) {
    const c = io.run('gh', ['api', `repos/${repo}/commits/${pr.head}`, '--jq', '.commit.committer.date'])
    if (c.code === 0) facts.pushed = ms(c.stdout.trim())
    else facts.problems.push(`head not read: ${why(c)}`)
  }
  // gh pr checks exits non-zero while a check fails or is pending, and prints the JSON all the same
  const k = io.run('gh', ['pr', 'checks', String(pr.number), '--repo', repo, '--json', 'name,state,startedAt,completedAt'])
  try {
    const list = JSON.parse(k.stdout)
    for (const x of Array.isArray(list) ? list : []) for (const t of [ms(x.startedAt), ms(x.completedAt)]) if (t !== null && t > (facts.check ?? -Infinity)) facts.check = t
  } catch {
    if (!/no checks reported/i.test(k.stderr)) facts.problems.push(`checks not read: ${why(k)}`)
  }
  return facts
}

// readSlot: when the slot's HEAD last moved (its reflog) and its tree last changed (the newest
// change time of a changed or untracked file).
function readSlot(io, dir) {
  const facts = { head: null, tree: null, problems: [] }
  const h = io.run('git', ['-C', dir, '--no-optional-locks', 'reflog', 'show', '-n', '1', '--date=unix', '--format=%gd', 'HEAD'])
  const m = /\{(\d+)\}/.exec(h.stdout)
  if (h.code === 0 && m) facts.head = Number(m[1]) * 1000
  else if (h.code !== 0) facts.problems.push(`HEAD not read: ${why(h)}`)
  const s = io.run('git', ['-C', dir, '--no-optional-locks', 'status', '--porcelain=v1', '-z', '--untracked-files=all'])
  if (s.code !== 0) facts.problems.push(`tree not read: ${why(s)}`)
  else {
    const entries = s.stdout.split('\0').filter((e) => e.length > 3)
    for (const e of entries.slice(0, 5000)) {
      try {
        const t = fs.lstatSync(path.join(dir, e.slice(3))).mtimeMs
        if (t > (facts.tree ?? -Infinity)) facts.tree = Math.floor(t)
      } catch {
        // deleted, or a rename's old name
      }
    }
  }
  return facts
}

// --- act -------------------------------------------------------------------------------------------------

// act: each named issue's proposal as it now stands. Returns one line per issue and whether all went.
async function act(report, which, ctx) {
  const lines = []
  let ok = true
  const all = which === 'all'
  // all: every proposal but a live one; a live issue is released when it is named
  const issues = all ? [...report.plans.keys()].filter((n) => !report.plans.get(n).live).sort((a, b) => a - b) : which
  for (const n of issues) {
    const plan = report.plans.get(n)
    if (plan === undefined) {
      const c = [...report.claims, ...report.orphans].find((x) => x.issue === n)
      lines.push(`- #${n}: nothing to do now${c ? ` (${c.proposal})` : ''}.`)
      continue
    }
    const done = []
    try {
      if (plan.removeLabels.length) {
        const r = ctx.io.run('gh', ['issue', 'edit', String(n), '--repo', report.repo, '--remove-label', plan.removeLabels.join(',')])
        if (r.code !== 0) throw new Error(`labels not removed: ${why(r)}`)
        done.push(`removed ${plan.removeLabels.join(', ')}`)
      }
      for (const s of plan.freeSlots) {
        const busy = s.processes > 0 || recent(ctx.facts.get(s.path), report.at)
        if (all && busy && plan.release === null) {
          done.push(`slot ${s.name} left alone: it is busy or changed within ${dur(BUSY_MS)} (name #${n} to free it)`)
          continue
        }
        done.push(await freeSlot(ctx, s, n))
      }
      if (plan.release !== null) {
        // the closing event, last of the release, then the person intervention it is (6.4, 7.2);
        // one that is not in the log fails the issue, and is kept to log again
        const state = ctx.h.release.releaseState(plan.release.outcome)
        const event = ctx.h.events.eventArgv(ctx.h.release.releaseEvent(plan.release))
        const iv = ctx.h.events.eventArgv(ctx.h.release.releaseIntervention(plan.release, 'person'))
        const ev = logEvent(ctx, report.repo, event)
        if (ev !== null) throw new Error(`${state} not logged: ${ev}${keepUnlogged(ctx, report.repo, [event, iv])}`)
        done.push(`logged ${state}`)
        const ivWhy = logEvent(ctx, report.repo, iv)
        if (ivWhy !== null) throw new Error(`the intervention not logged: ${ivWhy}${keepUnlogged(ctx, report.repo, [iv])}`)
        done.push('logged the intervention')
      }
      lines.push(`- #${n}: ${done.join('; ')}.`)
    } catch (err) {
      ok = false
      lines.push(`- #${n}: FAILED: ${err.message}${done.length ? ` (done before it: ${done.join('; ')})` : ''}.`)
    }
  }
  return { lines, ok }
}

const recent = (facts, at) => facts !== undefined && [facts.head, facts.tree].some((t) => t !== null && at - t < BUSY_MS)

// argvRow: an event's argv (events.ts eventArgv) as its line in the log reads: its state, its
// columns and its note.
function argvRow(argv) {
  const flag = (name) => {
    const i = argv.indexOf(name, 2)
    return i === -1 || i + 1 >= argv.length ? null : argv[i + 1]
  }
  const num = (v) => (v === null ? null : Number(v))
  return { state: argv[1], issue: num(flag('--issue')), branch: flag('--branch'), pr: num(flag('--pr')), head: flag('--head'), note: flag('--note') }
}

// logEvent: one event through callum-flow-event (events.ts built its argv); null when its line is
// in the log, else why not. callum-flow-event exits 0 when its write fails (it never fails its
// caller), so the log is read: its path (--path), its size before, and a line after that with the
// event's state, issue and note. env: more environment for the CLI (the readiness check's scratch
// log).
function logEvent(ctx, repo, argv, env = {}) {
  const opts = { env: { CALLUM_FLOW_REPO: repo, CALLUM_FLOW_ACTOR: ACTOR, ...env } }
  const where = ctx.io.run('event', ['--path', '--repo', repo], opts)
  const file = where.stdout.trim()
  if (where.code !== 0 || !path.isAbsolute(file)) return `the event log's path not read: ${why(where)}`
  const before = sizeOf(file)
  const r = ctx.io.run('event', argv.slice(1), opts)
  if (r.code !== 0) return why(r)
  if (!loggedSince(file, before, argvRow(argv))) return `not in the log${r.stderr.trim() ? ` (${why(r)})` : ''}`
  return null
}

function sizeOf(file) {
  try {
    return fs.statSync(file).size
  } catch {
    return 0
  }
}

// loggedSince: a line written to the log after `offset` bytes is this event (other writers may
// have appended lines too). A log that shrank was replaced: all of it is read.
function loggedSince(file, offset, row) {
  let text
  try {
    const all = fs.readFileSync(file)
    text = all.subarray(all.length >= offset ? offset : 0).toString('utf8')
  } catch {
    return false
  }
  return text.split('\n').some((line) => {
    try {
      const e = JSON.parse(line)
      return e.state === row.state && (e.issue ?? null) === row.issue && (e.note ?? null) === row.note
    } catch {
      return false
    }
  })
}

// keepUnlogged: the events that could not be logged, appended to <loop dir>/unlogged-events.jsonl
// as { at, repo, actor, argv } to log again (CALLUM_FLOW_REPO=<repo> CALLUM_FLOW_ACTOR=<actor>
// <argv...>); the words the issue's line adds.
function keepUnlogged(ctx, repo, argvs) {
  const file = path.join(ctx.loopDir, UNLOGGED)
  try {
    fs.mkdirSync(ctx.loopDir, { recursive: true })
    fs.appendFileSync(file, argvs.map((argv) => `${JSON.stringify({ at: new Date().toISOString(), repo, actor: ACTOR, argv })}\n`).join(''))
    return `; kept in ${file} to log again`
  } catch (err) {
    return `; not kept either (${err.message}): ${argvs.map((a) => a.join(' ')).join(' / ')}`
  }
}

// actReady: null when --act may run, else why not. Every event it writes must be one the
// factory's readers count (6.4, 7.1, 7.2): hooks/v2/events.ts writes a release's fields and an
// intervention's as note tokens and reads them back (U4 fills it), and the callum-flow-event in
// use logs an `intervention`, tried against a scratch log so nothing reaches the real one.
function actReady(h, io, repo, at) {
  if (typeof h.events.parseEvent !== 'function') return 'hooks/v2/events.ts has no note parser yet (U4 fills it)'
  const sample = { issue: 1, claim: h.keys.lifeOf(at), outcome: 'leave', lives: null, stage: 'designing', checked: 'a check of the note encoding', branch: 'issue-1', pr: 2 }
  const read = (e) => {
    try {
      return h.events.parseEvent(argvRow(h.events.eventArgv(e)))
    } catch {
      return null
    }
  }
  const rel = h.release.releaseEvent(sample)
  const relBack = read(rel)
  if (relBack === null || relBack.state !== rel.state || relBack.reason !== 'reconcile' || relBack.outcome !== rel.outcome || relBack.stage !== rel.stage || relBack.checked !== rel.checked || relBack.pr !== rel.pr) {
    return "hooks/v2/events.ts does not read back a release's fields (reason, outcome, stage, what was checked, PR)"
  }
  const iv = h.release.releaseIntervention(sample, 'person')
  const ivBack = read(iv)
  if (ivBack === null || ivBack.state !== 'intervention' || ivBack.who !== iv.who || ivBack.cause !== iv.cause || ivBack.fact !== iv.fact) {
    return "hooks/v2/events.ts does not read back an intervention's who, cause and fact"
  }
  const scratch = fs.mkdtempSync(path.join(os.tmpdir(), `${ME}-probe-`))
  try {
    const why = logEvent({ io }, repo, h.events.eventArgv(iv), { CALLUM_EVENTS_DIR: scratch })
    return why === null ? null : `the callum-flow-event in use does not log an intervention: ${why}`
  } finally {
    fs.rmSync(scratch, { recursive: true, force: true })
  }
}

// cleanTree: the slot has no changed or untracked file, as git reads it now.
function cleanTree(ctx, dir) {
  const r = ctx.io.run('git', ['-C', dir, '--no-optional-locks', 'status', '--porcelain=v1', '--untracked-files=all'])
  return r.code === 0 && r.stdout.trim() === ''
}

// freeSlot: the slot's processes killed, its leftovers saved, then returned on the lease the
// report saw (10.1, 10.2). The save comes first (6.3): a slot whose leftovers were not saved is
// returned only when its tree is clean, else it is left for the owner. Throws when it was not
// returned.
async function freeSlot(ctx, s, n) {
  const killed = await ctx.kill(s.path)
  const saved = saveLeftovers(ctx, s.path, `${n}-v1-slot${s.name}`)
  if (saved.problem !== null && !cleanTree(ctx, s.path)) {
    throw new Error(`leftovers not saved: ${saved.problem}; slot ${s.name} not returned, left for the owner${killed > 0 ? ` (${killed} process(es) killed)` : ''}`)
  }
  const r = ctx.io.run('treehouse', ['return', s.path, '--if-lease-id', s.lease, '--force'], { cwd: ctx.checkout })
  if (r.code !== 0) throw new Error(`slot ${s.name} not returned: ${why(r)}${saved.file ? ` (its leftovers are in ${saved.file})` : ''}`)
  const parts = [`slot ${s.name} returned`]
  if (killed > 0) parts.push(`${killed} process(es) killed`)
  if (saved.file) parts.push(`leftovers in ${saved.file}`)
  if (saved.head) parts.push(`its HEAD was ${short(saved.head)}`)
  if (saved.problem) parts.push(`nothing to save, the tree was clean (${saved.problem})`)
  return parts.join(', ')
}

// saveLeftovers: the slot's tracked changes and untracked files as one binary patch against its HEAD,
// built in a scratch index so the slot's own is not touched (10.2); no file when nothing changed.
function saveLeftovers(ctx, dir, name) {
  const head = ctx.io.run('git', ['-C', dir, 'rev-parse', '--verify', '-q', 'HEAD'])
  if (head.code !== 0) return { file: null, head: null, problem: 'no HEAD' }
  const scratch = fs.mkdtempSync(path.join(os.tmpdir(), `${ME}-`))
  const env = { env: { GIT_INDEX_FILE: path.join(scratch, 'index') } }
  try {
    for (const args of [['read-tree', 'HEAD'], ['add', '-A']]) {
      const r = ctx.io.run('git', ['-C', dir, ...args], env)
      if (r.code !== 0) return { file: null, head: head.stdout.trim(), problem: why(r) }
    }
    const d = ctx.io.run('git', ['-C', dir, 'diff', '--cached', '--binary', 'HEAD'], env)
    if (d.code !== 0) return { file: null, head: head.stdout.trim(), problem: why(d) }
    if (d.stdout === '') return { file: null, head: head.stdout.trim(), problem: null }
    const out = path.join(ctx.loopDir, 'leftovers')
    fs.mkdirSync(out, { recursive: true })
    const file = path.join(out, `${name}-${Date.now()}.patch`)
    fs.writeFileSync(file, d.stdout)
    return { file, head: head.stdout.trim(), problem: null }
  } finally {
    fs.rmSync(scratch, { recursive: true, force: true })
  }
}

// killIn: every process whose working directory is the slot or inside it, but this one and its
// ancestors: SIGTERM, then SIGKILL for any left after KILL_GRACE_MS (10.8). The number signalled.
async function killIn(dir) {
  let real
  try {
    real = fs.realpathSync(dir)
  } catch {
    return 0
  }
  const own = new Set([process.pid])
  for (let p = process.ppid; p > 1 && !own.has(p); p = parentOf(p)) own.add(p)
  const inside = () =>
    fs
      .readdirSync('/proc')
      .filter((d) => /^\d+$/.test(d))
      .map(Number)
      .filter((pid) => {
        if (own.has(pid)) return false
        try {
          const cwd = fs.readlinkSync(`/proc/${pid}/cwd`)
          return cwd === real || cwd.startsWith(`${real}/`)
        } catch {
          return false
        }
      })
  const first = inside()
  const signal = (pid, sig) => {
    try {
      process.kill(pid, sig)
    } catch {
      // gone, or not ours to signal
    }
  }
  for (const pid of first) signal(pid, 'SIGTERM')
  for (let waited = 0; waited < KILL_GRACE_MS && inside().some((p) => first.includes(p)); waited += 100) await new Promise((r) => setTimeout(r, 100))
  for (const pid of inside().filter((p) => first.includes(p))) signal(pid, 'SIGKILL')
  return first.length
}

// parentOf: a process's parent, from /proc/<pid>/stat (the field after the command's closing paren).
function parentOf(pid) {
  try {
    const stat = fs.readFileSync(`/proc/${pid}/stat`, 'utf8')
    return Number(stat.slice(stat.lastIndexOf(')') + 2).split(' ')[1]) || 0
  } catch {
    return 0
  }
}

// --- main ------------------------------------------------------------------------------------------------

const readFile = (p) => {
  try {
    return JSON.parse(fs.readFileSync(p, 'utf8'))
  } catch {
    return {}
  }
}

// settingsOf: the timeouts and labels the loop would use here: its defaults, the repo's settings
// file, then the workspace's (register.ts runtime's order).
function settingsOf(h, checkout, configDir, machine) {
  const { config } = h.config.loadConfig(readFile(path.join(checkout, '.claude', 'factory-loop.json')), readFile(path.join(h.contract.loopBaseOf(configDir), 'config.json')))
  return { timeouts: config.stateTimeoutMs, readyLabel: config.readyLabel, inDevLabel: IN_DEV, liveStages: h.release.LIVE_STAGES, machine }
}

async function main(argv, env = process.env, deps = {}) {
  const o = parseArgs(argv)
  if (o.help) {
    process.stdout.write(`${USAGE}\n`)
    return 0
  }
  const loaded = await loadHooks()
  const h = deps.withHooks ? deps.withHooks(loaded) : loaded
  const machine = env.DEV_MACHINE_NAME || os.hostname()
  const device = o.device || machine
  const configDir = (env.CLAUDE_CONFIG_DIR || path.join(env.HOME || os.homedir(), '.claude')).replace(/\/+$/, '')
  const checkout = path.resolve(o.checkout || process.cwd())
  const loopDir = o.loopDir || h.contract.loopDirOf(configDir, o.repo)
  const io = deps.io || realIo(env)
  if (o.act !== null) {
    const refused = actReady(h, io, o.repo, Date.now())
    if (refused !== null) {
      throw new ReadError(
        `--act refused, nothing done: ${refused}. The act run comes after U4 lands on feat/factory-loop-v2: ` +
          'run this tool from that branch, with CALLUM_FLOW_EVENT_BIN set to its images/base/callum-flow-event until the base image ships it.',
      )
    }
  }
  const settings = settingsOf(h, checkout, configDir, machine)
  const input = gather({ repo: o.repo, device, checkout }, io, settings)
  const report = buildReport(input, h)
  let text = renderReport(report)
  let code = 0
  if (o.act !== null) {
    const done = await act(report, o.act, { h, io, checkout, loopDir, facts: input.slotFacts, kill: deps.kill || killIn })
    text += `\n## Act on ${o.act === 'all' ? 'all' : o.act.map((n) => `#${n}`).join(' ')}\n\n${done.lines.join('\n') || 'Nothing.'}\n`
    if (!done.ok) code = 1
  }
  process.stdout.write(text)
  try {
    fs.mkdirSync(loopDir, { recursive: true })
    fs.appendFileSync(path.join(loopDir, `reconcile-${iso(report.at).slice(0, 10)}.md`), `${text}\n`)
  } catch (err) {
    process.stderr.write(`${ME}: the report was not written to ${loopDir}: ${err.message}\n`)
  }
  return code
}

// cli: main as the command runs it, its errors on stderr and its exit code set. deps: main's (a
// test's runner passes its own hooks).
function cli(argv, env = process.env, deps = {}) {
  return main(argv, env, deps).then(
    (code) => {
      process.exitCode = code
    },
    (err) => {
      if (err instanceof UsageError) {
        process.stderr.write(`${ME}: ${err.message}\n${USAGE}\n`)
        process.exitCode = 2
      } else {
        process.stderr.write(`${ME}: ${err instanceof ReadError ? err.message : err.stack || err}\n`)
        process.exitCode = 1
      }
    },
  )
}

if (require.main === module) cli(process.argv.slice(2))

module.exports = { main, cli, parseArgs, actReady, buildReport, renderReport, gather, act, loadHooks, issueOfBranch, killIn, saveLeftovers, dur, UsageError, ReadError }
