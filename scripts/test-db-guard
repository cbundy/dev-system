#!/bin/sh
# The sandbox's database tripwire (scripts/test-sandbox.sh, cbundy/dev-system#1056). Installed as
# `psql` first on PATH, it refuses a connection to a host of the workspace's real configured
# databases, so a test that scrubs its env cannot reach production through the hard-coded
# defaults of a script under test.
#
#   test-db-guard --hosts      reads connection URLs / conninfo strings on stdin, prints each host
#   test-db-guard [psql args]  needs TEST_DB_GUARD_DENY (file of denied hosts), TEST_DB_GUARD_LOG
#                              (dir for refusal records) and TEST_DB_GUARD_REAL (the real psql)
#
# Only hostnames are ever stored or printed, never a URL or a password.

# hosts_of TEXT: prints the host of a postgres:// URL, and each host=/hostaddr= of a conninfo.
hosts_of() {
  case "$1" in
    postgres://* | postgresql://*)
      _rest=${1#*://}
      _auth=${_rest%%[/?]*}
      _query=
      case "$_rest" in *\?*) _query=${_rest#*\?} ;; esac
      _hostport=${_auth##*@}
      printf '%s\n' "$_hostport" | tr ',' '\n' | while IFS= read -r _h; do
        case "$_h" in
          \[*) _h=${_h#\[}; _h=${_h%%\]*} ;;
          *) _h=${_h%%:*} ;;
        esac
        printf '%s\n' "$_h"
      done
      printf '%s\n' "$_query" | tr '&' '\n' | sed -n 's/^host\(addr\)\{0,1\}=//p'
      ;;
    *host=* | *hostaddr=*)
      printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^host\(addr\)\{0,1\}=//p" | tr -d "'"
      ;;
  esac
}

if [ "${1:-}" = "--hosts" ]; then
  while IFS= read -r _line; do
    hosts_of "$_line" | tr ',' '\n'
  done | grep -v '^$' | sort -u
  exit 0
fi

: "${TEST_DB_GUARD_DENY:?}" "${TEST_DB_GUARD_LOG:?}" "${TEST_DB_GUARD_REAL:?}"

candidates=$(
  printf '%s\n%s\n' "${PGHOST:-}" "${PGHOSTADDR:-}"
  prev=
  for a in "$@"; do
    case "$prev" in -h | --host) printf '%s\n' "$a" ;; esac
    case "$a" in
      -h?*) printf '%s\n' "${a#-h}" ;;
      --host=*) printf '%s\n' "${a#--host=}" ;;
      *) hosts_of "$a" ;;
    esac
    prev=$a
  done
)
candidates=$(printf '%s\n' "$candidates" | tr ',' '\n' | grep -v '^$' || true)

for h in $candidates; do
  if grep -Fxq -- "$h" "$TEST_DB_GUARD_DENY" 2> /dev/null; then
    caller=$(ps -o comm= -p "$PPID" 2> /dev/null | tr -d ' ')
    mkdir -p "$TEST_DB_GUARD_LOG"
    printf '%s (%s)\n' "$h" "${caller:-unknown}" > "$TEST_DB_GUARD_LOG/refused.$$"
    echo "psql: refused: $h is a real configured database, not a test server" >&2
    exit 1
  fi
done
exec "$TEST_DB_GUARD_REAL" "$@"
