{
  "name": "@callum/dev-system",
  "version": "0.50.0",
  "description": "Callum's portable dev flow: repo config templates plus the callum-dev CLI that scaffolds and syncs them",
  "private": true,
  "bin": {
    "callum-dev": "bin/callum-dev.js"
  },
  "files": [
    "bin",
    "templates"
  ],
  "scripts": {
    "lint": "sh scripts/lint.sh",
    "build:skills": "node scripts/build-skills.js",
    "build:events": "node scripts/build-event-docs.js",
    "test": "sh scripts/test.sh"
  },
  "engines": {
    "node": ">=18"
  }
}
